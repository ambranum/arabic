__pycache__/
*.pyc
.DS_Store
.env
.claude/
# Reference teaching materials: the user's OWN books/course notes are committed (they are
# transcribed into app content). The two Lingualism products are commercial third-party
# books — verification-only, NEVER committed (this repo is public: it IS the website).
reference/Palestinian_Arabic_Verbs_-_Lingualism.pdf
reference/Palestinian\ Arabic\ Verbs\ -\ Lingualism.apkg
reference/.DS_Store
ab_voice_test/
# rendered reference pages — 70+MB of local working images, regenerable
build/*/ref/

# iCloud Drive placeholder stubs. The project lives under Desktop, which iCloud syncs; when
# it dematerializes a file it leaves a 172-byte binary plist named ".<file>.icloud". Twenty-three
# got committed for duplicate "<name> 2.json" files that never existed as real content.
*.icloud

# The raw Wiktionary dump is 57MB and regenerable in one curl (see spike/he/README.md).
# Both Hebrew builders read it -- pipeline/he_verbs.py and spike/he/build_lex.py -- and
# everything derived from it IS committed: the lexicon parquet and app/data/he/.
spike/he/kaikki-hebrew.jsonl
spike/he/audio/

# Backups downloaded from Account -> "Backup & restore". They are one person's study history
# and they carry that person's ESV API key; nothing in here belongs in the repo.
backup/
*-backup-*.json

# Project Ben-Yehuda's dump: 262 MB of public-domain Hebrew, the source pipeline/he_books.py
# selects from. Public domain, so it COULD be committed -- it is not, for the same reason the
# kaikki dump is not: it is upstream data this repo derives from, not content this repo ships.
# Download: github.com/projectbenyehuda/public_domain_dump/releases (txt.zip + pseudocatalogue.csv)
spike/he/benyehuda/
