 "sentences": [
  {
   "ar": "ג'וחא רצה להגיע לכפר.",
   "en": "Juha wanted to reach a village.",
   "p": 0
  },
  {
   "ar": "היו שתי דרכים מהבית שלו.",
   "en": "There were two roads from his house.",
   "p": 0
  },
  {
   "ar": "אחת הייתה קצרה אבל קשה.",
   "en": "One was short but hard.",
   "p": 0
  },
  {
   "ar": "השנייה הייתה ארוכה וקלה.",
   "en": "The second was long and easy.",
   "p": 0
  },
  {
   "ar": "הוא בחר בדרך הקצרה.",
   "en": "He chose the short road.",
   "p": 1
  },
  {
   "ar": "הדרך עלתה על הר גבוה.",
   "en": "The road went up a high mountain.",
   "p": 1
  },
  {
   "ar": "היו שם אבנים גדולות.",
   "en": "There were big stones there.",
   "p": 1
  },
  {
   "ar": "החמור הלך לאט מאוד.",
   "en": "The donkey walked very slowly.",
   "p": 1
  },
  {
   "ar": "אחרי שעה החמור עצר.",
   "en": "After an hour the donkey stopped.",
   "p": 2
  },
  {
   "ar": "הוא לא רצה ללכת יותר.",
   "en": "It did not want to walk any more.",
   "p": 2
  },
  {
   "ar": "ג'וחא ירד ומשך אותו.",
   "en": "Juha got down and pulled it.",
   "p": 2
  },
  {
   "ar": "החמור ישב על האדמה.",
   "en": "The donkey sat on the ground.",
   "p": 2
  },
  {
   "ar": "ג'וחא חזר בדרך הארוכה.",
   "en": "Juha went back by the long road.",
   "p": 3
  },
  {
   "ar": "הוא הגיע לכפר בערב.",
   "en": "He reached the village in the evening.",
   "p": 3
  },
  {
   "ar": "חבר שאל: איך הייתה הדרך?",
   "en": "A friend asked: how was the road?",
   "p": 3
  },
  {
   "ar": "הוא אמר: הקצרה היא הארוכה.",
   "en": "He said: the short one is the long one.",
   "p": 3
  },
  {
   "ar": "הוא אמר: והארוכה היא הקצרה.",
   "en": "He said: and the long one is the short one.",
   "p": 3
  }
 ]
}