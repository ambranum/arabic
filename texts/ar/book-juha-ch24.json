  {
   "ar": "ضيف إجا عند جحا.",
   "en": "A guest came to Juha.",
   "p": 0
  },
  {
   "ar": "من بلد بعيد.",
   "en": "From a far country.",
   "p": 0
  },
  {
   "ar": "وجحا فرح.",
   "en": "And Juha was glad.",
   "p": 0
  },
  {
   "ar": "وذبح دجاجة.",
   "en": "And killed a chicken.",
   "p": 0
  },
  {
   "ar": "وأكلوا.",
   "en": "And they ate.",
   "p": 0
  },
  {
   "ar": "وحكوا لنص الليل.",
   "en": "And talked till midnight.",
   "p": 0
  },
  {
   "ar": "تاني يوم، الضيف ضل.",
   "en": "The next day, the guest stayed.",
   "p": 1
  },
  {
   "ar": "وجحا طبخ.",
   "en": "And Juha cooked.",
   "p": 1
  },
  {
   "ar": "تالت يوم، الضيف ضل.",
   "en": "The third day, the guest stayed.",
   "p": 1
  },
  {
   "ar": "وجحا طبخ.",
   "en": "And Juha cooked.",
   "p": 1
  },
  {
   "ar": "رابع يوم، الضيف ضل.",
   "en": "The fourth day, the guest stayed.",
   "p": 1
  },
  {
   "ar": "وما في دجاج.",
   "en": "And there were no chickens left.",
   "p": 1
  },
  {
   "ar": "وجحا سكت.",
   "en": "And Juha was silent.",
   "p": 1
  },
  {
   "ar": "وبالمسا، جحا صار يحكي.",
   "en": "And in the evening, Juha began to talk.",
   "p": 2
  },
  {
   "ar": "عن السمك.",
   "en": "About fish.",
   "p": 2
  },
  {
   "ar": "قال: السمك حلو.",
   "en": "He said: fish is nice.",
   "p": 2
  },
  {
   "ar": "بس بعد تلات أيام، ريحته بتصير بشعة.",
   "en": "But after three days, it smells bad.",
   "p": 2
  },
  {
   "ar": "والضيف زي السمك.",
   "en": "And a guest is like fish.",
   "p": 2
  },
  {
   "ar": "بعد تلات أيام، بيريح.",
   "en": "After three days, he should go.",
   "p": 2
  },
  {
   "ar": "الضيف ضحك.",
   "en": "The guest laughed.",
   "p": 2
  },
  {
   "ar": "وقال: أنا مش سمك.",
   "en": "And said: I am not a fish.",
   "p": 2
  },
  {
   "ar": "قال جحا: بعرف.",
   "en": "Juha said: I know.",
   "p": 3
  },
  {
   "ar": "إنت مش سمك.",
   "en": "You are not a fish.",
   "p": 3
  },
  {
   "ar": "قال الضيف: فليش بتحكي عن السمك؟",
   "en": "The guest said: then why talk about fish?",
   "p": 3
  },
  {
   "ar": "قال جحا: لأني جعان.",
   "en": "Juha said: because I am hungry.",
   "p": 3
  },
  {
   "ar": "والدجاج خلص.",
   "en": "And the chickens are finished.",
   "p": 3
  },
  {
   "ar": "والضيف فهم.",
   "en": "And the guest understood.",
   "p": 3
  },
  {
   "ar": "وراح تاني يوم.",
   "en": "And left the next day.",
   "p": 3
  }
 ]
