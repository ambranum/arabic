{
 "id": "reactions",
 "title": {
  "ar": "ردود الفعل",
  "en": "Reactions"
 },
 "kind": "reactions",
 "dialect": "pal",
 "subdialect": "urban",
 "rationale": "Phase 1 of the path to the dinner table (LEARNING-SYSTEM.md §5). Reactions are the reflexes of conversation — the short, automatic chunks that let you be a real presence at a table long before you can build sentences. Grouped by the conversational job they do, so you can drill one function at a time. Curated interjections, not lexicon sentences: common and idiomatic, but honestly flagged as not native-checked.",
 "provenance_note": "Everyday Palestinian/Levantine reactions. The original 30 carried a Maknuune-corroboration flag; the additions are curated and marked needs-native-validation until a native speaker confirms the nuance.",
 "cats": [
  {
   "id": "surprise",
   "en": "Surprise & disbelief",
   "ar": "استغراب",
   "blurb": "Really?! No way. The reactions that show you're following — and a little amazed."
  },
  {
   "id": "agree",
   "en": "Agreement & confirmation",
   "ar": "موافقة",
   "blurb": "Yes, exactly, of course. The 'I'm with you' chunks that keep a conversation flowing."
  },
  {
   "id": "sympathy",
   "en": "Sympathy & care",
   "ar": "مواساة",
   "blurb": "Poor thing, never mind, get well. What you say when someone's having a hard time."
  },
  {
   "id": "praise",
   "en": "Praise & evaluation",
   "ar": "مدح",
   "blurb": "Nice, lovely, amazing. Reacting to food, a view, a photo, a story — you'll use these constantly."
  },
  {
   "id": "hedge",
   "en": "Hedging & uncertainty",
   "ar": "تحفّظ",
   "blurb": "Maybe, I don't know, sort of. Softening, buying time, not committing."
  },
  {
   "id": "glue",
   "en": "Discourse glue",
   "ar": "روابط الكلام",
   "blurb": "Well…, I mean…, anyway, and then? The fillers and turn-starters that do half the work of talk."
  },
  {
   "id": "table",
   "en": "Hospitality & the table",
   "ar": "ضيافة",
   "blurb": "Please, help yourself, bless your hands. The rituals you'll hear every few minutes as a guest."
  },
  {
   "id": "blessing",
   "en": "Blessings & goodbyes",
   "ar": "دعوات ووداع",
   "blurb": "More power to you, God keep you, goodnight. The warm formulas that close a moment."
  }
 ],
