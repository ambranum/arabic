 "sentences": [
  {
   "ar": "واحد إجا لجحا.",
   "en": "A man came to Juha.",
   "p": 0
  },
  {
   "ar": "وقال: إنت بتعرف تكتب.",
   "en": "And said: you can write.",
   "p": 0
  },
  {
   "ar": "اكتب لي مكتوب.",
   "en": "Write me a letter.",
   "p": 0
  },
  {
   "ar": "لأخوي بالمدينة.",
   "en": "To my brother in the city.",
   "p": 0
  },
  {
   "ar": "جحا قال: ما بقدر.",
   "en": "Juha said: I cannot.",
   "p": 0
  },
  {
   "ar": "قال الرجل: ليش؟",
   "en": "The man said: why?",
   "p": 0
  },
  {
   "ar": "قال جحا: إجري بتوجعني.",
   "en": "Juha said: my leg hurts.",
   "p": 1
  },
  {
   "ar": "الرجل استغرب.",
   "en": "The man was puzzled.",
   "p": 1
  },
  {
   "ar": "وقال: إجرك؟",
   "en": "And said: your leg?",
   "p": 1
  },
  {
   "ar": "شو دخل إجرك بالكتابة؟",
   "en": "What has your leg to do with writing?",
   "p": 1
  },
  {
   "ar": "إنت بتكتب بإيدك.",
   "en": "You write with your hand.",
   "p": 1
  },
  {
   "ar": "مش بإجرك.",
   "en": "Not your leg.",
   "p": 1
  },
  {
   "ar": "قال جحا: صحيح.",
   "en": "Juha said: true.",
   "p": 2
  },
  {
   "ar": "بكتب بإيدي.",
   "en": "I write with my hand.",
   "p": 2
  },
  {
   "ar": "بس خطي بشع.",
   "en": "But my handwriting is awful.",
   "p": 2
  },
  {
   "ar": "ما حدا بيقراه.",
   "en": "No one can read it.",
   "p": 2
  },
  {
   "ar": "غيري أنا.",
   "en": "Except me.",
   "p": 2
  },
  {
   "ar": "قال الرجل: يعني؟",
   "en": "The man said: meaning?",
   "p": 3
  },
  {
   "ar": "قال جحا: يعني بكتب المكتوب.",
   "en": "Juha said: meaning I write the letter.",
   "p": 3
  },
  {
   "ar": "وأخوك ما بيقدر يقراه.",
   "en": "And your brother cannot read it.",
   "p": 3
  },
  {
   "ar": "فلازم أمشي لعنده.",
   "en": "So I must walk to him.",
   "p": 3
  },
  {
   "ar": "للمدينة.",
   "en": "To the city.",
   "p": 3
  },
  {
   "ar": "وأقراه له.",
   "en": "And read it to him.",
   "p": 3
  },
  {
   "ar": "وإجري بتوجعني.",
   "en": "And my leg hurts.",
   "p": 3
  },
  {
   "ar": "فما بقدر.",
   "en": "So I cannot.",
   "p": 3
  }
 ]
}