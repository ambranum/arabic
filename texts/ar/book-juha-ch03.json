 "sentences": [
  {
   "ar": "جحا بده يطبخ لضيوف.",
   "en": "Juha wanted to cook for guests.",
   "p": 0
  },
  {
   "ar": "وطنجرته زغيرة.",
   "en": "And his pot was small.",
   "p": 0
  },
  {
   "ar": "راح لجاره.",
   "en": "He went to his neighbour.",
   "p": 0
  },
  {
   "ar": "وقال: أعطيني طنجرتك الكبيرة.",
   "en": "And said: give me your big pot.",
   "p": 0
  },
  {
   "ar": "يوم واحد بس.",
   "en": "Just one day.",
   "p": 0
  },
  {
   "ar": "الجار أعطاه.",
   "en": "The neighbour gave it.",
   "p": 0
  },
  {
   "ar": "بعد يومين، جحا رجعها.",
   "en": "Two days later, Juha returned it.",
   "p": 1
  },
  {
   "ar": "وجواتها طنجرة زغيرة.",
   "en": "And inside it, a small pot.",
   "p": 1
  },
  {
   "ar": "قال الجار: شو هاي؟",
   "en": "The neighbour said: what is this?",
   "p": 1
  },
  {
   "ar": "قال جحا: طنجرتك ولدت.",
   "en": "Juha said: your pot gave birth.",
   "p": 1
  },
  {
   "ar": "عندي.",
   "en": "At my house.",
   "p": 1
  },
  {
   "ar": "هاي بنتها.",
   "en": "This is her daughter.",
   "p": 1
  },
  {
   "ar": "الجار ضحك.",
   "en": "The neighbour laughed.",
   "p": 1
  },
  {
   "ar": "وأخد التنتين.",
   "en": "And took both.",
   "p": 1
  },
  {
   "ar": "وقال: جحا مجنون.",
   "en": "And said: Juha is mad.",
   "p": 1
  },
  {
   "ar": "بعد أسبوع، جحا رجع.",
   "en": "A week later, Juha came back.",
   "p": 2
  },
  {
   "ar": "قال: بدي الطنجرة كمان مرة.",
   "en": "He said: I want the pot again.",
   "p": 2
  },
  {
   "ar": "الجار أعطاه بسرعة.",
   "en": "The neighbour gave it quickly.",
   "p": 2
  },
  {
   "ar": "وقال بقلبه: يمكن تولد كمان.",
   "en": "And said to himself: maybe it gives birth again.",
   "p": 2
  },
  {
   "ar": "ومر يوم.",
   "en": "And a day passed.",
   "p": 2
  },
  {
   "ar": "ويومين.",
   "en": "And two.",
   "p": 2
  },
  {
   "ar": "وأسبوع.",
   "en": "And a week.",
   "p": 2
  },
  {
   "ar": "والطنجرة ما رجعت.",
   "en": "And the pot did not come back.",
   "p": 2
  },
  {
   "ar": "راح الجار لجحا.",
   "en": "The neighbour went to Juha.",
   "p": 3
  },
  {
   "ar": "قال: وين طنجرتي؟",
   "en": "He said: where is my pot?",
   "p": 3
  },
  {
   "ar": "جحا حط إيده على راسه.",
   "en": "Juha put his hand on his head.",
   "p": 3
  },
  {
   "ar": "وقال: الله يرحمها.",
   "en": "And said: God rest her.",
   "p": 3
  },
  {
   "ar": "ماتت.",
   "en": "She died.",
   "p": 3
  },
  {
   "ar": "قال الجار: ماتت؟",
   "en": "The neighbour said: died?",
   "p": 3
  },
  {
   "ar": "الطناجر ما بتموت!",
   "en": "Pots do not die!",
   "p": 3
  },
  {
   "ar": "قال جحا: غريب.",
   "en": "Juha said: strange.",
   "p": 3
  },
  {
   "ar": "صدقت إنها بتولد.",
   "en": "You believed she gives birth.",
   "p": 3
  },
  {
   "ar": "وما بتصدق إنها بتموت؟",
   "en": "And you do not believe she dies?",
   "p": 3
  }
 ]
