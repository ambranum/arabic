 "sentences": [
  {
   "ar": "الطاووس فتح ديله.",
   "en": "The peacock spread his tail.",
   "p": 0
  },
  {
   "ar": "ديل كبير، وفيه كل الألوان.",
   "en": "A big tail, with every colour in it.",
   "p": 0
  },
  {
   "ar": "أخضر، وأزرق، وذهبي.",
   "en": "Green, blue, gold.",
   "p": 0
  },
  {
   "ar": "وكان واقف بالشمس.",
   "en": "And he stood in the sun.",
   "p": 0
  },
  {
   "ar": "ومر الكركي.",
   "en": "And the crane passed.",
   "p": 0
  },
  {
   "ar": "طير رمادي، طويل، وبسيط.",
   "en": "A grey bird, tall, and plain.",
   "p": 0
  },
  {
   "ar": "قال الطاووس: شوف ديلي.",
   "en": "The peacock said: look at my tail.",
   "p": 1
  },
  {
   "ar": "وشوف ريشك.",
   "en": "And look at your feathers.",
   "p": 1
  },
  {
   "ar": "ريشك رمادي.",
   "en": "Your feathers are grey.",
   "p": 1
  },
  {
   "ar": "زي التراب.",
   "en": "Like dust.",
   "p": 1
  },
  {
   "ar": "أنا ملك الطيور.",
   "en": "I am the king of birds.",
   "p": 1
  },
  {
   "ar": "وإنت ولا شي.",
   "en": "And you are nothing.",
   "p": 1
  },
  {
   "ar": "الكركي ما زعل.",
   "en": "The crane was not upset.",
   "p": 2
  },
  {
   "ar": "قال: صحيح.",
   "en": "He said: true.",
   "p": 2
  },
  {
   "ar": "ريشك أحلى من ريشي.",
   "en": "Your feathers are lovelier than mine.",
   "p": 2
  },
  {
   "ar": "بس خليني أسألك سؤال.",
   "en": "But let me ask you a question.",
   "p": 2
  },
  {
   "ar": "بتقدر تطير؟",
   "en": "Can you fly?",
   "p": 2
  },
  {
   "ar": "الطاووس سكت.",
   "en": "The peacock was silent.",
   "p": 2
  },
  {
   "ar": "قال الكركي: أنا بطير.",
   "en": "The crane said: I fly.",
   "p": 3
  },
  {
   "ar": "بطير فوق الغيم.",
   "en": "I fly above the clouds.",
   "p": 3
  },
  {
   "ar": "وبشوف الدنيا كلها.",
   "en": "And see the whole world.",
   "p": 3
  },
  {
   "ar": "وإنت بتمشي بالحديقة.",
   "en": "And you walk in the garden.",
   "p": 3
  },
  {
   "ar": "وبتفتح ديلك.",
   "en": "And spread your tail.",
   "p": 3
  },
  {
   "ar": "وفتح جناحاته.",
   "en": "And he opened his wings.",
   "p": 3
  },
  {
   "ar": "وطار.",
   "en": "And flew.",
   "p": 3
  },
  {
   "ar": "الشكل شي، والفايدة شي تاني.",
   "en": "Looks are one thing, and use is another.",
   "p": 3
  }
 ]
