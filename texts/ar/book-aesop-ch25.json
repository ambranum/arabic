 "sentences": [
  {
   "ar": "ذيب كان جعان.",
   "en": "A wolf was hungry.",
   "p": 0
  },
  {
   "ar": "وقريب منه قطيع غنم.",
   "en": "And near him a flock of sheep.",
   "p": 0
  },
  {
   "ar": "بس الراعي دايماً موجود.",
   "en": "But the shepherd was always there.",
   "p": 0
  },
  {
   "ar": "ومعه كلاب.",
   "en": "And with him dogs.",
   "p": 0
  },
  {
   "ar": "والذيب ما بيقدر يقرب.",
   "en": "And the wolf could not come near.",
   "p": 0
  },
  {
   "ar": "وقعد يفكر.",
   "en": "And he sat thinking.",
   "p": 0
  },
  {
   "ar": "ولقى جلد خروف عالأرض.",
   "en": "And found a sheepskin on the ground.",
   "p": 0
  },
  {
   "ar": "لبس الذيب الجلد.",
   "en": "The wolf put on the skin.",
   "p": 1
  },
  {
   "ar": "وصار شكله خروف.",
   "en": "And looked like a sheep.",
   "p": 1
  },
  {
   "ar": "ومشى على مهل.",
   "en": "And walked slowly.",
   "p": 1
  },
  {
   "ar": "ودخل بين الغنم.",
   "en": "And went in among the sheep.",
   "p": 1
  },
  {
   "ar": "والراعي ما انتبه.",
   "en": "And the shepherd did not notice.",
   "p": 1
  },
  {
   "ar": "والكلاب ما انتبهت.",
   "en": "And the dogs did not notice.",
   "p": 1
  },
  {
   "ar": "والذيب قال: الليلة بآكل.",
   "en": "And the wolf said: tonight I eat.",
   "p": 1
  },
  {
   "ar": "وإجا المسا.",
   "en": "And evening came.",
   "p": 2
  },
  {
   "ar": "والراعي دخل الغنم للحظيرة.",
   "en": "And the shepherd put the sheep in the fold.",
   "p": 2
  },
  {
   "ar": "والذيب معهم.",
   "en": "And the wolf with them.",
   "p": 2
  },
  {
   "ar": "وسكر الباب.",
   "en": "And shut the gate.",
   "p": 2
  },
  {
   "ar": "والذيب قال: هلق.",
   "en": "And the wolf said: now.",
   "p": 2
  },
  {
   "ar": "واستنى العتمة.",
   "en": "And waited for the dark.",
   "p": 2
  },
  {
   "ar": "بس الراعي رجع.",
   "en": "But the shepherd came back.",
   "p": 3
  },
  {
   "ar": "كان بده لحمة للعشا.",
   "en": "He wanted meat for supper.",
   "p": 3
  },
  {
   "ar": "ودخل الحظيرة بالعتمة.",
   "en": "And went into the fold in the dark.",
   "p": 3
  },
  {
   "ar": "ومد إيده.",
   "en": "And reached out his hand.",
   "p": 3
  },
  {
   "ar": "وأخد أول خروف لقاه.",
   "en": "And took the first sheep he found.",
   "p": 3
  },
  {
   "ar": "كان الذيب.",
   "en": "It was the wolf.",
   "p": 3
  },
  {
   "ar": "ودبحه.",
   "en": "And killed him.",
   "p": 3
  },
  {
   "ar": "اللي بيتنكر، بيوقع بتنكره.",
   "en": "Whoever disguises himself falls by his disguise.",
   "p": 3
  }
 ]
}