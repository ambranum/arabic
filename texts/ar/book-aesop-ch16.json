 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "فلاح ومرته عندهم وزة.",
   "en": "A farmer and his wife had a goose.",
   "p": 0
  },
  {
   "ar": "وزة عادية، بيضا.",
   "en": "An ordinary goose, white.",
   "p": 0
  },
  {
   "ar": "وبيوم، الوزة باضت.",
   "en": "And one day, the goose laid an egg.",
   "p": 0
  },
  {
   "ar": "والفلاح راح ياخد البيضة.",
   "en": "And the farmer went to take the egg.",
   "p": 0
  },
  {
   "ar": "ووقف.",
   "en": "And stopped.",
   "p": 0
  },
  {
   "ar": "البيضة تقيلة.",
   "en": "The egg was heavy.",
   "p": 0
  },
  {
   "ar": "وصفرا، وبتلمع.",
   "en": "And yellow, and shining.",
   "p": 0
  },
  {
   "ar": "دهب.",
   "en": "Gold.",
   "p": 0
  },
  {
   "ar": "الفلاح ركض لمرته.",
   "en": "The farmer ran to his wife.",
   "p": 1
  },
  {
   "ar": "قال: شوفي!",
   "en": "He said: look!",
   "p": 1
  },
  {
   "ar": "بيضة دهب!",
   "en": "A golden egg!",
   "p": 1
  },
  {
   "ar": "وباعوها بالسوق.",
   "en": "And they sold it at the market.",
   "p": 1
  },
  {
   "ar": "بمصاري كتير.",
   "en": "For a lot of money.",
   "p": 1
  },
  {
   "ar": "وتاني يوم، بيضة تانية.",
   "en": "And the next day, another egg.",
   "p": 1
  },
  {
   "ar": "دهب.",
   "en": "Gold.",
   "p": 1
  },
  {
   "ar": "وتالت يوم، تالتة.",
   "en": "And the third day, a third.",
   "p": 1
  },
  {
   "ar": "كل يوم بيضة.",
   "en": "Every day an egg.",
   "p": 2
  },
  {
   "ar": "وكل يوم مصاري.",
   "en": "And every day money.",
   "p": 2
  },
  {
   "ar": "والفلاح صار غني.",
   "en": "And the farmer became rich.",
   "p": 2
  },
  {
   "ar": "بيت جديد، وأرض، وخيل.",
   "en": "A new house, land, horses.",
   "p": 2
  },
  {
   "ar": "بس ما كان مبسوط.",
   "en": "But he was not content.",
   "p": 2
  },
  {
   "ar": "قال: بيضة وحدة كل يوم.",
   "en": "He said: one egg every day.",
   "p": 2
  },
  {
   "ar": "بطيء.",
   "en": "Slow.",
   "p": 2
  },
  {
   "ar": "أكيد جوا الوزة، دهب كتير.",
   "en": "Surely inside the goose, there is a lot of gold.",
   "p": 2
  },
  {
   "ar": "قالت مرته: لا.",
   "en": "His wife said: no.",
   "p": 3
  },
  {
   "ar": "خليها.",
   "en": "Leave her.",
   "p": 3
  },
  {
   "ar": "قال الفلاح: بدي الدهب كله.",
   "en": "The farmer said: I want all the gold.",
   "p": 3
  },
  {
   "ar": "هلق.",
   "en": "Now.",
   "p": 3
  },
  {
   "ar": "وأخد سكين.",
   "en": "And took a knife.",
   "p": 3
  },
  {
   "ar": "ودبح الوزة.",
   "en": "And killed the goose.",
   "p": 3
  },
  {
   "ar": "وفتحها.",
   "en": "And opened her.",
   "p": 3
  },
  {
   "ar": "وجواها، ولا شي.",
   "en": "And inside, nothing.",
   "p": 3
  },
  {
   "ar": "وزة عادية.",
   "en": "An ordinary goose.",
   "p": 3
  },
  {
   "ar": "وما عاد في بيض.",
   "en": "And there were no more eggs.",
   "p": 3
  },
  {
   "ar": "الطمع بيخسر كل شي.",
   "en": "Greed loses everything.",
   "p": 3
  }
 ]
}