 "sentences": [
  {
   "ar": "صياد فقير قعد عالبحر.",
   "en": "A poor fisherman sat by the sea.",
   "p": 0
  },
  {
   "ar": "رمى الشبكة.",
   "en": "He cast the net.",
   "p": 0
  },
  {
   "ar": "واستنى.",
   "en": "And waited.",
   "p": 0
  },
  {
   "ar": "ساعة، وساعتين، وتلاتة.",
   "en": "An hour, two, three.",
   "p": 0
  },
  {
   "ar": "ولا سمكة.",
   "en": "Not one fish.",
   "p": 0
  },
  {
   "ar": "وبالآخر، حس بشي.",
   "en": "And at last, he felt something.",
   "p": 0
  },
  {
   "ar": "وسحب الشبكة.",
   "en": "And pulled in the net.",
   "p": 0
  },
  {
   "ar": "كان فيها سمكة وحدة.",
   "en": "In it was one fish.",
   "p": 1
  },
  {
   "ar": "سمكة زغيرة كتير.",
   "en": "A very small fish.",
   "p": 1
  },
  {
   "ar": "قد الإصبع.",
   "en": "The size of a finger.",
   "p": 1
  },
  {
   "ar": "والسمكة حكت.",
   "en": "And the fish spoke.",
   "p": 1
  },
  {
   "ar": "قالت: يا صياد، أنا زغيرة.",
   "en": "It said: fisherman, I am small.",
   "p": 1
  },
  {
   "ar": "ما فيّ لحم.",
   "en": "There is no meat on me.",
   "p": 1
  },
  {
   "ar": "ارميني بالبحر.",
   "en": "Throw me back in the sea.",
   "p": 1
  },
  {
   "ar": "قالت السمكة: بعد سنة، بكبر.",
   "en": "The fish said: in a year, I grow.",
   "p": 2
  },
  {
   "ar": "بصير سمكة كبيرة.",
   "en": "I become a big fish.",
   "p": 2
  },
  {
   "ar": "ووقتها تعال وصيدني.",
   "en": "And then come and catch me.",
   "p": 2
  },
  {
   "ar": "بتشبع منّي أنا وعيلتك.",
   "en": "You and your family will be full from me.",
   "p": 2
  },
  {
   "ar": "الصياد سمع.",
   "en": "The fisherman listened.",
   "p": 2
  },
  {
   "ar": "وتطلع بالسمكة.",
   "en": "And looked at the fish.",
   "p": 2
  },
  {
   "ar": "وفكر.",
   "en": "And thought.",
   "p": 2
  },
  {
   "ar": "وقال: لا.",
   "en": "And said: no.",
   "p": 3
  },
  {
   "ar": "إنتِ بإيدي هلق.",
   "en": "You are in my hand now.",
   "p": 3
  },
  {
   "ar": "والسمكة الكبيرة بالبحر.",
   "en": "And the big fish is in the sea.",
   "p": 3
  },
  {
   "ar": "يمكن بتيجي، ويمكن لا.",
   "en": "Maybe it comes, maybe not.",
   "p": 3
  },
  {
   "ar": "وحطها بالسلة.",
   "en": "And put it in the basket.",
   "p": 3
  },
  {
   "ar": "وراح عالبيت.",
   "en": "And went home.",
   "p": 3
  },
  {
   "ar": "عصفور بالإيد، ولا عشرة عالشجرة.",
   "en": "A bird in the hand is worth ten in the tree.",
   "p": 3
  }
 ]
}