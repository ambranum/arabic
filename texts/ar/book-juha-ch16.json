 "sentences": [
  {
   "ar": "جارة جحا دقت الباب.",
   "en": "Juha's neighbour knocked at the door.",
   "p": 0
  },
  {
   "ar": "وقالت: يا جحا.",
   "en": "And said: Juha.",
   "p": 0
  },
  {
   "ar": "عندك ملح؟",
   "en": "Do you have salt?",
   "p": 0
  },
  {
   "ar": "قال جحا: عندي.",
   "en": "Juha said: I have.",
   "p": 0
  },
  {
   "ar": "وأعطاها.",
   "en": "And gave her some.",
   "p": 0
  },
  {
   "ar": "وراحت.",
   "en": "And she left.",
   "p": 0
  },
  {
   "ar": "بعد شوي، رجعت.",
   "en": "A little later, she came back.",
   "p": 1
  },
  {
   "ar": "وقالت: عندك زيت؟",
   "en": "And said: do you have oil?",
   "p": 1
  },
  {
   "ar": "قال جحا: عندي.",
   "en": "Juha said: I have.",
   "p": 1
  },
  {
   "ar": "وأعطاها.",
   "en": "And gave her some.",
   "p": 1
  },
  {
   "ar": "وبعد شوي، رجعت.",
   "en": "And a little later, she came back.",
   "p": 1
  },
  {
   "ar": "وقالت: عندك بصل؟",
   "en": "And said: do you have onions?",
   "p": 1
  },
  {
   "ar": "وأعطاها.",
   "en": "And he gave her some.",
   "p": 1
  },
  {
   "ar": "وبعدين رز.",
   "en": "And then rice.",
   "p": 1
  },
  {
   "ar": "وبعدين لحمة.",
   "en": "And then meat.",
   "p": 1
  },
  {
   "ar": "وبعدين حطب.",
   "en": "And then firewood.",
   "p": 1
  },
  {
   "ar": "وجحا بيعطي.",
   "en": "And Juha kept giving.",
   "p": 2
  },
  {
   "ar": "وبيسكت.",
   "en": "And kept quiet.",
   "p": 2
  },
  {
   "ar": "وبالمسا، الجارة إجت.",
   "en": "And in the evening, the neighbour came.",
   "p": 2
  },
  {
   "ar": "وهي مبسوطة.",
   "en": "Pleased.",
   "p": 2
  },
  {
   "ar": "وقالت: يا جحا.",
   "en": "And said: Juha.",
   "p": 2
  },
  {
   "ar": "الأكل جاهز.",
   "en": "The food is ready.",
   "p": 2
  },
  {
   "ar": "بتحب تاكل معنا؟",
   "en": "Would you like to eat with us?",
   "p": 2
  },
  {
   "ar": "قال جحا: أكيد.",
   "en": "Juha said: certainly.",
   "p": 3
  },
  {
   "ar": "وقام.",
   "en": "And got up.",
   "p": 3
  },
  {
   "ar": "وقالت الجارة: كرم منك.",
   "en": "And the neighbour said: how kind of you.",
   "p": 3
  },
  {
   "ar": "قال جحا: مش كرم.",
   "en": "Juha said: not kindness.",
   "p": 3
  },
  {
   "ar": "هاد أكلي.",
   "en": "This is my food.",
   "p": 3
  },
  {
   "ar": "الملح إلي، والزيت إلي.",
   "en": "The salt is mine, and the oil is mine.",
   "p": 3
  },
  {
   "ar": "والبصل، والرز، واللحمة، والحطب.",
   "en": "And the onions, the rice, the meat, the wood.",
   "p": 3
  },
  {
   "ar": "إنتِ بس طبختيه.",
   "en": "You only cooked it.",
   "p": 3
  }
 ]
}