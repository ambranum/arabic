 "sentences": [
  {
   "ar": "جحا صار قاضي.",
   "en": "Juha became a judge.",
   "p": 0
  },
  {
   "ar": "بالقرية.",
   "en": "In the village.",
   "p": 0
  },
  {
   "ar": "وبيوم، إجا له اتنين.",
   "en": "And one day, two men came to him.",
   "p": 0
  },
  {
   "ar": "بيتخانقوا.",
   "en": "Quarrelling.",
   "p": 0
  },
  {
   "ar": "على أرض.",
   "en": "Over land.",
   "p": 0
  },
  {
   "ar": "قال جحا: احكوا.",
   "en": "Juha said: speak.",
   "p": 0
  },
  {
   "ar": "واحد واحد.",
   "en": "One at a time.",
   "p": 0
  },
  {
   "ar": "الأول حكى.",
   "en": "The first spoke.",
   "p": 1
  },
  {
   "ar": "قال: الأرض إلي.",
   "en": "He said: the land is mine.",
   "p": 1
  },
  {
   "ar": "أبوي زرعها.",
   "en": "My father farmed it.",
   "p": 1
  },
  {
   "ar": "وجدي زرعها.",
   "en": "And my grandfather farmed it.",
   "p": 1
  },
  {
   "ar": "وحكى كتير.",
   "en": "And he spoke at length.",
   "p": 1
  },
  {
   "ar": "وجحا سمع.",
   "en": "And Juha listened.",
   "p": 1
  },
  {
   "ar": "وقال: معك حق.",
   "en": "And said: you are right.",
   "p": 1
  },
  {
   "ar": "التاني حكى.",
   "en": "The second spoke.",
   "p": 2
  },
  {
   "ar": "قال: لا، الأرض إلي.",
   "en": "He said: no, the land is mine.",
   "p": 2
  },
  {
   "ar": "اشتريتها.",
   "en": "I bought it.",
   "p": 2
  },
  {
   "ar": "ومعي ورقة.",
   "en": "And I have a paper.",
   "p": 2
  },
  {
   "ar": "وحكى كتير.",
   "en": "And he spoke at length.",
   "p": 2
  },
  {
   "ar": "وجحا سمع.",
   "en": "And Juha listened.",
   "p": 2
  },
  {
   "ar": "وقال: وإنت كمان معك حق.",
   "en": "And said: and you are right too.",
   "p": 2
  },
  {
   "ar": "مرة جحا كانت قاعدة.",
   "en": "Juha's wife was sitting there.",
   "p": 3
  },
  {
   "ar": "ورا الباب.",
   "en": "Behind the door.",
   "p": 3
  },
  {
   "ar": "وسمعت.",
   "en": "And heard.",
   "p": 3
  },
  {
   "ar": "وقالت: يا جحا!",
   "en": "And said: Juha!",
   "p": 3
  },
  {
   "ar": "شو هالحكم؟",
   "en": "What kind of judgement is that?",
   "p": 3
  },
  {
   "ar": "ما بيصير التنين على حق!",
   "en": "Both cannot be right!",
   "p": 3
  },
  {
   "ar": "جحا فكر شوي.",
   "en": "Juha thought a moment.",
   "p": 3
  },
  {
   "ar": "وقال: وإنتِ كمان معك حق.",
   "en": "And said: and you are right too.",
   "p": 3
  }
