 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "كان في رجل بخيل.",
   "en": "There was a miser.",
   "p": 0
  },
  {
   "ar": "عنده دهب كتير.",
   "en": "He had a lot of gold.",
   "p": 0
  },
  {
   "ar": "بس ما بيصرف قرش.",
   "en": "But he never spent a penny.",
   "p": 0
  },
  {
   "ar": "بياكل خبز ومي.",
   "en": "He ate bread and water.",
   "p": 0
  },
  {
   "ar": "ولابس تياب قديمة.",
   "en": "And wore old clothes.",
   "p": 0
  },
  {
   "ar": "والدهب مخبى.",
   "en": "And the gold was hidden.",
   "p": 0
  },
  {
   "ar": "بحفرة، تحت شجرة، بالحديقة.",
   "en": "In a hole, under a tree, in the garden.",
   "p": 0
  },
  {
   "ar": "كل ليلة، بيطلع.",
   "en": "Every night, he went out.",
   "p": 1
  },
  {
   "ar": "وبيحفر.",
   "en": "And dug.",
   "p": 1
  },
  {
   "ar": "وبيطلع الدهب.",
   "en": "And took out the gold.",
   "p": 1
  },
  {
   "ar": "وبيعده.",
   "en": "And counted it.",
   "p": 1
  },
  {
   "ar": "وبيتطلع فيه.",
   "en": "And looked at it.",
   "p": 1
  },
  {
   "ar": "وبيرجعه للحفرة.",
   "en": "And put it back in the hole.",
   "p": 1
  },
  {
   "ar": "وبينام مبسوط.",
   "en": "And slept content.",
   "p": 1
  },
  {
   "ar": "وبيوم، شافه حرامي.",
   "en": "And one day, a thief saw him.",
   "p": 2
  },
  {
   "ar": "شافه بيحفر بالليل.",
   "en": "Saw him digging at night.",
   "p": 2
  },
  {
   "ar": "واستنى لحد ما نام.",
   "en": "And waited until he slept.",
   "p": 2
  },
  {
   "ar": "وحفر.",
   "en": "And dug.",
   "p": 2
  },
  {
   "ar": "وأخد الدهب كله.",
   "en": "And took all the gold.",
   "p": 2
  },
  {
   "ar": "وراح.",
   "en": "And left.",
   "p": 2
  },
  {
   "ar": "تاني ليلة، البخيل طلع.",
   "en": "The next night, the miser went out.",
   "p": 3
  },
  {
   "ar": "وحفر.",
   "en": "And dug.",
   "p": 3
  },
  {
   "ar": "والحفرة فاضية.",
   "en": "And the hole was empty.",
   "p": 3
  },
  {
   "ar": "وصرخ.",
   "en": "And he screamed.",
   "p": 3
  },
  {
   "ar": "وبكى.",
   "en": "And wept.",
   "p": 3
  },
  {
   "ar": "وإجا جاره.",
   "en": "And his neighbour came.",
   "p": 3
  },
  {
   "ar": "وقال: شو صار؟",
   "en": "And said: what happened?",
   "p": 3
  },
  {
   "ar": "قال البخيل: دهبي!",
   "en": "The miser said: my gold!",
   "p": 3
  },
  {
   "ar": "سرقوه!",
   "en": "Stolen!",
   "p": 3
  },
  {
   "ar": "قال الجار: وكنت بتصرف منه؟",
   "en": "The neighbour said: and were you spending it?",
   "p": 3
  },
  {
   "ar": "قال البخيل: لا.",
   "en": "The miser said: no.",
   "p": 3
  },
  {
   "ar": "أبداً.",
   "en": "Never.",
   "p": 3
  },
  {
   "ar": "قال الجار: طيب.",
   "en": "The neighbour said: fine.",
   "p": 3
  },
  {
   "ar": "حط حجر بالحفرة.",
   "en": "Put a stone in the hole.",
   "p": 3
  },
  {
   "ar": "وتطلع فيه كل ليلة.",
   "en": "And look at it every night.",
   "p": 3
  },
  {
   "ar": "نفس الشي.",
   "en": "The same thing.",
   "p": 3
  },
  {
   "ar": "الدهب اللي ما بتستعمله، زي الحجر.",
   "en": "Gold you do not use is like a stone.",
   "p": 3
  }
 ]
}