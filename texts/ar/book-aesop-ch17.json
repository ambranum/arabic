 "sentences": [
  {
   "ar": "كلب سرق قطعة لحمة.",
   "en": "A dog stole a piece of meat.",
   "p": 0
  },
  {
   "ar": "من عند اللحام.",
   "en": "From the butcher's.",
   "p": 0
  },
  {
   "ar": "قطعة كبيرة.",
   "en": "A big piece.",
   "p": 0
  },
  {
   "ar": "وركض.",
   "en": "And ran.",
   "p": 0
  },
  {
   "ar": "واللحام ركض وراه.",
   "en": "And the butcher ran after him.",
   "p": 0
  },
  {
   "ar": "بس الكلب أسرع.",
   "en": "But the dog was faster.",
   "p": 0
  },
  {
   "ar": "ووصل للنهر.",
   "en": "And reached the river.",
   "p": 0
  },
  {
   "ar": "كان في جسر زغير.",
   "en": "There was a small bridge.",
   "p": 1
  },
  {
   "ar": "والكلب مشى عليه.",
   "en": "And the dog walked across it.",
   "p": 1
  },
  {
   "ar": "واللحمة بتمه.",
   "en": "The meat in his mouth.",
   "p": 1
  },
  {
   "ar": "وتطلع لتحت.",
   "en": "And he looked down.",
   "p": 1
  },
  {
   "ar": "وشاف بالمي كلب.",
   "en": "And saw in the water a dog.",
   "p": 1
  },
  {
   "ar": "وبتم الكلب، لحمة.",
   "en": "And in the dog's mouth, meat.",
   "p": 1
  },
  {
   "ar": "لحمة كبيرة.",
   "en": "Big meat.",
   "p": 1
  },
  {
   "ar": "أكبر من لحمته.",
   "en": "Bigger than his.",
   "p": 1
  },
  {
   "ar": "قال الكلب: بدي هاي كمان.",
   "en": "The dog said: I want that too.",
   "p": 2
  },
  {
   "ar": "ونبح.",
   "en": "And barked.",
   "p": 2
  },
  {
   "ar": "عشان يخوف الكلب التاني.",
   "en": "To frighten the other dog.",
   "p": 2
  },
  {
   "ar": "ولما فتح تمه، وقعت اللحمة.",
   "en": "And when he opened his mouth, the meat fell.",
   "p": 2
  },
  {
   "ar": "وقعت بالنهر.",
   "en": "It fell into the river.",
   "p": 2
  },
  {
   "ar": "والنهر أخدها.",
   "en": "And the river took it.",
   "p": 2
  },
  {
   "ar": "والكلب تطلع بالمي.",
   "en": "And the dog looked at the water.",
   "p": 3
  },
  {
   "ar": "الكلب التاني راح.",
   "en": "The other dog was gone.",
   "p": 3
  },
  {
   "ar": "واللحمة التانية راحت.",
   "en": "And the other meat was gone.",
   "p": 3
  },
  {
   "ar": "كان هو.",
   "en": "It had been himself.",
   "p": 3
  },
  {
   "ar": "خياله بالمي.",
   "en": "His reflection in the water.",
   "p": 3
  },
  {
   "ar": "ورجع عالبيت جعان.",
   "en": "And he went home hungry.",
   "p": 3
  },
  {
   "ar": "اللي بيطمع بالكل، بيخسر اللي معه.",
   "en": "Whoever grasps at everything loses what he has.",
   "p": 3
  }
 ]
