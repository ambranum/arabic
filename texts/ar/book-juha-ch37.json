 },
 "level": "beginner",
 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "ولاد الحي كانوا يضحكوا على جحا.",
   "en": "The neighbourhood boys used to laugh at Juha.",
   "p": 0
  },
  {
   "ar": "كل يوم.",
   "en": "Every day.",
   "p": 0
  },
  {
   "ar": "بيقولوا: جحا غبي.",
   "en": "They said: Juha is stupid.",
   "p": 0
  },
  {
   "ar": "وعندهم لعبة.",
   "en": "And they had a game.",
   "p": 0
  },
  {
   "ar": "بيعطوه قرشين.",
   "en": "They offered him two coins.",
   "p": 0
  },
  {
   "ar": "واحد كبير.",
   "en": "One big.",
   "p": 0
  },
  {
   "ar": "وواحد زغير.",
   "en": "And one small.",
   "p": 0
  },
  {
   "ar": "وبيقولوا: خد واحد.",
   "en": "And said: take one.",
   "p": 0
  },
  {
   "ar": "وجحا بياخد الزغير.",
   "en": "And Juha took the small one.",
   "p": 1
  },
  {
   "ar": "كل مرة.",
   "en": "Every time.",
   "p": 1
  },
  {
   "ar": "والولاد بيضحكوا.",
   "en": "And the boys laughed.",
   "p": 1
  },
  {
   "ar": "بيقولوا: شفتوا؟",
   "en": "They said: you see?",
   "p": 1
  },
  {
   "ar": "غبي!",
   "en": "Stupid!",
   "p": 1
  },
  {
   "ar": "ما بيعرف الكبير من الزغير!",
   "en": "He cannot tell big from small!",
   "p": 1
  },
  {
   "ar": "وبيرجعوا تاني يوم.",
   "en": "And they came back the next day.",
   "p": 1
  },
  {
   "ar": "وبيوم، واحد كبير شاف.",
   "en": "And one day, a grown man saw.",
   "p": 2
  },
  {
   "ar": "وزعل عالولاد.",
   "en": "And was upset with the boys.",
   "p": 2
  },
  {
   "ar": "وأخد جحا عالجنب.",
   "en": "And took Juha aside.",
   "p": 2
  },
  {
   "ar": "وقال: يا جحا.",
   "en": "And said: Juha.",
   "p": 2
  },
  {
   "ar": "القرش الكبير بيسوى أكتر.",
   "en": "The big coin is worth more.",
   "p": 2
  },
  {
   "ar": "خد الكبير.",
   "en": "Take the big one.",
   "p": 2
  },
  {
   "ar": "لا تخليهم يضحكوا عليك.",
   "en": "Do not let them laugh at you.",
   "p": 2
  },
  {
   "ar": "جحا ضحك.",
   "en": "Juha laughed.",
   "p": 3
  },
  {
   "ar": "وقال: بعرف.",
   "en": "And said: I know.",
   "p": 3
  },
  {
   "ar": "قال الرجل: فليش بتاخد الزغير؟",
   "en": "The man said: then why take the small one?",
   "p": 3
  },
  {
   "ar": "قال جحا: فكر.",
   "en": "Juha said: think.",
   "p": 3
  },
  {
   "ar": "لو أخدت الكبير مرة، بيبطلوا يلعبوا.",
   "en": "If I took the big one once, they would stop playing.",
   "p": 3
  },
  {
   "ar": "وما بضل آخد ولا قرش.",
   "en": "And I would get no coins at all.",
   "p": 3
  },
  {
   "ar": "هيك، بآخد قرش كل يوم.",
   "en": "This way, I get a coin every day.",
   "p": 3
  },
  {
   "ar": "من عشر سنين.",
   "en": "For ten years now.",
   "p": 3
  }
 ]
}