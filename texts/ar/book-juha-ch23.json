 "sentences": [
  {
   "ar": "جار جحا كان مستعجل.",
   "en": "Juha's neighbour was in a hurry.",
   "p": 0
  },
  {
   "ar": "دايماً مستعجل.",
   "en": "Always in a hurry.",
   "p": 0
  },
  {
   "ar": "وبيوم، طلب من جحا شغلة.",
   "en": "And one day, he asked Juha for a job.",
   "p": 0
  },
  {
   "ar": "يصلح له باب.",
   "en": "To fix a door for him.",
   "p": 0
  },
  {
   "ar": "قال جحا: طيب.",
   "en": "Juha said: fine.",
   "p": 0
  },
  {
   "ar": "وبلش.",
   "en": "And began.",
   "p": 0
  },
  {
   "ar": "تاني يوم، الجار إجا.",
   "en": "The next day, the neighbour came.",
   "p": 1
  },
  {
   "ar": "قال: خلصت؟",
   "en": "He said: finished?",
   "p": 1
  },
  {
   "ar": "قال جحا: لسا.",
   "en": "Juha said: not yet.",
   "p": 1
  },
  {
   "ar": "تالت يوم، الجار إجا.",
   "en": "The third day, the neighbour came.",
   "p": 1
  },
  {
   "ar": "قال: خلصت؟",
   "en": "He said: finished?",
   "p": 1
  },
  {
   "ar": "قال جحا: لسا.",
   "en": "Juha said: not yet.",
   "p": 1
  },
  {
   "ar": "قال الجار: إمتى بتخلص؟",
   "en": "The neighbour said: when will you finish?",
   "p": 1
  },
  {
   "ar": "قال جحا: بتسع شهور.",
   "en": "Juha said: in nine months.",
   "p": 2
  },
  {
   "ar": "قال الجار: تسع شهور؟!",
   "en": "The neighbour said: nine months?!",
   "p": 2
  },
  {
   "ar": "هاي شغلة يومين!",
   "en": "This is a two-day job!",
   "p": 2
  },
  {
   "ar": "باب!",
   "en": "A door!",
   "p": 2
  },
  {
   "ar": "قال جحا: بعرف.",
   "en": "Juha said: I know.",
   "p": 2
  },
  {
   "ar": "قال الجار: فليش تسع شهور؟",
   "en": "The neighbour said: then why nine months?",
   "p": 2
  },
  {
   "ar": "قال جحا: يا جاري.",
   "en": "Juha said: neighbour.",
   "p": 3
  },
  {
   "ar": "الله خلق الدنيا بستة أيام.",
   "en": "God made the world in six days.",
   "p": 3
  },
  {
   "ar": "بس الولد، بده تسع شهور.",
   "en": "But a child takes nine months.",
   "p": 3
  },
  {
   "ar": "كل شي حلو، بده تسع شهور.",
   "en": "Everything good takes nine months.",
   "p": 3
  },
  {
   "ar": "وبابك بدي ياه حلو.",
   "en": "And I want your door to be good.",
   "p": 3
  }
 ]
