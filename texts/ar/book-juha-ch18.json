  {
   "ar": "جحا استلف مصاري.",
   "en": "Juha borrowed money.",
   "p": 0
  },
  {
   "ar": "من رجل بالسوق.",
   "en": "From a man in the market.",
   "p": 0
  },
  {
   "ar": "وقال: برجعها بعد شهر.",
   "en": "And said: I will return it in a month.",
   "p": 0
  },
  {
   "ar": "ومر الشهر.",
   "en": "And the month passed.",
   "p": 0
  },
  {
   "ar": "وجحا ما معه.",
   "en": "And Juha had nothing.",
   "p": 0
  },
  {
   "ar": "ولا قرش.",
   "en": "Not a penny.",
   "p": 0
  },
  {
   "ar": "الرجل إجا عالبيت.",
   "en": "The man came to the house.",
   "p": 1
  },
  {
   "ar": "ودق الباب.",
   "en": "And knocked.",
   "p": 1
  },
  {
   "ar": "وصرخ: يا جحا!",
   "en": "And shouted: Juha!",
   "p": 1
  },
  {
   "ar": "مصاريي!",
   "en": "My money!",
   "p": 1
  },
  {
   "ar": "جحا سمع.",
   "en": "Juha heard.",
   "p": 1
  },
  {
   "ar": "وقال لمرته: قولي له مش هون.",
   "en": "And told his wife: tell him I am not here.",
   "p": 1
  },
  {
   "ar": "وتخبى ورا الباب.",
   "en": "And hid behind the door.",
   "p": 1
  },
  {
   "ar": "مرته فتحت.",
   "en": "His wife opened.",
   "p": 2
  },
  {
   "ar": "وقالت: جحا مش بالبيت.",
   "en": "And said: Juha is not at home.",
   "p": 2
  },
  {
   "ar": "راح عالمدينة.",
   "en": "He went to the city.",
   "p": 2
  },
  {
   "ar": "الرجل ما صدق.",
   "en": "The man did not believe.",
   "p": 2
  },
  {
   "ar": "وتطلع من الشباك.",
   "en": "And looked through the window.",
   "p": 2
  },
  {
   "ar": "وشاف جحا.",
   "en": "And saw Juha.",
   "p": 2
  },
  {
   "ar": "ورا الباب.",
   "en": "Behind the door.",
   "p": 2
  },
  {
   "ar": "صرخ الرجل: يا جحا!",
   "en": "The man shouted: Juha!",
   "p": 3
  },
  {
   "ar": "أنا بشوفك!",
   "en": "I can see you!",
   "p": 3
  },
  {
   "ar": "إنت ورا الباب!",
   "en": "You are behind the door!",
   "p": 3
  },
  {
   "ar": "جحا طلع راسه.",
   "en": "Juha put his head out.",
   "p": 3
  },
  {
   "ar": "وقال: بتشوفني؟",
   "en": "And said: you can see me?",
   "p": 3
  },
  {
   "ar": "قال الرجل: بشوفك!",
   "en": "The man said: I see you!",
   "p": 3
  },
  {
   "ar": "قال جحا: طيب.",
   "en": "Juha said: fine.",
   "p": 3
  },
  {
   "ar": "وبكرا لما أموت، بتشوفني كمان؟",
   "en": "And tomorrow when I die, will you see me too?",
   "p": 3
  }
 ]
