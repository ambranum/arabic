 "sentences": [
  {
   "ar": "الأسد كان نايم تحت شجرة.",
   "en": "The lion was sleeping under a tree.",
   "p": 0
  },
  {
   "ar": "وفار زغير مرق من جنبه.",
   "en": "And a little mouse passed beside him.",
   "p": 0
  },
  {
   "ar": "الفار ما شاف الأسد.",
   "en": "The mouse did not see the lion.",
   "p": 0
  },
  {
   "ar": "وركض على ظهره.",
   "en": "And ran over his back.",
   "p": 0
  },
  {
   "ar": "الأسد فاق.",
   "en": "The lion woke.",
   "p": 0
  },
  {
   "ar": "ومسك الفار بإيده.",
   "en": "And caught the mouse in his paw.",
   "p": 0
  },
  {
   "ar": "وفتح تمه.",
   "en": "And opened his mouth.",
   "p": 0
  },
  {
   "ar": "قال الفار: لا!",
   "en": "The mouse said: no!",
   "p": 1
  },
  {
   "ar": "لا تاكلني!",
   "en": "Do not eat me!",
   "p": 1
  },
  {
   "ar": "أنا زغير.",
   "en": "I am small.",
   "p": 1
  },
  {
   "ar": "ما بشبعك.",
   "en": "I will not fill you.",
   "p": 1
  },
  {
   "ar": "خليني أعيش.",
   "en": "Let me live.",
   "p": 1
  },
  {
   "ar": "ويمكن بيوم، بساعدك.",
   "en": "And perhaps one day, I help you.",
   "p": 1
  },
  {
   "ar": "الأسد ضحك.",
   "en": "The lion laughed.",
   "p": 1
  },
  {
   "ar": "قال: إنت؟",
   "en": "He said: you?",
   "p": 1
  },
  {
   "ar": "بتساعدني أنا؟",
   "en": "Help me?",
   "p": 1
  },
  {
   "ar": "بس الأسد كان شبعان.",
   "en": "But the lion was full.",
   "p": 2
  },
  {
   "ar": "وكان مبسوط.",
   "en": "And he was in a good mood.",
   "p": 2
  },
  {
   "ar": "فتح إيده.",
   "en": "He opened his paw.",
   "p": 2
  },
  {
   "ar": "وقال: روح.",
   "en": "And said: go.",
   "p": 2
  },
  {
   "ar": "والفار ركض.",
   "en": "And the mouse ran.",
   "p": 2
  },
  {
   "ar": "وقال: شكراً!",
   "en": "And said: thank you!",
   "p": 2
  },
  {
   "ar": "ما بنسى!",
   "en": "I will not forget!",
   "p": 2
  },
  {
   "ar": "بعد أسبوع، الأسد وقع بشبكة.",
   "en": "A week later, the lion fell into a net.",
   "p": 3
  },
  {
   "ar": "شبكة صيادين.",
   "en": "A hunters' net.",
   "p": 3
  },
  {
   "ar": "حاول يطلع.",
   "en": "He tried to get out.",
   "p": 3
  },
  {
   "ar": "ما قدر.",
   "en": "He could not.",
   "p": 3
  },
  {
   "ar": "الحبال قوية.",
   "en": "The ropes were strong.",
   "p": 3
  },
  {
   "ar": "وزعق.",
   "en": "And he roared.",
   "p": 3
  },
  {
   "ar": "زعق لحد ما سمعته كل الغابة.",
   "en": "He roared until the whole forest heard.",
   "p": 3
  },
  {
   "ar": "والفار سمع.",
   "en": "And the mouse heard.",
   "p": 4
  },
  {
   "ar": "وركض عالأسد.",
   "en": "And ran to the lion.",
   "p": 4
  },
  {
   "ar": "وقال: أنا هون.",
   "en": "And said: I am here.",
   "p": 4
  },
  {
   "ar": "وبلش يقص الحبال بأسنانه.",
   "en": "And began cutting the ropes with his teeth.",
   "p": 4
  },
  {
   "ar": "حبل، وحبل، وحبل.",
   "en": "Rope, and rope, and rope.",
   "p": 4
  },
  {
   "ar": "والأسد طلع.",
   "en": "And the lion got out.",
   "p": 4
  },
  {
   "ar": "قال: إنت زغير، بس ساعدتني.",
   "en": "He said: you are small, but you helped me.",
   "p": 4
  },
  {
   "ar": "الزغير كمان بيفيد.",
   "en": "The small one is useful too.",
   "p": 4
  }
 ]
}