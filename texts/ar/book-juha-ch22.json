 "sentences": [
  {
   "ar": "جحا راح عالسوق.",
   "en": "Juha went to the market.",
   "p": 0
  },
  {
   "ar": "واشترى سلة.",
   "en": "And bought a basket.",
   "p": 0
  },
  {
   "ar": "سلة كبيرة.",
   "en": "A big basket.",
   "p": 0
  },
  {
   "ar": "مليانة خضار.",
   "en": "Full of vegetables.",
   "p": 0
  },
  {
   "ar": "وتقيلة.",
   "en": "And heavy.",
   "p": 0
  },
  {
   "ar": "وحماره واقف برا.",
   "en": "And his donkey stood outside.",
   "p": 0
  },
  {
   "ar": "جحا ركب الحمار.",
   "en": "Juha got on the donkey.",
   "p": 1
  },
  {
   "ar": "وحمل السلة.",
   "en": "And lifted the basket.",
   "p": 1
  },
  {
   "ar": "وحطها على راسه.",
   "en": "And put it on his head.",
   "p": 1
  },
  {
   "ar": "هو راكب.",
   "en": "He riding.",
   "p": 1
  },
  {
   "ar": "والسلة على راسه.",
   "en": "And the basket on his head.",
   "p": 1
  },
  {
   "ar": "والحمار ماشي.",
   "en": "And the donkey walking.",
   "p": 1
  },
  {
   "ar": "واحد شافه.",
   "en": "Someone saw him.",
   "p": 2
  },
  {
   "ar": "وقال: يا جحا.",
   "en": "And said: Juha.",
   "p": 2
  },
  {
   "ar": "ليش السلة على راسك؟",
   "en": "Why is the basket on your head?",
   "p": 2
  },
  {
   "ar": "حطها عالحمار.",
   "en": "Put it on the donkey.",
   "p": 2
  },
  {
   "ar": "جحا قال: لا.",
   "en": "Juha said: no.",
   "p": 2
  },
  {
   "ar": "قال الرجل: ليش؟",
   "en": "The man said: why?",
   "p": 2
  },
  {
   "ar": "قال جحا: الحمار مسكين.",
   "en": "Juha said: the poor donkey.",
   "p": 3
  },
  {
   "ar": "هو شايلني.",
   "en": "It is carrying me.",
   "p": 3
  },
  {
   "ar": "وأنا تقيل.",
   "en": "And I am heavy.",
   "p": 3
  },
  {
   "ar": "حرام أثقل عليه أكتر.",
   "en": "It would be cruel to load it more.",
   "p": 3
  },
  {
   "ar": "فالسلة بحملها أنا.",
   "en": "So I carry the basket myself.",
   "p": 3
  },
  {
   "ar": "والرجل سكت.",
   "en": "And the man was silent.",
   "p": 3
  },
  {
   "ar": "وراح يفكر.",
   "en": "And went off thinking.",
   "p": 3
  }
 ]
}