 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "على شط النهر، كان في سنديانة.",
   "en": "On the river bank, there was an oak.",
   "p": 0
  },
  {
   "ar": "سنديانة كبيرة وقوية.",
   "en": "A big, strong oak.",
   "p": 0
  },
  {
   "ar": "وجنبها قصبة.",
   "en": "And beside it, a reed.",
   "p": 0
  },
  {
   "ar": "قصبة رفيعة وطويلة.",
   "en": "A thin, tall reed.",
   "p": 0
  },
  {
   "ar": "كل يوم، الريح بتيجي.",
   "en": "Every day, the wind came.",
   "p": 0
  },
  {
   "ar": "والقصبة بتنحني.",
   "en": "And the reed bent.",
   "p": 0
  },
  {
   "ar": "والسنديانة ما بتتحرك.",
   "en": "And the oak did not move.",
   "p": 0
  },
  {
   "ar": "بيوم، السنديانة ضحكت.",
   "en": "One day, the oak laughed.",
   "p": 1
  },
  {
   "ar": "قالت: شوفي حالك!",
   "en": "It said: look at yourself!",
   "p": 1
  },
  {
   "ar": "كل ريح بتنحني لها.",
   "en": "You bow to every wind.",
   "p": 1
  },
  {
   "ar": "إنتِ ضعيفة.",
   "en": "You are weak.",
   "p": 1
  },
  {
   "ar": "أنا قوية.",
   "en": "I am strong.",
   "p": 1
  },
  {
   "ar": "أنا ما بنحني لحدا.",
   "en": "I bow to no one.",
   "p": 1
  },
  {
   "ar": "قالت القصبة: صحيح.",
   "en": "The reed said: true.",
   "p": 2
  },
  {
   "ar": "أنا بنحني.",
   "en": "I bend.",
   "p": 2
  },
  {
   "ar": "بس بعد الريح، بقوم.",
   "en": "But after the wind, I stand up.",
   "p": 2
  },
  {
   "ar": "قالت السنديانة: هاد ضعف.",
   "en": "The oak said: that is weakness.",
   "p": 2
  },
  {
   "ar": "قالت القصبة: يمكن.",
   "en": "The reed said: perhaps.",
   "p": 2
  },
  {
   "ar": "وسكتت.",
   "en": "And fell silent.",
   "p": 2
  },
  {
   "ar": "بالليل، إجت عاصفة.",
   "en": "At night, a storm came.",
   "p": 3
  },
  {
   "ar": "عاصفة كبيرة، ما شافوا زيها.",
   "en": "A big storm, like none they had seen.",
   "p": 3
  },
  {
   "ar": "القصبة انحنت لحد الأرض.",
   "en": "The reed bent to the ground.",
   "p": 3
  },
  {
   "ar": "والسنديانة وقفت.",
   "en": "And the oak stood.",
   "p": 3
  },
  {
   "ar": "وقفت، ووقفت.",
   "en": "It stood, and stood.",
   "p": 3
  },
  {
   "ar": "وبعدين، صار صوت كبير.",
   "en": "And then, there was a great sound.",
   "p": 3
  },
  {
   "ar": "السنديانة انكسرت.",
   "en": "The oak broke.",
   "p": 3
  },
  {
   "ar": "ووقعت بالنهر.",
   "en": "And fell into the river.",
   "p": 3
  },
  {
   "ar": "بالصبح، الريح راحت.",
   "en": "In the morning, the wind was gone.",
   "p": 4
  },
  {
   "ar": "القصبة قامت.",
   "en": "The reed stood up.",
   "p": 4
  },
  {
   "ar": "وتطلعت حواليها.",
   "en": "And looked around.",
   "p": 4
  },
  {
   "ar": "السنديانة مش موجودة.",
   "en": "The oak was not there.",
   "p": 4
  },
  {
   "ar": "اللي بينحني ما بينكسر.",
   "en": "What bends does not break.",
   "p": 4
  }
 ]
}