 "sentences": [
  {
   "ar": "كان الشتا.",
   "en": "It was winter.",
   "p": 0
  },
  {
   "ar": "وبرد كتير.",
   "en": "And very cold.",
   "p": 0
  },
  {
   "ar": "وجحا قاعد بالمقهى.",
   "en": "And Juha sat in the café.",
   "p": 0
  },
  {
   "ar": "وقال: البرد ما بيخوفني.",
   "en": "And said: the cold does not frighten me.",
   "p": 0
  },
  {
   "ar": "واحد سمعه.",
   "en": "Someone heard him.",
   "p": 0
  },
  {
   "ar": "وقال: براهنك.",
   "en": "And said: I bet you.",
   "p": 0
  },
  {
   "ar": "ليلة كاملة برا.",
   "en": "A whole night outside.",
   "p": 0
  },
  {
   "ar": "بلا نار.",
   "en": "Without a fire.",
   "p": 0
  },
  {
   "ar": "إذا قدرت، بعزمك على عشا.",
   "en": "If you can, I treat you to dinner.",
   "p": 0
  },
  {
   "ar": "قال جحا: قبلت.",
   "en": "Juha said: accepted.",
   "p": 0
  },
  {
   "ar": "وبالليل، جحا وقف برا.",
   "en": "And at night, Juha stood outside.",
   "p": 1
  },
  {
   "ar": "بالساحة.",
   "en": "In the square.",
   "p": 1
  },
  {
   "ar": "بلا نار.",
   "en": "Without a fire.",
   "p": 1
  },
  {
   "ar": "والبرد بيقطع.",
   "en": "And the cold was cutting.",
   "p": 1
  },
  {
   "ar": "ساعة، وساعتين.",
   "en": "An hour, two hours.",
   "p": 1
  },
  {
   "ar": "وطول الليل.",
   "en": "And all night.",
   "p": 1
  },
  {
   "ar": "وجحا واقف.",
   "en": "And Juha stood.",
   "p": 1
  },
  {
   "ar": "وبيرجف.",
   "en": "Shivering.",
   "p": 1
  },
  {
   "ar": "الصبح، إجا الرجل.",
   "en": "In the morning, the man came.",
   "p": 2
  },
  {
   "ar": "وقال: قضيت الليل؟",
   "en": "And said: you spent the night?",
   "p": 2
  },
  {
   "ar": "قال جحا: قضيته.",
   "en": "Juha said: I did.",
   "p": 2
  },
  {
   "ar": "قال الرجل: وما شفت نار؟",
   "en": "The man said: and you saw no fire?",
   "p": 2
  },
  {
   "ar": "قال جحا: نار لا.",
   "en": "Juha said: no fire.",
   "p": 2
  },
  {
   "ar": "بس شفت شمعة.",
   "en": "But I saw a candle.",
   "p": 2
  },
  {
   "ar": "بشباك بعيد.",
   "en": "In a far window.",
   "p": 2
  },
  {
   "ar": "قال الرجل: شمعة!",
   "en": "The man said: a candle!",
   "p": 2
  },
  {
   "ar": "يعني تدفيت فيها!",
   "en": "So you warmed yourself by it!",
   "p": 2
  },
  {
   "ar": "خسرت.",
   "en": "You lost.",
   "p": 2
  },
  {
   "ar": "ما بعزمك.",
   "en": "No dinner.",
   "p": 2
  },
  {
   "ar": "بعد يومين، جحا عزم الرجل.",
   "en": "Two days later, Juha invited the man.",
   "p": 3
  },
  {
   "ar": "على عشا.",
   "en": "To dinner.",
   "p": 3
  },
  {
   "ar": "والرجل إجا.",
   "en": "And the man came.",
   "p": 3
  },
  {
   "ar": "وقعد.",
   "en": "And sat.",
   "p": 3
  },
  {
   "ar": "واستنى.",
   "en": "And waited.",
   "p": 3
  },
  {
   "ar": "ساعة، وساعتين.",
   "en": "An hour, two hours.",
   "p": 3
  },
  {
   "ar": "والأكل ما إجا.",
   "en": "And the food did not come.",
   "p": 3
  },
  {
   "ar": "راح عالمطبخ.",
   "en": "He went to the kitchen.",
   "p": 3
  },
  {
   "ar": "ولقى طنجرة كبيرة.",
   "en": "And found a big pot.",
   "p": 3
  },
  {
   "ar": "معلقة فوق شمعة.",
   "en": "Hanging over a candle.",
   "p": 3
  },
  {
   "ar": "قال: شو هاد؟",
   "en": "He said: what is this?",
   "p": 3
  },
  {
   "ar": "قال جحا: الشمعة اللي بتدفي زلمة، بتطبخ أكل.",
   "en": "Juha said: a candle that warms a man can cook a dinner.",
   "p": 3
  }
 ]
