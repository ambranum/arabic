  "status": "public domain — ancient, anonymous"
 },
 "level": "beginner",
 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "الفيران ببيت كبير كانوا خايفين.",
   "en": "The mice in a big house were afraid.",
   "p": 0
  },
  {
   "ar": "من القطة.",
   "en": "Of the cat.",
   "p": 0
  },
  {
   "ar": "القطة بتيجي بلا صوت.",
   "en": "The cat comes without a sound.",
   "p": 0
  },
  {
   "ar": "وبتمسك واحد.",
   "en": "And catches one.",
   "p": 0
  },
  {
   "ar": "كل يوم.",
   "en": "Every day.",
   "p": 0
  },
  {
   "ar": "والفيران ما بيعرفوا إيمتى.",
   "en": "And the mice never know when.",
   "p": 0
  },
  {
   "ar": "فعملوا اجتماع.",
   "en": "So they held a meeting.",
   "p": 0
  },
  {
   "ar": "قال فار: لازم نعمل شي.",
   "en": "One mouse said: we must do something.",
   "p": 1
  },
  {
   "ar": "قال تاني: نهرب من البيت.",
   "en": "Another said: we leave the house.",
   "p": 1
  },
  {
   "ar": "قالوا: لا.",
   "en": "They said: no.",
   "p": 1
  },
  {
   "ar": "البيت فيه أكل.",
   "en": "The house has food.",
   "p": 1
  },
  {
   "ar": "قال تالت: نحارب القطة.",
   "en": "A third said: we fight the cat.",
   "p": 1
  },
  {
   "ar": "قالوا: لا.",
   "en": "They said: no.",
   "p": 1
  },
  {
   "ar": "القطة أقوى.",
   "en": "The cat is stronger.",
   "p": 1
  },
  {
   "ar": "وسكتوا.",
   "en": "And fell silent.",
   "p": 1
  },
  {
   "ar": "وقام فار زغير.",
   "en": "And a young mouse got up.",
   "p": 2
  },
  {
   "ar": "وقال: عندي فكرة.",
   "en": "And said: I have an idea.",
   "p": 2
  },
  {
   "ar": "المشكلة إنها بتيجي بلا صوت.",
   "en": "The problem is that she comes without a sound.",
   "p": 2
  },
  {
   "ar": "فبنحط على رقبتها جرس.",
   "en": "So we put a bell on her neck.",
   "p": 2
  },
  {
   "ar": "ولما تتحرك، الجرس بيرن.",
   "en": "And when she moves, the bell rings.",
   "p": 2
  },
  {
   "ar": "وبنسمعها، وبنهرب.",
   "en": "And we hear her, and run.",
   "p": 2
  },
  {
   "ar": "والفيران صفقوا.",
   "en": "And the mice clapped.",
   "p": 2
  },
  {
   "ar": "قالوا: فكرة عظيمة!",
   "en": "They said: a great idea!",
   "p": 2
  },
  {
   "ar": "وقام فار كبير بالعمر.",
   "en": "And an old mouse got up.",
   "p": 3
  },
  {
   "ar": "وقال: فكرة عظيمة.",
   "en": "And said: a great idea.",
   "p": 3
  },
  {
   "ar": "بس عندي سؤال.",
   "en": "But I have a question.",
   "p": 3
  },
  {
   "ar": "مين بده يحط الجرس؟",
   "en": "Who is going to put on the bell?",
   "p": 3
  },
  {
   "ar": "وصار صمت.",
   "en": "And there was silence.",
   "p": 3
  },
  {
   "ar": "وتطلع كل فار بالتاني.",
   "en": "And every mouse looked at the next.",
   "p": 3
  },
  {
   "ar": "وما حدا رد.",
   "en": "And no one answered.",
   "p": 3
  },
  {
   "ar": "الحكي سهل، والعمل صعب.",
   "en": "Talking is easy, and doing is hard.",
   "p": 3
  }
 ]
}