  {
   "ar": "واحد غريب وقف جحا.",
   "en": "A stranger stopped Juha.",
   "p": 0
  },
  {
   "ar": "بالطريق.",
   "en": "On the road.",
   "p": 0
  },
  {
   "ar": "وقال: يا عمي.",
   "en": "And said: uncle.",
   "p": 0
  },
  {
   "ar": "قديش بدي وقت؟",
   "en": "How long do I need?",
   "p": 0
  },
  {
   "ar": "عشان أوصل عالبلد.",
   "en": "To reach the town.",
   "p": 0
  },
  {
   "ar": "جحا تطلع فيه.",
   "en": "Juha looked at him.",
   "p": 0
  },
  {
   "ar": "وما رد.",
   "en": "And did not answer.",
   "p": 0
  },
  {
   "ar": "الرجل سأل كمان مرة.",
   "en": "The man asked again.",
   "p": 1
  },
  {
   "ar": "قديش بدي وقت؟",
   "en": "How long do I need?",
   "p": 1
  },
  {
   "ar": "وجحا ما رد.",
   "en": "And Juha did not answer.",
   "p": 1
  },
  {
   "ar": "الرجل زعل.",
   "en": "The man was annoyed.",
   "p": 1
  },
  {
   "ar": "وقال: أطرش.",
   "en": "And said: deaf.",
   "p": 1
  },
  {
   "ar": "ومشى.",
   "en": "And walked on.",
   "p": 1
  },
  {
   "ar": "مشى الرجل شوي.",
   "en": "The man walked a little.",
   "p": 2
  },
  {
   "ar": "عشر خطوات، عشرين.",
   "en": "Ten steps, twenty.",
   "p": 2
  },
  {
   "ar": "وجحا بيتفرج عليه.",
   "en": "And Juha watched him.",
   "p": 2
  },
  {
   "ar": "وبعدين صرخ: يا رجل!",
   "en": "And then shouted: hey, man!",
   "p": 2
  },
  {
   "ar": "بساعتين!",
   "en": "Two hours!",
   "p": 2
  },
  {
   "ar": "الرجل وقف.",
   "en": "The man stopped.",
   "p": 2
  },
  {
   "ar": "ولف.",
   "en": "And turned.",
   "p": 2
  },
  {
   "ar": "وقال: ساعتين؟",
   "en": "And said: two hours?",
   "p": 3
  },
  {
   "ar": "وليش ما حكيت من الأول؟",
   "en": "Why did you not say so at first?",
   "p": 3
  },
  {
   "ar": "قال جحا: كيف بحكي؟",
   "en": "Juha said: how could I?",
   "p": 3
  },
  {
   "ar": "لازم أشوف كيف بتمشي.",
   "en": "I had to see how you walk.",
   "p": 3
  },
  {
   "ar": "إنت بتمشي بطيء.",
   "en": "You walk slowly.",
   "p": 3
  },
  {
   "ar": "فساعتين.",
   "en": "So two hours.",
   "p": 3
  }
