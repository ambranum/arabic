  {
   "ar": "جحا صار كبير كتير.",
   "en": "Juha grew very old.",
   "p": 0
  },
  {
   "ar": "شعره أبيض.",
   "en": "His hair white.",
   "p": 0
  },
  {
   "ar": "وظهره منحني.",
   "en": "His back bent.",
   "p": 0
  },
  {
   "ar": "وعينه ضعيفة.",
   "en": "His eyes weak.",
   "p": 0
  },
  {
   "ar": "والناس بيحبوه.",
   "en": "And the people loved him.",
   "p": 0
  },
  {
   "ar": "وبيوم، اجتمعوا حواليه.",
   "en": "And one day, they gathered around him.",
   "p": 0
  },
  {
   "ar": "وقالوا: يا جحا.",
   "en": "And said: Juha.",
   "p": 1
  },
  {
   "ar": "عشت عمر طويل.",
   "en": "You have lived a long life.",
   "p": 1
  },
  {
   "ar": "وشفت كتير.",
   "en": "And seen a lot.",
   "p": 1
  },
  {
   "ar": "وضحكت كتير.",
   "en": "And laughed a lot.",
   "p": 1
  },
  {
   "ar": "قول لنا.",
   "en": "Tell us.",
   "p": 1
  },
  {
   "ar": "شو تعلمت؟",
   "en": "What have you learned?",
   "p": 1
  },
  {
   "ar": "جحا فكر.",
   "en": "Juha thought.",
   "p": 2
  },
  {
   "ar": "وشرب قهوته.",
   "en": "And drank his coffee.",
   "p": 2
  },
  {
   "ar": "وقال: تعلمت تلات أشيا.",
   "en": "And said: I have learned three things.",
   "p": 2
  },
  {
   "ar": "الأول: أنا ما بعرف كتير.",
   "en": "The first: I do not know much.",
   "p": 2
  },
  {
   "ar": "وكل ما بكبر، بعرف أقل.",
   "en": "And the older I get, the less I know.",
   "p": 2
  },
  {
   "ar": "والناس ضحكوا.",
   "en": "And the people laughed.",
   "p": 2
  },
  {
   "ar": "قال جحا: التاني.",
   "en": "Juha said: the second.",
   "p": 3
  },
  {
   "ar": "اللي بيضحك، بيعيش أطول.",
   "en": "Whoever laughs lives longer.",
   "p": 3
  },
  {
   "ar": "واللي بيزعل، بيموت مرتين.",
   "en": "And whoever frets dies twice.",
   "p": 3
  },
  {
   "ar": "والناس ضحكوا.",
   "en": "And the people laughed.",
   "p": 3
  },
  {
   "ar": "قال جحا: والتالت.",
   "en": "Juha said: and the third.",
   "p": 3
  },
  {
   "ar": "الحمار بيفهم أكتر من صاحبه.",
   "en": "The donkey understands more than its master.",
   "p": 3
  },
  {
   "ar": "بس بيسكت.",
   "en": "But keeps quiet.",
   "p": 3
  },
  {
   "ar": "والناس ضحكوا كتير.",
   "en": "And the people laughed a lot.",
   "p": 3
  },
  {
   "ar": "وجحا ضحك معهم.",
   "en": "And Juha laughed with them.",
   "p": 3
  },
  {
   "ar": "وكل واحد فيهم كان شوي على حق.",
   "en": "And every one of them was a little right.",
   "p": 3
  }
 ]
