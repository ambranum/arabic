 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "بنت فلاحة حلبت البقرة.",
   "en": "A farmer's daughter milked the cow.",
   "p": 0
  },
  {
   "ar": "وعبت سطل حليب.",
   "en": "And filled a pail with milk.",
   "p": 0
  },
  {
   "ar": "سطل كبير.",
   "en": "A big pail.",
   "p": 0
  },
  {
   "ar": "وحطته على راسها.",
   "en": "And put it on her head.",
   "p": 0
  },
  {
   "ar": "ومشيت عالسوق.",
   "en": "And walked to the market.",
   "p": 0
  },
  {
   "ar": "عشان تبيعه.",
   "en": "To sell it.",
   "p": 0
  },
  {
   "ar": "وبالطريق، صارت تفكر.",
   "en": "And on the way, she began to think.",
   "p": 0
  },
  {
   "ar": "قالت: ببيع الحليب.",
   "en": "She said: I sell the milk.",
   "p": 1
  },
  {
   "ar": "وبالمصاري، بشتري بيض.",
   "en": "And with the money, I buy eggs.",
   "p": 1
  },
  {
   "ar": "ومن البيض، بيطلع صيصان.",
   "en": "And from the eggs, chicks hatch.",
   "p": 1
  },
  {
   "ar": "والصيصان بتكبر.",
   "en": "And the chicks grow.",
   "p": 1
  },
  {
   "ar": "وبتصير دجاج.",
   "en": "And become hens.",
   "p": 1
  },
  {
   "ar": "وببيع الدجاج.",
   "en": "And I sell the hens.",
   "p": 1
  },
  {
   "ar": "وبشتري فستان.",
   "en": "And buy a dress.",
   "p": 1
  },
  {
   "ar": "فستان أحمر.",
   "en": "A red dress.",
   "p": 2
  },
  {
   "ar": "وبلبسه للعرس.",
   "en": "And wear it to the wedding.",
   "p": 2
  },
  {
   "ar": "وكل الشباب بيتطلعوا فيّ.",
   "en": "And all the young men look at me.",
   "p": 2
  },
  {
   "ar": "وواحد بيجي يحكي معي.",
   "en": "And one comes to talk to me.",
   "p": 2
  },
  {
   "ar": "وأنا ما برد عليه.",
   "en": "And I do not answer him.",
   "p": 2
  },
  {
   "ar": "بهز راسي هيك.",
   "en": "I toss my head like this.",
   "p": 2
  },
  {
   "ar": "وهزت راسها.",
   "en": "And she tossed her head.",
   "p": 2
  },
  {
   "ar": "والسطل وقع.",
   "en": "And the pail fell.",
   "p": 3
  },
  {
   "ar": "والحليب انكب عالأرض.",
   "en": "And the milk spilled on the ground.",
   "p": 3
  },
  {
   "ar": "كله.",
   "en": "All of it.",
   "p": 3
  },
  {
   "ar": "والبنت وقفت.",
   "en": "And the girl stood.",
   "p": 3
  },
  {
   "ar": "وتطلعت بالحليب.",
   "en": "And looked at the milk.",
   "p": 3
  },
  {
   "ar": "ولا بيض، ولا دجاج.",
   "en": "No eggs, no hens.",
   "p": 3
  },
  {
   "ar": "ولا فستان، ولا عرس.",
   "en": "No dress, no wedding.",
   "p": 3
  },
  {
   "ar": "ما تعد الصيصان قبل ما تفقس.",
   "en": "Do not count the chicks before they hatch.",
   "p": 3
  }
 ]
}