 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "رجل رجع من سفر طويل.",
   "en": "A man came back from a long journey.",
   "p": 0
  },
  {
   "ar": "وقعد بالمقهى.",
   "en": "And sat in the café.",
   "p": 0
  },
  {
   "ar": "وصار يحكي.",
   "en": "And began to talk.",
   "p": 0
  },
  {
   "ar": "يحكي عن البلاد اللي شافها.",
   "en": "To talk of the countries he had seen.",
   "p": 0
  },
  {
   "ar": "وعن الأشياء اللي عملها.",
   "en": "And the things he had done.",
   "p": 0
  },
  {
   "ar": "وكل قصة أكبر من اللي قبلها.",
   "en": "And every story bigger than the one before.",
   "p": 0
  },
  {
   "ar": "قال: بمصر، سبحت النيل كله.",
   "en": "He said: in Egypt, I swam the whole Nile.",
   "p": 1
  },
  {
   "ar": "وبالهند، صارعت نمر.",
   "en": "And in India, I wrestled a tiger.",
   "p": 1
  },
  {
   "ar": "وبجزيرة رودس، نطيت نطة.",
   "en": "And on the island of Rhodes, I made a jump.",
   "p": 1
  },
  {
   "ar": "أطول نطة بالتاريخ.",
   "en": "The longest jump in history.",
   "p": 1
  },
  {
   "ar": "عشرة أمتار!",
   "en": "Ten metres!",
   "p": 1
  },
  {
   "ar": "والناس كلها شافتني.",
   "en": "And everyone saw me.",
   "p": 1
  },
  {
   "ar": "وصفقوا.",
   "en": "And clapped.",
   "p": 1
  },
  {
   "ar": "الناس بالمقهى سكتوا.",
   "en": "The people in the café were silent.",
   "p": 2
  },
  {
   "ar": "واحد قال: عشرة أمتار؟",
   "en": "One said: ten metres?",
   "p": 2
  },
  {
   "ar": "قال المسافر: عشرة.",
   "en": "The traveller said: ten.",
   "p": 2
  },
  {
   "ar": "ولو كنتوا برودس، كنتوا شفتوا.",
   "en": "And had you been in Rhodes, you would have seen.",
   "p": 2
  },
  {
   "ar": "في شهود هناك.",
   "en": "There are witnesses there.",
   "p": 2
  },
  {
   "ar": "كتار.",
   "en": "Many.",
   "p": 2
  },
  {
   "ar": "وقام رجل عجوز من الزاوية.",
   "en": "And an old man got up from the corner.",
   "p": 3
  },
  {
   "ar": "وقال: ليش رودس؟",
   "en": "And said: why Rhodes?",
   "p": 3
  },
  {
   "ar": "هون كمان في أرض.",
   "en": "There is ground here too.",
   "p": 3
  },
  {
   "ar": "ورسم خط بعصايته عالأرض.",
   "en": "And he drew a line on the ground with his stick.",
   "p": 3
  },
  {
   "ar": "وقال: هاي رودس.",
   "en": "And said: this is Rhodes.",
   "p": 3
  },
  {
   "ar": "نط.",
   "en": "Jump.",
   "p": 3
  },
  {
   "ar": "والمسافر سكت.",
   "en": "And the traveller was silent.",
   "p": 3
  },
  {
   "ar": "وما نط.",
   "en": "And did not jump.",
   "p": 3
  },
  {
   "ar": "الفعل بيبين، والحكي بيطير.",
   "en": "Deeds show, and talk flies away.",
   "p": 3
  }
 ]
}