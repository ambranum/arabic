  {
   "ar": "بالصيف، النملة شغلت كتير.",
   "en": "In the summer, the ant worked hard.",
   "p": 0
  },
  {
   "ar": "كانت تجمع حب وتخزنه.",
   "en": "She used to gather grain and store it.",
   "p": 0
  },
  {
   "ar": "الصرصور كان يغني ويلعب.",
   "en": "The grasshopper used to sing and play.",
   "p": 1
  },
  {
   "ar": "قال لها: ليش تتعبي؟",
   "en": "He said to her: why tire yourself?",
   "p": 1
  },
  {
   "ar": "إجا الشتا والبرد.",
   "en": "The winter and the cold came.",
   "p": 2
  },
  {
   "ar": "الصرصور جاع ودق عالباب.",
   "en": "The grasshopper got hungry and knocked on the door.",
   "p": 2
  },
  {
   "ar": "وقت الشغل مش وقت الغنا.",
   "en": "The time for work is not the time for singing.",
   "p": 2
  }
