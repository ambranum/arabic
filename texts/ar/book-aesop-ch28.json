 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "بالصيف، النملة كانت تشتغل.",
   "en": "In summer, the ant was working.",
   "p": 0
  },
  {
   "ar": "كل يوم.",
   "en": "Every day.",
   "p": 0
  },
  {
   "ar": "تحمل حبة قمح.",
   "en": "Carrying a grain of wheat.",
   "p": 0
  },
  {
   "ar": "وتحطها ببيتها.",
   "en": "And putting it in her house.",
   "p": 0
  },
  {
   "ar": "وترجع تجيب وحدة تانية.",
   "en": "And going back for another.",
   "p": 0
  },
  {
   "ar": "من الصبح للمسا.",
   "en": "From morning to evening.",
   "p": 0
  },
  {
   "ar": "والشمس حامية.",
   "en": "And the sun hot.",
   "p": 0
  },
  {
   "ar": "والصرصور كان يغني.",
   "en": "And the grasshopper was singing.",
   "p": 1
  },
  {
   "ar": "على ورقة، بالظل.",
   "en": "On a leaf, in the shade.",
   "p": 1
  },
  {
   "ar": "وشاف النملة.",
   "en": "And he saw the ant.",
   "p": 1
  },
  {
   "ar": "وقال: يا نملة!",
   "en": "And said: ant!",
   "p": 1
  },
  {
   "ar": "ليش بتشتغلي؟",
   "en": "Why are you working?",
   "p": 1
  },
  {
   "ar": "الصيف حلو.",
   "en": "Summer is lovely.",
   "p": 1
  },
  {
   "ar": "تعالي غني معي.",
   "en": "Come and sing with me.",
   "p": 1
  },
  {
   "ar": "قالت النملة: الشتا جاي.",
   "en": "The ant said: winter is coming.",
   "p": 2
  },
  {
   "ar": "وبالشتا، ما في أكل.",
   "en": "And in winter, there is no food.",
   "p": 2
  },
  {
   "ar": "أنا بجمع للشتا.",
   "en": "I am gathering for winter.",
   "p": 2
  },
  {
   "ar": "قال الصرصور: الشتا بعيد.",
   "en": "The grasshopper said: winter is far off.",
   "p": 2
  },
  {
   "ar": "وضحك.",
   "en": "And laughed.",
   "p": 2
  },
  {
   "ar": "وغنى.",
   "en": "And sang.",
   "p": 2
  },
  {
   "ar": "وكمل الصيف كله يغني.",
   "en": "And spent the whole summer singing.",
   "p": 2
  },
  {
   "ar": "وإجا الشتا.",
   "en": "And winter came.",
   "p": 3
  },
  {
   "ar": "والتلج غطى الأرض.",
   "en": "And snow covered the ground.",
   "p": 3
  },
  {
   "ar": "وما في ورق، ولا حب.",
   "en": "And no leaves, no grain.",
   "p": 3
  },
  {
   "ar": "والصرصور جعان.",
   "en": "And the grasshopper was hungry.",
   "p": 3
  },
  {
   "ar": "وبردان.",
   "en": "And cold.",
   "p": 3
  },
  {
   "ar": "وراح لبيت النملة.",
   "en": "And went to the ant's house.",
   "p": 3
  },
  {
   "ar": "ودق الباب.",
   "en": "And knocked.",
   "p": 3
  },
  {
   "ar": "وقال: أعطيني أكل.",
   "en": "And said: give me food.",
   "p": 3
  },
  {
   "ar": "قالت النملة: بالصيف، شو كنت تعمل؟",
   "en": "The ant said: in summer, what were you doing?",
   "p": 3
  },
  {
   "ar": "قال: كنت أغني.",
   "en": "He said: I was singing.",
   "p": 3
  },
  {
   "ar": "قالت: طيب.",
   "en": "She said: fine.",
   "p": 3
  },
  {
   "ar": "هلق ارقص.",
   "en": "Now dance.",
   "p": 3
  },
  {
   "ar": "اللي بيشتغل بالصيف، بياكل بالشتا.",
   "en": "Whoever works in summer eats in winter.",
   "p": 3
  }
 ]
}