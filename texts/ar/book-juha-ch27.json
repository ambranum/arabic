  {
   "ar": "جحا مشى بالليل.",
   "en": "Juha was walking at night.",
   "p": 0
  },
  {
   "ar": "برا القرية.",
   "en": "Outside the village.",
   "p": 0
  },
  {
   "ar": "والطريق فاضية.",
   "en": "And the road was empty.",
   "p": 0
  },
  {
   "ar": "وسمع أصوات.",
   "en": "And he heard voices.",
   "p": 0
  },
  {
   "ar": "ناس جايين.",
   "en": "People coming.",
   "p": 0
  },
  {
   "ar": "وخاف.",
   "en": "And he was afraid.",
   "p": 0
  },
  {
   "ar": "قال: يمكن حرامية.",
   "en": "He said: maybe thieves.",
   "p": 0
  },
  {
   "ar": "وشاف حفرة.",
   "en": "And he saw a hole.",
   "p": 1
  },
  {
   "ar": "حفرة عالطريق.",
   "en": "A hole by the road.",
   "p": 1
  },
  {
   "ar": "زي القبر.",
   "en": "Like a grave.",
   "p": 1
  },
  {
   "ar": "ونزل فيها.",
   "en": "And he got into it.",
   "p": 1
  },
  {
   "ar": "وتمدد.",
   "en": "And lay down.",
   "p": 1
  },
  {
   "ar": "وسكر عينه.",
   "en": "And closed his eyes.",
   "p": 1
  },
  {
   "ar": "وما تحرك.",
   "en": "And did not move.",
   "p": 1
  },
  {
   "ar": "الناس وصلوا.",
   "en": "The people arrived.",
   "p": 2
  },
  {
   "ar": "وشافوا الحفرة.",
   "en": "And saw the hole.",
   "p": 2
  },
  {
   "ar": "وشافوا جحا.",
   "en": "And saw Juha.",
   "p": 2
  },
  {
   "ar": "وقالوا: مين هاد؟",
   "en": "And said: who is this?",
   "p": 2
  },
  {
   "ar": "وشو بيعمل هون؟",
   "en": "And what is he doing here?",
   "p": 2
  },
  {
   "ar": "جحا فتح عين وحدة.",
   "en": "Juha opened one eye.",
   "p": 2
  },
  {
   "ar": "وقال: أنا ميت.",
   "en": "And said: I am dead.",
   "p": 2
  },
  {
   "ar": "الناس ضحكوا.",
   "en": "The people laughed.",
   "p": 3
  },
  {
   "ar": "قالوا: ميت؟",
   "en": "They said: dead?",
   "p": 3
  },
  {
   "ar": "والميت بيحكي؟",
   "en": "And does a dead man talk?",
   "p": 3
  },
  {
   "ar": "قال جحا: بيحكي.",
   "en": "Juha said: he talks.",
   "p": 3
  },
  {
   "ar": "قالوا: إمتى؟",
   "en": "They said: when?",
   "p": 3
  },
  {
   "ar": "قال جحا: إذا كان جعان.",
   "en": "Juha said: if he is hungry.",
   "p": 3
  },
  {
   "ar": "والناس ضحكوا أكتر.",
   "en": "And the people laughed more.",
   "p": 3
  },
  {
   "ar": "وأعطوه خبز.",
   "en": "And gave him bread.",
   "p": 3
