 "sentences": [
  {
   "ar": "ولد كان راعي.",
   "en": "A boy was a shepherd.",
   "p": 0
  },
  {
   "ar": "كل يوم بياخد الغنم عالجبل.",
   "en": "Every day he took the sheep up the hill.",
   "p": 0
  },
  {
   "ar": "وبيقعد لحاله.",
   "en": "And sat alone.",
   "p": 0
  },
  {
   "ar": "من الصبح للمسا.",
   "en": "From morning to evening.",
   "p": 0
  },
  {
   "ar": "وكان زهقان.",
   "en": "And he was bored.",
   "p": 0
  },
  {
   "ar": "كتير.",
   "en": "Very.",
   "p": 0
  },
  {
   "ar": "وبيوم، إجت له فكرة.",
   "en": "And one day, an idea came to him.",
   "p": 0
  },
  {
   "ar": "صرخ: ذيب!",
   "en": "He shouted: wolf!",
   "p": 1
  },
  {
   "ar": "ذيب!",
   "en": "Wolf!",
   "p": 1
  },
  {
   "ar": "الناس بالقرية سمعوا.",
   "en": "The people in the village heard.",
   "p": 1
  },
  {
   "ar": "وركضوا عالجبل.",
   "en": "And ran up the hill.",
   "p": 1
  },
  {
   "ar": "بالعصي والفؤوس.",
   "en": "With sticks and axes.",
   "p": 1
  },
  {
   "ar": "ووصلوا.",
   "en": "And arrived.",
   "p": 1
  },
  {
   "ar": "وما في ذيب.",
   "en": "And there was no wolf.",
   "p": 1
  },
  {
   "ar": "والولد بيضحك.",
   "en": "And the boy was laughing.",
   "p": 1
  },
  {
   "ar": "والناس زعلوا، ورجعوا.",
   "en": "And the people were angry, and went back.",
   "p": 1
  },
  {
   "ar": "بعد أسبوع، زهق كمان.",
   "en": "A week later, he was bored again.",
   "p": 2
  },
  {
   "ar": "وصرخ: ذيب!",
   "en": "And shouted: wolf!",
   "p": 2
  },
  {
   "ar": "ذيب!",
   "en": "Wolf!",
   "p": 2
  },
  {
   "ar": "والناس ركضوا.",
   "en": "And the people ran.",
   "p": 2
  },
  {
   "ar": "وما في ذيب.",
   "en": "And there was no wolf.",
   "p": 2
  },
  {
   "ar": "والولد بيضحك.",
   "en": "And the boy was laughing.",
   "p": 2
  },
  {
   "ar": "وقالوا: هالولد كذاب.",
   "en": "And they said: this boy is a liar.",
   "p": 2
  },
  {
   "ar": "ما منسمع له بعد اليوم.",
   "en": "We will not listen to him again.",
   "p": 2
  },
  {
   "ar": "وبعد أسبوع، إجا ذيب.",
   "en": "And a week later, a wolf came.",
   "p": 3
  },
  {
   "ar": "ذيب حقيقي.",
   "en": "A real wolf.",
   "p": 3
  },
  {
   "ar": "ودخل بين الغنم.",
   "en": "And went in among the sheep.",
   "p": 3
  },
  {
   "ar": "والولد صرخ: ذيب!",
   "en": "And the boy shouted: wolf!",
   "p": 3
  },
  {
   "ar": "ذيب!",
   "en": "Wolf!",
   "p": 3
  },
  {
   "ar": "صرخ بكل صوته.",
   "en": "He shouted with all his voice.",
   "p": 3
  },
  {
   "ar": "والناس سمعوا.",
   "en": "And the people heard.",
   "p": 3
  },
  {
   "ar": "وقالوا: بيكذب كمان.",
   "en": "And said: he is lying again.",
   "p": 3
  },
  {
   "ar": "وما حدا طلع.",
   "en": "And no one went up.",
   "p": 3
  },
  {
   "ar": "والذيب أكل الغنم.",
   "en": "And the wolf ate the sheep.",
   "p": 3
  },
  {
   "ar": "الكذاب ما حدا بيصدقه، حتى لما يصدق.",
   "en": "No one believes a liar, even when he tells the truth.",
   "p": 3
  }
 ]
}