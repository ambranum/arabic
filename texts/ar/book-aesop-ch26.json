  {
   "ar": "ولد كان يرعى غنم عالجبل.",
   "en": "A boy used to herd sheep on the hill.",
   "p": 0
  },
  {
   "ar": "زهق وصار يصرخ: ذيب! ذيب!",
   "en": "He got bored and started shouting: wolf! wolf!",
   "p": 0
  },
  {
   "ar": "الناس ركضوا وما لقوا إشي.",
   "en": "People ran and found nothing.",
   "p": 1
  },
  {
   "ar": "عمل هيك مرتين وضحك.",
   "en": "He did this twice and laughed.",
   "p": 1
  },
  {
   "ar": "بيوم، إجا ذيب حقيقي.",
   "en": "One day, a real wolf came.",
   "p": 2
  },
  {
   "ar": "صرخ الولد وما حدا إجا.",
   "en": "The boy shouted and nobody came.",
   "p": 2
  },
  {
   "ar": "الكذاب محدا بيصدقه بالآخر.",
   "en": "In the end nobody believes a liar.",
   "p": 2
  }
