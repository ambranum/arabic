 "sentences": [
  {
   "ar": "الناس بالمقهى تخانقوا.",
   "en": "The people in the café were arguing.",
   "p": 0
  },
  {
   "ar": "على سؤال.",
   "en": "Over a question.",
   "p": 0
  },
  {
   "ar": "الشمس أهم، ولا القمر؟",
   "en": "Is the sun more important, or the moon?",
   "p": 0
  },
  {
   "ar": "نص قالوا الشمس.",
   "en": "Half said the sun.",
   "p": 0
  },
  {
   "ar": "ونص قالوا القمر.",
   "en": "And half said the moon.",
   "p": 0
  },
  {
   "ar": "وقالوا: نسأل جحا.",
   "en": "And they said: let us ask Juha.",
   "p": 0
  },
  {
   "ar": "جحا إجا.",
   "en": "Juha came.",
   "p": 1
  },
  {
   "ar": "وسمع السؤال.",
   "en": "And heard the question.",
   "p": 1
  },
  {
   "ar": "وفكر.",
   "en": "And thought.",
   "p": 1
  },
  {
   "ar": "وشرب قهوته.",
   "en": "And drank his coffee.",
   "p": 1
  },
  {
   "ar": "وفكر كمان.",
   "en": "And thought some more.",
   "p": 1
  },
  {
   "ar": "وقال: القمر.",
   "en": "And said: the moon.",
   "p": 1
  },
  {
   "ar": "نص الناس فرحوا.",
   "en": "Half the people cheered.",
   "p": 2
  },
  {
   "ar": "ونص زعلوا.",
   "en": "And half were upset.",
   "p": 2
  },
  {
   "ar": "قالوا: ليش القمر؟",
   "en": "They said: why the moon?",
   "p": 2
  },
  {
   "ar": "الشمس أكبر!",
   "en": "The sun is bigger!",
   "p": 2
  },
  {
   "ar": "والشمس بتدفي!",
   "en": "And the sun warms!",
   "p": 2
  },
  {
   "ar": "قال جحا: صحيح.",
   "en": "Juha said: true.",
   "p": 2
  },
  {
   "ar": "بس اسمعوا.",
   "en": "But listen.",
   "p": 2
  },
  {
   "ar": "قال جحا: القمر بيطلع بالليل.",
   "en": "Juha said: the moon comes out at night.",
   "p": 3
  },
  {
   "ar": "وبالليل، الدنيا عتمة.",
   "en": "And at night, the world is dark.",
   "p": 3
  },
  {
   "ar": "وإحنا محتاجين ضوء.",
   "en": "And we need light.",
   "p": 3
  },
  {
   "ar": "والشمس بتطلع بالنهار.",
   "en": "And the sun comes out by day.",
   "p": 3
  },
  {
   "ar": "وبالنهار، الدنيا ضوء.",
   "en": "And by day, the world is light.",
   "p": 3
  },
  {
   "ar": "فشو لزومها؟",
   "en": "So what is it for?",
   "p": 3
  },
  {
   "ar": "والناس سكتوا.",
   "en": "And the people fell silent.",
   "p": 3
  }
 ]
