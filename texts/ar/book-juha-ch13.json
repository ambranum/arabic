 "sentences": [
  {
   "ar": "واحد إجا لجحا.",
   "en": "A man came to Juha.",
   "p": 0
  },
  {
   "ar": "وقال: إنت رجل عالم.",
   "en": "And said: you are a learned man.",
   "p": 0
  },
  {
   "ar": "عندي سؤال.",
   "en": "I have a question.",
   "p": 0
  },
  {
   "ar": "قال جحا: اسأل.",
   "en": "Juha said: ask.",
   "p": 0
  },
  {
   "ar": "قال الرجل: الدنيا نصها ليل.",
   "en": "The man said: the world is half night.",
   "p": 0
  },
  {
   "ar": "ونصها نهار.",
   "en": "And half day.",
   "p": 0
  },
  {
   "ar": "ليش؟",
   "en": "Why?",
   "p": 0
  },
  {
   "ar": "جحا فكر.",
   "en": "Juha thought.",
   "p": 1
  },
  {
   "ar": "وفكر.",
   "en": "And thought.",
   "p": 1
  },
  {
   "ar": "وحك راسه.",
   "en": "And scratched his head.",
   "p": 1
  },
  {
   "ar": "وقال: ما بعرف.",
   "en": "And said: I do not know.",
   "p": 1
  },
  {
   "ar": "الرجل زعل.",
   "en": "The man was upset.",
   "p": 1
  },
  {
   "ar": "قال: ما بتعرف؟",
   "en": "He said: you do not know?",
   "p": 1
  },
  {
   "ar": "إنت عالم!",
   "en": "You are a scholar!",
   "p": 1
  },
  {
   "ar": "العالم لازم يعرف كل شي!",
   "en": "A scholar must know everything!",
   "p": 1
  },
  {
   "ar": "قال جحا: لا.",
   "en": "Juha said: no.",
   "p": 2
  },
  {
   "ar": "العالم ما بيعرف كل شي.",
   "en": "A scholar does not know everything.",
   "p": 2
  },
  {
   "ar": "قال الرجل: وشو بيعرف؟",
   "en": "The man said: then what does he know?",
   "p": 2
  },
  {
   "ar": "قال جحا: بيعرف شي واحد.",
   "en": "Juha said: he knows one thing.",
   "p": 2
  },
  {
   "ar": "قال الرجل: شو؟",
   "en": "The man said: what?",
   "p": 2
  },
  {
   "ar": "قال جحا: بيعرف إمتى يقول: ما بعرف.",
   "en": "Juha said: he knows when to say: I do not know.",
   "p": 2
  }
 ]
