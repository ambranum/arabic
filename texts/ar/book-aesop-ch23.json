 "sentences": [
  {
   "ar": "غراب لقى قطعة جبنة.",
   "en": "A crow found a piece of cheese.",
   "p": 0
  },
  {
   "ar": "جبنة كبيرة، وطيبة.",
   "en": "A big, good piece of cheese.",
   "p": 0
  },
  {
   "ar": "أخدها بمنقاره.",
   "en": "He took it in his beak.",
   "p": 0
  },
  {
   "ar": "وطار على شجرة.",
   "en": "And flew up into a tree.",
   "p": 0
  },
  {
   "ar": "ووقف على غصن عالي.",
   "en": "And sat on a high branch.",
   "p": 0
  },
  {
   "ar": "عشان ياكلها بهدوء.",
   "en": "To eat it in peace.",
   "p": 0
  },
  {
   "ar": "وتحت الشجرة، مر ثعلب.",
   "en": "And beneath the tree, a fox passed.",
   "p": 0
  },
  {
   "ar": "الثعلب شم الجبنة.",
   "en": "The fox smelled the cheese.",
   "p": 1
  },
  {
   "ar": "وتطلع لفوق.",
   "en": "And looked up.",
   "p": 1
  },
  {
   "ar": "وشاف الغراب.",
   "en": "And saw the crow.",
   "p": 1
  },
  {
   "ar": "وفكر.",
   "en": "And thought.",
   "p": 1
  },
  {
   "ar": "وقال بصوت حلو: يا غراب!",
   "en": "And said in a sweet voice: crow!",
   "p": 1
  },
  {
   "ar": "شو أحلى ريشك!",
   "en": "How beautiful your feathers are!",
   "p": 1
  },
  {
   "ar": "أسود، وبيلمع.",
   "en": "Black, and shining.",
   "p": 1
  },
  {
   "ar": "إنت أحلى طير بالغابة.",
   "en": "You are the loveliest bird in the forest.",
   "p": 1
  },
  {
   "ar": "الغراب سمع.",
   "en": "The crow listened.",
   "p": 2
  },
  {
   "ar": "وفرح.",
   "en": "And was pleased.",
   "p": 2
  },
  {
   "ar": "وقال الثعلب: بس في شي واحد.",
   "en": "And the fox said: but there is one thing.",
   "p": 2
  },
  {
   "ar": "بيقولوا إنه صوتك مش حلو.",
   "en": "They say your voice is not beautiful.",
   "p": 2
  },
  {
   "ar": "أنا ما بصدق.",
   "en": "I do not believe it.",
   "p": 2
  },
  {
   "ar": "غني لي شوي.",
   "en": "Sing for me a little.",
   "p": 2
  },
  {
   "ar": "وبعرف إذا صحيح.",
   "en": "And I will know if it is true.",
   "p": 2
  },
  {
   "ar": "الغراب فتح منقاره.",
   "en": "The crow opened his beak.",
   "p": 3
  },
  {
   "ar": "وقال: كااااع!",
   "en": "And said: caaaw!",
   "p": 3
  },
  {
   "ar": "والجبنة وقعت.",
   "en": "And the cheese fell.",
   "p": 3
  },
  {
   "ar": "والثعلب مسكها.",
   "en": "And the fox caught it.",
   "p": 3
  },
  {
   "ar": "وقال: صوتك حلو.",
   "en": "And said: your voice is lovely.",
   "p": 3
  },
  {
   "ar": "بس عقلك زغير.",
   "en": "But your brain is small.",
   "p": 3
  },
  {
   "ar": "ومشى بالجبنة.",
   "en": "And walked off with the cheese.",
   "p": 3
  },
  {
   "ar": "اللي بيمدحك كتير، بده شي.",
   "en": "Whoever praises you too much wants something.",
   "p": 3
  }
 ]
}