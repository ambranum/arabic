 "sentences": [
  {
   "ar": "الذيب أكل بسرعة.",
   "en": "The wolf ate fast.",
   "p": 0
  },
  {
   "ar": "أكل زي دايماً.",
   "en": "He ate as he always does.",
   "p": 0
  },
  {
   "ar": "وعظمة علقت بحلقه.",
   "en": "And a bone stuck in his throat.",
   "p": 0
  },
  {
   "ar": "ما قدر يبلع.",
   "en": "He could not swallow.",
   "p": 0
  },
  {
   "ar": "ما قدر يحكي منيح.",
   "en": "He could not speak well.",
   "p": 0
  },
  {
   "ar": "وخاف.",
   "en": "And he was afraid.",
   "p": 0
  },
  {
   "ar": "وراح يدور على مساعدة.",
   "en": "And went looking for help.",
   "p": 0
  },
  {
   "ar": "كل الحيوانات خافت منه.",
   "en": "All the animals were afraid of him.",
   "p": 1
  },
  {
   "ar": "ما حدا قرب.",
   "en": "No one came near.",
   "p": 1
  },
  {
   "ar": "إلا الكركي.",
   "en": "Except the crane.",
   "p": 1
  },
  {
   "ar": "قال الذيب: يا كركي، منقارك طويل.",
   "en": "The wolf said: crane, your beak is long.",
   "p": 1
  },
  {
   "ar": "طلع العظمة من حلقي.",
   "en": "Take the bone out of my throat.",
   "p": 1
  },
  {
   "ar": "وبعطيك هدية كبيرة.",
   "en": "And I give you a big gift.",
   "p": 1
  },
  {
   "ar": "الكركي خاف.",
   "en": "The crane was afraid.",
   "p": 2
  },
  {
   "ar": "بس الهدية كبيرة.",
   "en": "But the gift was big.",
   "p": 2
  },
  {
   "ar": "وحط راسه بتم الذيب.",
   "en": "And he put his head in the wolf's mouth.",
   "p": 2
  },
  {
   "ar": "راسه كله.",
   "en": "His whole head.",
   "p": 2
  },
  {
   "ar": "ومسك العظمة بمنقاره.",
   "en": "And gripped the bone in his beak.",
   "p": 2
  },
  {
   "ar": "وسحبها.",
   "en": "And pulled it out.",
   "p": 2
  },
  {
   "ar": "والذيب تنفس.",
   "en": "And the wolf breathed.",
   "p": 2
  },
  {
   "ar": "قال الكركي: خلص.",
   "en": "The crane said: done.",
   "p": 3
  },
  {
   "ar": "وهلق الهدية.",
   "en": "And now the gift.",
   "p": 3
  },
  {
   "ar": "الذيب ضحك.",
   "en": "The wolf laughed.",
   "p": 3
  },
  {
   "ar": "قال: هدية؟",
   "en": "He said: gift?",
   "p": 3
  },
  {
   "ar": "راسك كان بتمي.",
   "en": "Your head was in my mouth.",
   "p": 3
  },
  {
   "ar": "وطلع سليم.",
   "en": "And it came out whole.",
   "p": 3
  },
  {
   "ar": "هاي الهدية.",
   "en": "That is the gift.",
   "p": 3
  },
  {
   "ar": "ومشى.",
   "en": "And walked off.",
   "p": 3
  },
  {
   "ar": "اللي بيساعد الشرير، ما بيستنى شكر.",
   "en": "Whoever helps the wicked should expect no thanks.",
   "p": 3
  }
