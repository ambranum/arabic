 "sentences": [
  {
   "ar": "أهل القرية إجوا لجحا.",
   "en": "The village people came to Juha.",
   "p": 0
  },
  {
   "ar": "قالوا: إنت رجل عاقل.",
   "en": "They said: you are a wise man.",
   "p": 0
  },
  {
   "ar": "اخطب فينا يوم الجمعة.",
   "en": "Give us a sermon on Friday.",
   "p": 0
  },
  {
   "ar": "قال جحا: طيب.",
   "en": "Juha said: fine.",
   "p": 0
  },
  {
   "ar": "ويوم الجمعة، الجامع كان مليان.",
   "en": "And on Friday, the mosque was full.",
   "p": 0
  },
  {
   "ar": "وجحا وقف قدامهم.",
   "en": "And Juha stood before them.",
   "p": 0
  },
  {
   "ar": "وقال: يا ناس.",
   "en": "And said: people.",
   "p": 1
  },
  {
   "ar": "بتعرفوا شو بدي أحكي؟",
   "en": "Do you know what I am going to say?",
   "p": 1
  },
  {
   "ar": "قالوا: لأ.",
   "en": "They said: no.",
   "p": 1
  },
  {
   "ar": "ما بنعرف.",
   "en": "We do not know.",
   "p": 1
  },
  {
   "ar": "قال جحا: ولا أنا.",
   "en": "Juha said: nor do I.",
   "p": 1
  },
  {
   "ar": "سلامتكم.",
   "en": "Good day to you.",
   "p": 1
  },
  {
   "ar": "ونزل، وراح.",
   "en": "And came down, and left.",
   "p": 1
  },
  {
   "ar": "والناس استغربوا.",
   "en": "And the people were puzzled.",
   "p": 1
  },
  {
   "ar": "الجمعة الجاية، رجع.",
   "en": "The next Friday, he came back.",
   "p": 2
  },
  {
   "ar": "وقال: بتعرفوا شو بدي أحكي؟",
   "en": "And said: do you know what I am going to say?",
   "p": 2
  },
  {
   "ar": "الناس كانوا جاهزين.",
   "en": "The people were ready.",
   "p": 2
  },
  {
   "ar": "قالوا: أي!",
   "en": "They said: yes!",
   "p": 2
  },
  {
   "ar": "بنعرف!",
   "en": "We know!",
   "p": 2
  },
  {
   "ar": "قال جحا: منيح.",
   "en": "Juha said: good.",
   "p": 2
  },
  {
   "ar": "إذا بتعرفوا، ليش أحكي؟",
   "en": "If you know, why should I speak?",
   "p": 2
  },
  {
   "ar": "ونزل، وراح.",
   "en": "And came down, and left.",
   "p": 2
  },
  {
   "ar": "الجمعة التالتة، الناس عملوا خطة.",
   "en": "The third Friday, the people made a plan.",
   "p": 3
  },
  {
   "ar": "نص بيقولوا بنعرف.",
   "en": "Half say we know.",
   "p": 3
  },
  {
   "ar": "ونص بيقولوا ما بنعرف.",
   "en": "And half say we do not.",
   "p": 3
  },
  {
   "ar": "وجحا سأل: بتعرفوا شو بدي أحكي؟",
   "en": "And Juha asked: do you know what I am going to say?",
   "p": 3
  },
  {
   "ar": "النص الأول قال: بنعرف!",
   "en": "The first half said: we know!",
   "p": 3
  },
  {
   "ar": "والنص التاني قال: ما بنعرف!",
   "en": "And the second half said: we do not!",
   "p": 3
  },
  {
   "ar": "قال جحا: عظيم.",
   "en": "Juha said: excellent.",
   "p": 3
  },
  {
   "ar": "اللي بيعرف، يحكي للي ما بيعرف.",
   "en": "Those who know, tell those who do not.",
   "p": 3
  },
  {
   "ar": "ونزل، وراح.",
   "en": "And came down, and left.",
   "p": 3
  }
 ]
