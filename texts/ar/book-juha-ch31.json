 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "جحا طلع على شجرة.",
   "en": "Juha climbed a tree.",
   "p": 0
  },
  {
   "ar": "بده حطب.",
   "en": "He wanted firewood.",
   "p": 0
  },
  {
   "ar": "وقعد على غصن.",
   "en": "And sat on a branch.",
   "p": 0
  },
  {
   "ar": "غصن كبير.",
   "en": "A big branch.",
   "p": 0
  },
  {
   "ar": "وأخد المنشار.",
   "en": "And took the saw.",
   "p": 0
  },
  {
   "ar": "وبلش يقص الغصن.",
   "en": "And began sawing the branch.",
   "p": 0
  },
  {
   "ar": "من جهة الشجرة.",
   "en": "On the tree side.",
   "p": 0
  },
  {
   "ar": "وهو قاعد عالطرف التاني.",
   "en": "While sitting on the other end.",
   "p": 0
  },
  {
   "ar": "مر واحد تحت الشجرة.",
   "en": "A man passed under the tree.",
   "p": 1
  },
  {
   "ar": "وتطلع لفوق.",
   "en": "And looked up.",
   "p": 1
  },
  {
   "ar": "وقال: يا جحا!",
   "en": "And said: Juha!",
   "p": 1
  },
  {
   "ar": "إنت قاعد عالغصن.",
   "en": "You are sitting on the branch.",
   "p": 1
  },
  {
   "ar": "وبتقصه.",
   "en": "And sawing it.",
   "p": 1
  },
  {
   "ar": "رح توقع!",
   "en": "You will fall!",
   "p": 1
  },
  {
   "ar": "جحا قال: روح لحالك.",
   "en": "Juha said: go about your business.",
   "p": 1
  },
  {
   "ar": "أنا بعرف شغلي.",
   "en": "I know my work.",
   "p": 1
  },
  {
   "ar": "والرجل مشى.",
   "en": "And the man walked on.",
   "p": 1
  },
  {
   "ar": "وجحا كمل.",
   "en": "And Juha went on.",
   "p": 2
  },
  {
   "ar": "قص، وقص.",
   "en": "Sawed, and sawed.",
   "p": 2
  },
  {
   "ar": "والغصن انكسر.",
   "en": "And the branch broke.",
   "p": 2
  },
  {
   "ar": "وجحا وقع.",
   "en": "And Juha fell.",
   "p": 2
  },
  {
   "ar": "عالأرض.",
   "en": "To the ground.",
   "p": 2
  },
  {
   "ar": "وقعد، وتطلع حواليه.",
   "en": "And sat up, and looked around.",
   "p": 2
  },
  {
   "ar": "وقال: الرجل عرف!",
   "en": "And said: the man knew!",
   "p": 2
  },
  {
   "ar": "قبل ما أوقع!",
   "en": "Before I fell!",
   "p": 2
  },
  {
   "ar": "وقام جحا.",
   "en": "And Juha got up.",
   "p": 3
  },
  {
   "ar": "وركض ورا الرجل.",
   "en": "And ran after the man.",
   "p": 3
  },
  {
   "ar": "ومسكه.",
   "en": "And caught him.",
   "p": 3
  },
  {
   "ar": "وقال: إنت بتعرف الغيب!",
   "en": "And said: you know the future!",
   "p": 3
  },
  {
   "ar": "عرفت إني رح أوقع.",
   "en": "You knew I would fall.",
   "p": 3
  },
  {
   "ar": "قول لي إمتى بموت!",
   "en": "Tell me when I will die!",
   "p": 3
  },
  {
   "ar": "والرجل هرب.",
   "en": "And the man fled.",
   "p": 3
  }
 ]
}