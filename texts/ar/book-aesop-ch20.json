 "sentences": [
  {
   "ar": "كان الصيف حار.",
   "en": "The summer was hot.",
   "p": 0
  },
  {
   "ar": "وما في مطر من شهور.",
   "en": "And no rain for months.",
   "p": 0
  },
  {
   "ar": "والنهر نشف.",
   "en": "And the river had dried.",
   "p": 0
  },
  {
   "ar": "وغراب كان عطشان.",
   "en": "And a crow was thirsty.",
   "p": 0
  },
  {
   "ar": "عطشان كتير.",
   "en": "Very thirsty.",
   "p": 0
  },
  {
   "ar": "وطار، ودور.",
   "en": "And he flew, and searched.",
   "p": 0
  },
  {
   "ar": "وما لقى مي.",
   "en": "And found no water.",
   "p": 0
  },
  {
   "ar": "وبعدين شاف جرة.",
   "en": "And then he saw a pitcher.",
   "p": 1
  },
  {
   "ar": "جرة قدام بيت.",
   "en": "A pitcher in front of a house.",
   "p": 1
  },
  {
   "ar": "ونزل عليها.",
   "en": "And landed on it.",
   "p": 1
  },
  {
   "ar": "وتطلع جواها.",
   "en": "And looked inside.",
   "p": 1
  },
  {
   "ar": "في مي!",
   "en": "There was water!",
   "p": 1
  },
  {
   "ar": "بس شوي.",
   "en": "But only a little.",
   "p": 1
  },
  {
   "ar": "بقاع الجرة.",
   "en": "At the bottom of the pitcher.",
   "p": 1
  },
  {
   "ar": "الغراب حط منقاره.",
   "en": "The crow put in his beak.",
   "p": 2
  },
  {
   "ar": "ما وصل.",
   "en": "It did not reach.",
   "p": 2
  },
  {
   "ar": "والجرة ضيقة.",
   "en": "And the pitcher was narrow.",
   "p": 2
  },
  {
   "ar": "ما بيقدر يدخل راسه.",
   "en": "He could not get his head in.",
   "p": 2
  },
  {
   "ar": "حاول يقلبها.",
   "en": "He tried to tip it over.",
   "p": 2
  },
  {
   "ar": "تقيلة.",
   "en": "Too heavy.",
   "p": 2
  },
  {
   "ar": "وقعد الغراب، وفكر.",
   "en": "And the crow sat, and thought.",
   "p": 2
  },
  {
   "ar": "وشاف حجار زغار عالأرض.",
   "en": "And he saw little stones on the ground.",
   "p": 3
  },
  {
   "ar": "وأخد حجر بمنقاره.",
   "en": "And took a stone in his beak.",
   "p": 3
  },
  {
   "ar": "ورماه بالجرة.",
   "en": "And dropped it in the pitcher.",
   "p": 3
  },
  {
   "ar": "والمي طلعت شوي.",
   "en": "And the water rose a little.",
   "p": 3
  },
  {
   "ar": "وأخد حجر تاني.",
   "en": "And took another stone.",
   "p": 3
  },
  {
   "ar": "ورماه.",
   "en": "And dropped it.",
   "p": 3
  },
  {
   "ar": "والمي طلعت شوي.",
   "en": "And the water rose a little.",
   "p": 3
  },
  {
   "ar": "حجر، وحجر، وحجر.",
   "en": "Stone, and stone, and stone.",
   "p": 3
  },
  {
   "ar": "والمي وصلت لفوق.",
   "en": "And the water reached the top.",
   "p": 3
  },
  {
   "ar": "وشرب الغراب.",
   "en": "And the crow drank.",
   "p": 3
  },
  {
   "ar": "العقل بيوصل وين القوة ما بتوصل.",
   "en": "Wit reaches where strength cannot.",
   "p": 3
  }
 ]
