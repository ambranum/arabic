 "sentences": [
  {
   "ar": "الأرنب كان أسرع واحد بالغابة.",
   "en": "The hare was the fastest one in the forest.",
   "p": 0
  },
  {
   "ar": "وكان بيعرف.",
   "en": "And he knew it.",
   "p": 0
  },
  {
   "ar": "كل يوم بيقول: أنا أسرع واحد.",
   "en": "Every day he said: I am the fastest.",
   "p": 0
  },
  {
   "ar": "وبيضحك على البطيئين.",
   "en": "And laughed at the slow ones.",
   "p": 0
  },
  {
   "ar": "وأبطأ واحد بالغابة، السلحفاة.",
   "en": "And the slowest in the forest was the tortoise.",
   "p": 0
  },
  {
   "ar": "بيوم، قال لها: يا سلحفاة!",
   "en": "One day, he said to her: tortoise!",
   "p": 0
  },
  {
   "ar": "إنتِ بتمشي ولا واقفة؟",
   "en": "Are you walking or standing still?",
   "p": 0
  },
  {
   "ar": "قالت السلحفاة: بمشي.",
   "en": "The tortoise said: I am walking.",
   "p": 1
  },
  {
   "ar": "وبوصل.",
   "en": "And I arrive.",
   "p": 1
  },
  {
   "ar": "قال الأرنب: بتوصلي؟",
   "en": "The hare said: you arrive?",
   "p": 1
  },
  {
   "ar": "يلا نتسابق.",
   "en": "Come, let us race.",
   "p": 1
  },
  {
   "ar": "قالت السلحفاة: طيب.",
   "en": "The tortoise said: fine.",
   "p": 1
  },
  {
   "ar": "كل الحيوانات إجت تتفرج.",
   "en": "All the animals came to watch.",
   "p": 1
  },
  {
   "ar": "والثعلب قال: واحد، اتنين، تلاتة!",
   "en": "And the fox said: one, two, three!",
   "p": 1
  },
  {
   "ar": "الأرنب ركض زي الريح.",
   "en": "The hare ran like the wind.",
   "p": 2
  },
  {
   "ar": "بدقيقة، صار بعيد.",
   "en": "In a minute, he was far away.",
   "p": 2
  },
  {
   "ar": "تطلع لورا.",
   "en": "He looked back.",
   "p": 2
  },
  {
   "ar": "السلحفاة لسا عند البداية.",
   "en": "The tortoise was still at the start.",
   "p": 2
  },
  {
   "ar": "قال: هاي مش سباق.",
   "en": "He said: this is no race.",
   "p": 2
  },
  {
   "ar": "بنام شوي.",
   "en": "I will sleep a little.",
   "p": 2
  },
  {
   "ar": "وقعد تحت شجرة.",
   "en": "And sat under a tree.",
   "p": 2
  },
  {
   "ar": "ونام.",
   "en": "And slept.",
   "p": 2
  },
  {
   "ar": "السلحفاة مشيت.",
   "en": "The tortoise walked.",
   "p": 3
  },
  {
   "ar": "خطوة، وخطوة، وخطوة.",
   "en": "Step, and step, and step.",
   "p": 3
  },
  {
   "ar": "ما وقفت.",
   "en": "She did not stop.",
   "p": 3
  },
  {
   "ar": "ما تطلعت لورا.",
   "en": "She did not look back.",
   "p": 3
  },
  {
   "ar": "مرقت جنب الأرنب.",
   "en": "She passed the hare.",
   "p": 3
  },
  {
   "ar": "وهو نايم.",
   "en": "And he was asleep.",
   "p": 3
  },
  {
   "ar": "وكملت.",
   "en": "And went on.",
   "p": 3
  },
  {
   "ar": "الأرنب فاق.",
   "en": "The hare woke.",
   "p": 4
  },
  {
   "ar": "وتطلع عالطريق.",
   "en": "And looked at the road.",
   "p": 4
  },
  {
   "ar": "السلحفاة عند النهاية!",
   "en": "The tortoise was at the finish!",
   "p": 4
  },
  {
   "ar": "ركض بكل قوته.",
   "en": "He ran with all his strength.",
   "p": 4
  },
  {
   "ar": "بس السلحفاة وصلت أول.",
   "en": "But the tortoise arrived first.",
   "p": 4
  },
  {
   "ar": "والحيوانات كلها صفقت.",
   "en": "And all the animals clapped.",
   "p": 4
  },
  {
   "ar": "اللي بيمشي على مهله، بيوصل.",
   "en": "Slow and steady wins the race.",
   "p": 4
  }
 ]
