 "sentences": [
  {
   "ar": "جحا راح عالمدينة.",
   "en": "Juha went to the city.",
   "p": 0
  },
  {
   "ar": "وشاف بالسوق شي بيلمع.",
   "en": "And saw in the market something shining.",
   "p": 0
  },
  {
   "ar": "مراية.",
   "en": "A mirror.",
   "p": 0
  },
  {
   "ar": "ما شاف مراية بحياته.",
   "en": "He had never seen a mirror in his life.",
   "p": 0
  },
  {
   "ar": "واشتراها.",
   "en": "And he bought it.",
   "p": 0
  },
  {
   "ar": "وجابها عالبيت.",
   "en": "And brought it home.",
   "p": 0
  },
  {
   "ar": "وفتحها.",
   "en": "And opened it.",
   "p": 1
  },
  {
   "ar": "وتطلع فيها.",
   "en": "And looked in it.",
   "p": 1
  },
  {
   "ar": "وشاف رجل.",
   "en": "And saw a man.",
   "p": 1
  },
  {
   "ar": "رجل كبير بالعمر.",
   "en": "An old man.",
   "p": 1
  },
  {
   "ar": "شعره أبيض.",
   "en": "His hair white.",
   "p": 1
  },
  {
   "ar": "ولحيته طويلة.",
   "en": "And his beard long.",
   "p": 1
  },
  {
   "ar": "قال جحا: مين هاد؟",
   "en": "Juha said: who is this?",
   "p": 1
  },
  {
   "ar": "وخاف.",
   "en": "And he was frightened.",
   "p": 2
  },
  {
   "ar": "وسكر المراية.",
   "en": "And shut the mirror.",
   "p": 2
  },
  {
   "ar": "وراح لمرته.",
   "en": "And went to his wife.",
   "p": 2
  },
  {
   "ar": "وقال: في زلمة بالمراية.",
   "en": "And said: there is a man in the mirror.",
   "p": 2
  },
  {
   "ar": "زلمة كبير.",
   "en": "An old man.",
   "p": 2
  },
  {
   "ar": "ما بعرفه.",
   "en": "I do not know him.",
   "p": 2
  },
  {
   "ar": "تعالي شوفي.",
   "en": "Come and see.",
   "p": 2
  },
  {
   "ar": "مرته إجت.",
   "en": "His wife came.",
   "p": 3
  },
  {
   "ar": "وفتحت المراية.",
   "en": "And opened the mirror.",
   "p": 3
  },
  {
   "ar": "وتطلعت.",
   "en": "And looked.",
   "p": 3
  },
  {
   "ar": "وشافت مرا.",
   "en": "And saw a woman.",
   "p": 3
  },
  {
   "ar": "مرا كبيرة بالعمر.",
   "en": "An old woman.",
   "p": 3
  },
  {
   "ar": "وصرخت: يا جحا!",
   "en": "And cried: Juha!",
   "p": 3
  },
  {
   "ar": "مش بس زلمة!",
   "en": "Not only a man!",
   "p": 3
  },
  {
   "ar": "في مرا كمان!",
   "en": "There is a woman too!",
   "p": 3
  },
  {
   "ar": "ومين هاي؟",
   "en": "And who is she?",
   "p": 3
  }
