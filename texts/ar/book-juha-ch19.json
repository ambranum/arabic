 "sentences": [
  {
   "ar": "جحا صار كبير بالعمر.",
   "en": "Juha had grown old.",
   "p": 0
  },
  {
   "ar": "شعره أبيض.",
   "en": "His hair white.",
   "p": 0
  },
  {
   "ar": "وظهره منحني.",
   "en": "And his back bent.",
   "p": 0
  },
  {
   "ar": "وبيوم، راح عالحقل.",
   "en": "And one day, he went to the field.",
   "p": 0
  },
  {
   "ar": "ومعه شتلة زيتون.",
   "en": "With an olive sapling.",
   "p": 0
  },
  {
   "ar": "وحفر.",
   "en": "And dug.",
   "p": 0
  },
  {
   "ar": "وزرعها.",
   "en": "And planted it.",
   "p": 0
  },
  {
   "ar": "جاره شافه.",
   "en": "His neighbour saw him.",
   "p": 1
  },
  {
   "ar": "وضحك.",
   "en": "And laughed.",
   "p": 1
  },
  {
   "ar": "وقال: يا جحا.",
   "en": "And said: Juha.",
   "p": 1
  },
  {
   "ar": "شجرة زيتون؟",
   "en": "An olive tree?",
   "p": 1
  },
  {
   "ar": "الزيتون بده عشرين سنة.",
   "en": "Olives take twenty years.",
   "p": 1
  },
  {
   "ar": "عشان يطعمي.",
   "en": "To bear fruit.",
   "p": 1
  },
  {
   "ar": "وإنت كبير.",
   "en": "And you are old.",
   "p": 1
  },
  {
   "ar": "مش رح تاكل منها.",
   "en": "You will not eat from it.",
   "p": 1
  },
  {
   "ar": "جحا وقف.",
   "en": "Juha stood up.",
   "p": 2
  },
  {
   "ar": "ومسح إيده.",
   "en": "And wiped his hands.",
   "p": 2
  },
  {
   "ar": "وتطلع بالجار.",
   "en": "And looked at the neighbour.",
   "p": 2
  },
  {
   "ar": "وقال: صحيح.",
   "en": "And said: true.",
   "p": 2
  },
  {
   "ar": "مش رح آكل منها.",
   "en": "I will not eat from it.",
   "p": 2
  },
  {
   "ar": "قال الجار: فليش بتزرعها؟",
   "en": "The neighbour said: then why plant it?",
   "p": 2
  },
  {
   "ar": "قال جحا: لما كنت زغير، أكلت زيتون.",
   "en": "Juha said: when I was young, I ate olives.",
   "p": 3
  },
  {
   "ar": "من شجر ما زرعته.",
   "en": "From trees I did not plant.",
   "p": 3
  },
  {
   "ar": "زرعه ناس قبلي.",
   "en": "People before me planted them.",
   "p": 3
  },
  {
   "ar": "وماتوا.",
   "en": "And died.",
   "p": 3
  },
  {
   "ar": "وأنا أكلت.",
   "en": "And I ate.",
   "p": 3
  },
  {
   "ar": "وهلق أنا بزرع.",
   "en": "And now I plant.",
   "p": 3
  },
  {
   "ar": "وحدا غيري رح ياكل.",
   "en": "And someone else will eat.",
   "p": 3
  },
  {
   "ar": "هيك الدنيا.",
   "en": "That is how the world goes.",
   "p": 3
  }
 ]
}