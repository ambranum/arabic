 "sentences": [
  {
   "ar": "جحا عنده جرة.",
   "en": "Juha had a jar.",
   "p": 0
  },
  {
   "ar": "جرة كبيرة، للمي.",
   "en": "A big jar, for water.",
   "p": 0
  },
  {
   "ar": "وبيوم، قال لابنه: روح عالبير.",
   "en": "And one day, he said to his son: go to the well.",
   "p": 0
  },
  {
   "ar": "وجيب مي.",
   "en": "And fetch water.",
   "p": 0
  },
  {
   "ar": "وأعطاه الجرة.",
   "en": "And gave him the jar.",
   "p": 0
  },
  {
   "ar": "والولد أخدها.",
   "en": "And the boy took it.",
   "p": 0
  },
  {
   "ar": "وقبل ما يطلع، جحا وقفه.",
   "en": "And before he left, Juha stopped him.",
   "p": 1
  },
  {
   "ar": "وضربه كف.",
   "en": "And slapped him.",
   "p": 1
  },
  {
   "ar": "كف قوي.",
   "en": "A hard slap.",
   "p": 1
  },
  {
   "ar": "والولد بكى.",
   "en": "And the boy cried.",
   "p": 1
  },
  {
   "ar": "وقال: ليش يا بابا؟",
   "en": "And said: why, father?",
   "p": 1
  },
  {
   "ar": "أنا ما عملت شي!",
   "en": "I did nothing!",
   "p": 1
  },
  {
   "ar": "قال جحا: روح جيب المي.",
   "en": "Juha said: go and fetch the water.",
   "p": 1
  },
  {
   "ar": "الجيران شافوا.",
   "en": "The neighbours saw.",
   "p": 2
  },
  {
   "ar": "وزعلوا.",
   "en": "And were upset.",
   "p": 2
  },
  {
   "ar": "قالوا: يا جحا!",
   "en": "They said: Juha!",
   "p": 2
  },
  {
   "ar": "ليش ضربته؟",
   "en": "Why did you hit him?",
   "p": 2
  },
  {
   "ar": "الولد ما عمل شي.",
   "en": "The boy did nothing.",
   "p": 2
  },
  {
   "ar": "الجرة سليمة.",
   "en": "The jar is whole.",
   "p": 2
  },
  {
   "ar": "هاد ظلم.",
   "en": "That is unjust.",
   "p": 2
  },
  {
   "ar": "قال جحا: اسمعوا.",
   "en": "Juha said: listen.",
   "p": 3
  },
  {
   "ar": "لما تنكسر الجرة، بتنكسر.",
   "en": "When the jar breaks, it is broken.",
   "p": 3
  },
  {
   "ar": "والضرب بعدها، ما بينفع.",
   "en": "And a slap afterwards does no good.",
   "p": 3
  },
  {
   "ar": "ما بيرجع الجرة.",
   "en": "It does not bring back the jar.",
   "p": 3
  },
  {
   "ar": "فبضربه قبل.",
   "en": "So I slap him before.",
   "p": 3
  },
  {
   "ar": "عشان ينتبه.",
   "en": "So he takes care.",
   "p": 3
  },
  {
   "ar": "والجرة تضل سليمة.",
   "en": "And the jar stays whole.",
   "p": 3
  }
 ]
}