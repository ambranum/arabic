 "sentences": [
  {
   "ar": "صاحبين كانوا مسافرين.",
   "en": "Two friends were travelling.",
   "p": 0
  },
  {
   "ar": "بالغابة.",
   "en": "Through the forest.",
   "p": 0
  },
  {
   "ar": "وقالوا: إحنا أصحاب.",
   "en": "And they said: we are friends.",
   "p": 0
  },
  {
   "ar": "إذا صار شي، بنساعد بعض.",
   "en": "If anything happens, we help each other.",
   "p": 0
  },
  {
   "ar": "وحلفوا.",
   "en": "And they swore it.",
   "p": 0
  },
  {
   "ar": "ومشوا.",
   "en": "And walked on.",
   "p": 0
  },
  {
   "ar": "وفجأة، من بين الشجر، دب.",
   "en": "And suddenly, from among the trees, a bear.",
   "p": 1
  },
  {
   "ar": "دب كبير.",
   "en": "A big bear.",
   "p": 1
  },
  {
   "ar": "الصاحب الأول ركض.",
   "en": "The first friend ran.",
   "p": 1
  },
  {
   "ar": "وتسلق شجرة.",
   "en": "And climbed a tree.",
   "p": 1
  },
  {
   "ar": "بسرعة.",
   "en": "Fast.",
   "p": 1
  },
  {
   "ar": "وما تطلع لورا.",
   "en": "And did not look back.",
   "p": 1
  },
  {
   "ar": "والصاحب التاني ما لحق.",
   "en": "And the second friend did not make it.",
   "p": 1
  },
  {
   "ar": "التاني وقع عالأرض.",
   "en": "The second fell to the ground.",
   "p": 2
  },
  {
   "ar": "وعمل حاله ميت.",
   "en": "And pretended to be dead.",
   "p": 2
  },
  {
   "ar": "ما تنفس.",
   "en": "He did not breathe.",
   "p": 2
  },
  {
   "ar": "ما تحرك.",
   "en": "He did not move.",
   "p": 2
  },
  {
   "ar": "والدب إجا.",
   "en": "And the bear came.",
   "p": 2
  },
  {
   "ar": "وشمه.",
   "en": "And sniffed him.",
   "p": 2
  },
  {
   "ar": "شم وجهه، وأذنه.",
   "en": "Sniffed his face, and his ear.",
   "p": 2
  },
  {
   "ar": "والدببة ما بتاكل الميت.",
   "en": "And bears do not eat the dead.",
   "p": 2
  },
  {
   "ar": "والدب راح.",
   "en": "And the bear left.",
   "p": 2
  },
  {
   "ar": "نزل الأول من الشجرة.",
   "en": "The first came down from the tree.",
   "p": 3
  },
  {
   "ar": "وضحك.",
   "en": "And laughed.",
   "p": 3
  },
  {
   "ar": "قال: شفتك مع الدب.",
   "en": "He said: I saw you with the bear.",
   "p": 3
  },
  {
   "ar": "حط تمه على أذنك.",
   "en": "He put his mouth to your ear.",
   "p": 3
  },
  {
   "ar": "شو حكى معك؟",
   "en": "What did he tell you?",
   "p": 3
  },
  {
   "ar": "قال التاني: قال لي نصيحة.",
   "en": "The second said: he gave me advice.",
   "p": 3
  },
  {
   "ar": "قال: لا تسافر مع صاحب بيتركك بالخطر.",
   "en": "He said: do not travel with a friend who leaves you in danger.",
   "p": 3
  },
  {
   "ar": "الصاحب بيبين بالضيق.",
   "en": "A friend shows in hard times.",
   "p": 3
  }
 ]
}