 "sentences": [
  {
   "ar": "حمار لقى جلد أسد.",
   "en": "A donkey found a lion's skin.",
   "p": 0
  },
  {
   "ar": "جلد كامل، بالراس والديل.",
   "en": "A whole skin, with the head and the tail.",
   "p": 0
  },
  {
   "ar": "تركه صياد بالغابة.",
   "en": "A hunter had left it in the forest.",
   "p": 0
  },
  {
   "ar": "والحمار لبسه.",
   "en": "And the donkey put it on.",
   "p": 0
  },
  {
   "ar": "وتطلع بالمي.",
   "en": "And looked in the water.",
   "p": 0
  },
  {
   "ar": "وشاف أسد.",
   "en": "And saw a lion.",
   "p": 0
  },
  {
   "ar": "وفرح كتير.",
   "en": "And was very pleased.",
   "p": 0
  },
  {
   "ar": "ومشى بالغابة.",
   "en": "And walked through the forest.",
   "p": 1
  },
  {
   "ar": "والحيوانات شافوه.",
   "en": "And the animals saw him.",
   "p": 1
  },
  {
   "ar": "وهربوا.",
   "en": "And fled.",
   "p": 1
  },
  {
   "ar": "الغزلان هربت.",
   "en": "The deer fled.",
   "p": 1
  },
  {
   "ar": "والأرانب هربت.",
   "en": "And the rabbits fled.",
   "p": 1
  },
  {
   "ar": "وحتى الذيب هرب.",
   "en": "And even the wolf fled.",
   "p": 1
  },
  {
   "ar": "والحمار قال: أنا ملك!",
   "en": "And the donkey said: I am king!",
   "p": 1
  },
  {
   "ar": "ومر الثعلب.",
   "en": "And the fox passed.",
   "p": 2
  },
  {
   "ar": "وشاف الأسد.",
   "en": "And saw the lion.",
   "p": 2
  },
  {
   "ar": "وخاف.",
   "en": "And was afraid.",
   "p": 2
  },
  {
   "ar": "ووقف.",
   "en": "And stopped.",
   "p": 2
  },
  {
   "ar": "والحمار فرح أكتر.",
   "en": "And the donkey was even more pleased.",
   "p": 2
  },
  {
   "ar": "وقال: بخوفه!",
   "en": "And said: I will frighten him!",
   "p": 2
  },
  {
   "ar": "وفتح تمه.",
   "en": "And opened his mouth.",
   "p": 2
  },
  {
   "ar": "وقال: هيــهاااو!",
   "en": "And said: hee-haaw!",
   "p": 3
  },
  {
   "ar": "والثعلب ضحك.",
   "en": "And the fox laughed.",
   "p": 3
  },
  {
   "ar": "قال: أسد؟",
   "en": "He said: a lion?",
   "p": 3
  },
  {
   "ar": "الأسد بيزعق.",
   "en": "A lion roars.",
   "p": 3
  },
  {
   "ar": "وإنت بتنهق.",
   "en": "And you bray.",
   "p": 3
  },
  {
   "ar": "إنت حمار.",
   "en": "You are a donkey.",
   "p": 3
  },
  {
   "ar": "بجلد أسد.",
   "en": "In a lion's skin.",
   "p": 3
  },
  {
   "ar": "والحيوانات رجعت، وضحكت عليه.",
   "en": "And the animals came back, and laughed at him.",
   "p": 3
  },
  {
   "ar": "الجلد بيخبي، والصوت بيفضح.",
   "en": "The skin hides, and the voice betrays.",
   "p": 3
  }
 ]
