 "sentences": [
  {
   "ar": "جحا راح يجيب مي من البير.",
   "en": "Juha went to fetch water from the well.",
   "p": 0
  },
  {
   "ar": "ونزل الدلو.",
   "en": "And lowered the bucket.",
   "p": 0
  },
  {
   "ar": "وسحبه.",
   "en": "And pulled it up.",
   "p": 0
  },
  {
   "ar": "وشرب.",
   "en": "And drank.",
   "p": 0
  },
  {
   "ar": "وبعدين تطلع بإيده.",
   "en": "And then looked at his hand.",
   "p": 0
  },
  {
   "ar": "الخاتم مش موجود.",
   "en": "The ring was not there.",
   "p": 0
  },
  {
   "ar": "وقع بالبير.",
   "en": "It had fallen in the well.",
   "p": 0
  },
  {
   "ar": "البير عميق.",
   "en": "The well was deep.",
   "p": 1
  },
  {
   "ar": "والمي بعيدة.",
   "en": "And the water far down.",
   "p": 1
  },
  {
   "ar": "وعتمة.",
   "en": "And dark.",
   "p": 1
  },
  {
   "ar": "جحا تطلع فيه.",
   "en": "Juha looked into it.",
   "p": 1
  },
  {
   "ar": "وفكر.",
   "en": "And thought.",
   "p": 1
  },
  {
   "ar": "وراح عالبيت.",
   "en": "And went home.",
   "p": 1
  },
  {
   "ar": "وجاب صحن لبن.",
   "en": "And brought a plate of yoghurt.",
   "p": 1
  },
  {
   "ar": "وكبه بالبير.",
   "en": "And poured it in the well.",
   "p": 1
  },
  {
   "ar": "جاره شافه.",
   "en": "His neighbour saw him.",
   "p": 2
  },
  {
   "ar": "وقال: يا جحا!",
   "en": "And said: Juha!",
   "p": 2
  },
  {
   "ar": "شو عم تعمل؟",
   "en": "What are you doing?",
   "p": 2
  },
  {
   "ar": "قال جحا: عم أعمل لبن.",
   "en": "Juha said: I am making yoghurt.",
   "p": 2
  },
  {
   "ar": "قال الجار: بالبير؟",
   "en": "The neighbour said: in the well?",
   "p": 2
  },
  {
   "ar": "قال جحا: بالبير.",
   "en": "Juha said: in the well.",
   "p": 2
  },
  {
   "ar": "قال الجار: يا مجنون.",
   "en": "The neighbour said: you madman.",
   "p": 2
  },
  {
   "ar": "البير ما بيصير لبن!",
   "en": "A well does not turn into yoghurt!",
   "p": 2
  },
  {
   "ar": "جحا تطلع بالجار.",
   "en": "Juha looked at the neighbour.",
   "p": 3
  },
  {
   "ar": "وقال: بعرف.",
   "en": "And said: I know.",
   "p": 3
  },
  {
   "ar": "بس تخيل.",
   "en": "But imagine.",
   "p": 3
  },
  {
   "ar": "إذا صار؟",
   "en": "If it did?",
   "p": 3
  },
  {
   "ar": "بير كامل لبن.",
   "en": "A whole well of yoghurt.",
   "p": 3
  },
  {
   "ar": "والجار سكت.",
   "en": "And the neighbour was silent.",
   "p": 3
  },
  {
   "ar": "وراح.",
   "en": "And left.",
   "p": 3
  },
  {
   "ar": "وجحا ضل يفكر بالخاتم.",
   "en": "And Juha kept thinking about the ring.",
   "p": 3
  }
 ]
