 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "رجل كبير بالعمر كان بيجمع حطب.",
   "en": "An old man was gathering firewood.",
   "p": 0
  },
  {
   "ar": "بالغابة.",
   "en": "In the forest.",
   "p": 0
  },
  {
   "ar": "وجمع حزمة كبيرة.",
   "en": "And gathered a big bundle.",
   "p": 0
  },
  {
   "ar": "وحملها على ظهره.",
   "en": "And carried it on his back.",
   "p": 0
  },
  {
   "ar": "ومشى.",
   "en": "And walked.",
   "p": 0
  },
  {
   "ar": "والطريق طويلة.",
   "en": "And the road was long.",
   "p": 0
  },
  {
   "ar": "والحزمة تقيلة.",
   "en": "And the bundle was heavy.",
   "p": 0
  },
  {
   "ar": "وظهره بيوجعه.",
   "en": "And his back hurt.",
   "p": 1
  },
  {
   "ar": "وإجريه بتوجعه.",
   "en": "And his legs hurt.",
   "p": 1
  },
  {
   "ar": "والشمس حامية.",
   "en": "And the sun was hot.",
   "p": 1
  },
  {
   "ar": "ووقف.",
   "en": "And he stopped.",
   "p": 1
  },
  {
   "ar": "ورمى الحزمة عالأرض.",
   "en": "And threw the bundle on the ground.",
   "p": 1
  },
  {
   "ar": "وقعد عليها.",
   "en": "And sat on it.",
   "p": 1
  },
  {
   "ar": "وبكى.",
   "en": "And wept.",
   "p": 1
  },
  {
   "ar": "وقال: يا رب.",
   "en": "And said: Lord.",
   "p": 2
  },
  {
   "ar": "شو هالحياة؟",
   "en": "What is this life?",
   "p": 2
  },
  {
   "ar": "شغل، وتعب، وجوع.",
   "en": "Work, and toil, and hunger.",
   "p": 2
  },
  {
   "ar": "وما حدا بيساعدني.",
   "en": "And no one helps me.",
   "p": 2
  },
  {
   "ar": "يا موت، تعال.",
   "en": "Death, come.",
   "p": 2
  },
  {
   "ar": "خدني.",
   "en": "Take me.",
   "p": 2
  },
  {
   "ar": "خلصني.",
   "en": "Release me.",
   "p": 2
  },
  {
   "ar": "والموت إجا.",
   "en": "And Death came.",
   "p": 3
  },
  {
   "ar": "وقف قدامه.",
   "en": "It stood before him.",
   "p": 3
  },
  {
   "ar": "وقال: ناديتني؟",
   "en": "And said: you called me?",
   "p": 3
  },
  {
   "ar": "أنا هون.",
   "en": "I am here.",
   "p": 3
  },
  {
   "ar": "شو بدك؟",
   "en": "What do you want?",
   "p": 3
  },
  {
   "ar": "والرجل خاف.",
   "en": "And the man was afraid.",
   "p": 3
  },
  {
   "ar": "وقام بسرعة.",
   "en": "And got up quickly.",
   "p": 3
  },
  {
   "ar": "وقال: بدك...",
   "en": "And said: I want...",
   "p": 3
  },
  {
   "ar": "بدك تساعدني.",
   "en": "I want you to help me.",
   "p": 3
  },
  {
   "ar": "ارفع لي الحزمة على ظهري.",
   "en": "Lift the bundle onto my back for me.",
   "p": 3
  },
  {
   "ar": "الكل بيطلب الموت، وما حدا بده ياه.",
   "en": "Everyone calls for death, and no one wants it.",
   "p": 3
  }
 ]
}