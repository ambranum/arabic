   "en": "Juha's neighbour borrowed things.",
   "p": 0
  },
  {
   "ar": "كل يوم شي.",
   "en": "Something every day.",
   "p": 0
  },
  {
   "ar": "وما بيرجع.",
   "en": "And never returned them.",
   "p": 0
  },
  {
   "ar": "استعار المنشار.",
   "en": "He borrowed the saw.",
   "p": 0
  },
  {
   "ar": "وما رجعه.",
   "en": "And did not return it.",
   "p": 0
  },
  {
   "ar": "استعار الحبل.",
   "en": "He borrowed the rope.",
   "p": 0
  },
  {
   "ar": "وما رجعه.",
   "en": "And did not return it.",
   "p": 0
  },
  {
   "ar": "استعار السلم.",
   "en": "He borrowed the ladder.",
   "p": 0
  },
  {
   "ar": "وما رجعه.",
   "en": "And did not return it.",
   "p": 0
  },
  {
   "ar": "وجحا ساكت.",
   "en": "And Juha said nothing.",
   "p": 1
  },
  {
   "ar": "مستحي يطلب.",
   "en": "Too shy to ask.",
   "p": 1
  },
  {
   "ar": "وبيوم، الجار إجا.",
   "en": "And one day, the neighbour came.",
   "p": 1
  },
  {
   "ar": "وقال: يا جحا.",
   "en": "And said: Juha.",
   "p": 1
  },
  {
   "ar": "بدي حمارك.",
   "en": "I want your donkey.",
   "p": 1
  },
  {
   "ar": "يوم واحد.",
   "en": "One day.",
   "p": 1
  },
  {
   "ar": "جحا تطلع فيه.",
   "en": "Juha looked at him.",
   "p": 1
  },
  {
   "ar": "وقال: يا خسارة.",
   "en": "And said: what a pity.",
   "p": 2
  },
  {
   "ar": "الحمار مش هون.",
   "en": "The donkey is not here.",
   "p": 2
  },
  {
   "ar": "مسافر.",
   "en": "It is away.",
   "p": 2
  },
  {
   "ar": "قال الجار: مسافر؟",
   "en": "The neighbour said: away?",
   "p": 2
  },
  {
   "ar": "لوين؟",
   "en": "Where to?",
   "p": 2
  },
  {
   "ar": "قال جحا: لعندك.",
   "en": "Juha said: to your place.",
   "p": 2
  },
  {
   "ar": "قال الجار: لعندي؟",
   "en": "The neighbour said: to my place?",
   "p": 3
  },
  {
   "ar": "ليش؟",
   "en": "Why?",
   "p": 3
  },
  {
   "ar": "قال جحا: راح يجيب أغراضي.",
   "en": "Juha said: to fetch my things.",
   "p": 3
  },
  {
   "ar": "المنشار، والحبل، والسلم.",
   "en": "The saw, the rope, the ladder.",
   "p": 3
  },
  {
   "ar": "لما يرجع، بعطيك ياه.",
   "en": "When it comes back, I lend it to you.",
   "p": 3
  },
  {
   "ar": "والجار احمر.",
   "en": "And the neighbour went red.",
   "p": 3
  },
  {
   "ar": "وراح.",
   "en": "And left.",
   "p": 3
  },
  {
   "ar": "ورجع بعد ساعة.",
   "en": "And came back an hour later.",
   "p": 3
  },
  {
   "ar": "ومعه المنشار، والحبل، والسلم.",
   "en": "With the saw, the rope, and the ladder.",
