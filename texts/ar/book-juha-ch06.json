 "sentences": [
  {
   "ar": "بالليل، جحا رجع عالبيت.",
   "en": "At night, Juha came home.",
   "p": 0
  },
  {
   "ar": "وحط إيده بجيبه.",
   "en": "And put his hand in his pocket.",
   "p": 0
  },
  {
   "ar": "والمفتاح مش موجود.",
   "en": "And the key was not there.",
   "p": 0
  },
  {
   "ar": "دور بجيبه التاني.",
   "en": "He looked in his other pocket.",
   "p": 0
  },
  {
   "ar": "مش موجود.",
   "en": "Not there.",
   "p": 0
  },
  {
   "ar": "قال: ضيعت المفتاح.",
   "en": "He said: I have lost the key.",
   "p": 0
  },
  {
   "ar": "وراح عالشارع.",
   "en": "And he went into the street.",
   "p": 1
  },
  {
   "ar": "تحت الضوء.",
   "en": "Under the lamp.",
   "p": 1
  },
  {
   "ar": "وقعد يدور.",
   "en": "And began searching.",
   "p": 1
  },
  {
   "ar": "عالأرض.",
   "en": "On the ground.",
   "p": 1
  },
  {
   "ar": "بين الحجار.",
   "en": "Among the stones.",
   "p": 1
  },
  {
   "ar": "ساعة كاملة.",
   "en": "A whole hour.",
   "p": 1
  },
  {
   "ar": "إجا جاره.",
   "en": "His neighbour came.",
   "p": 2
  },
  {
   "ar": "وقال: شو بتعمل يا جحا؟",
   "en": "And said: what are you doing, Juha?",
   "p": 2
  },
  {
   "ar": "قال جحا: بدور على مفتاحي.",
   "en": "Juha said: looking for my key.",
   "p": 2
  },
  {
   "ar": "قال الجار: بساعدك.",
   "en": "The neighbour said: I will help you.",
   "p": 2
  },
  {
   "ar": "وقعد يدور معه.",
   "en": "And began searching with him.",
   "p": 2
  },
  {
   "ar": "ساعة كمان.",
   "en": "Another hour.",
   "p": 2
  },
  {
   "ar": "وما لقوا شي.",
   "en": "And they found nothing.",
   "p": 2
  },
  {
   "ar": "قال الجار: يا جحا.",
   "en": "The neighbour said: Juha.",
   "p": 3
  },
  {
   "ar": "وين وقع المفتاح بالزبط؟",
   "en": "Where exactly did the key fall?",
   "p": 3
  },
  {
   "ar": "قال جحا: جوا البيت.",
   "en": "Juha said: inside the house.",
   "p": 3
  },
  {
   "ar": "بالأوضة.",
   "en": "In the room.",
   "p": 3
  },
  {
   "ar": "قال الجار: جوا البيت؟",
   "en": "The neighbour said: inside the house?",
   "p": 3
  },
  {
   "ar": "وليش عم ندور هون؟",
   "en": "Then why are we searching here?",
   "p": 3
  },
  {
   "ar": "قال جحا: لأنه هون في ضوء.",
   "en": "Juha said: because here there is light.",
   "p": 3
  },
  {
   "ar": "وجوا عتمة.",
   "en": "And inside it is dark.",
