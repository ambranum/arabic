 "sentences": [
  {
   "ar": "كان في رجل فقير.",
   "en": "There was a poor man.",
   "p": 0
  },
  {
   "ar": "معه خبزة يابسة.",
   "en": "He had a dry loaf.",
   "p": 0
  },
  {
   "ar": "وقعد جنب دكان أكل.",
   "en": "And sat beside a food shop.",
   "p": 0
  },
  {
   "ar": "الدكان فيه لحمة مشوية.",
   "en": "The shop had grilled meat.",
   "p": 0
  },
  {
   "ar": "وريحتها طيبة.",
   "en": "And it smelled good.",
   "p": 0
  },
  {
   "ar": "الفقير أكل خبزه.",
   "en": "The poor man ate his bread.",
   "p": 0
  },
  {
   "ar": "وهو بيشم الريحة.",
   "en": "While smelling the smell.",
   "p": 0
  },
  {
   "ar": "وقال: أطيب خبزة أكلتها.",
   "en": "And said: the best bread I ever ate.",
   "p": 0
  },
  {
   "ar": "صاحب الدكان شافه.",
   "en": "The shopkeeper saw him.",
   "p": 1
  },
  {
   "ar": "وطلع عليه.",
   "en": "And came out to him.",
   "p": 1
  },
  {
   "ar": "وقال: ادفع.",
   "en": "And said: pay.",
   "p": 1
  },
  {
   "ar": "قال الفقير: أدفع شو؟",
   "en": "The poor man said: pay for what?",
   "p": 1
  },
  {
   "ar": "أنا ما أكلت من عندك.",
   "en": "I ate nothing of yours.",
   "p": 1
  },
  {
   "ar": "قال صاحب الدكان: شميت ريحة أكلي.",
   "en": "The shopkeeper said: you smelled my food.",
   "p": 1
  },
  {
   "ar": "والريحة إلها ثمن.",
   "en": "And the smell has a price.",
   "p": 1
  },
  {
   "ar": "وصاروا يتخانقوا.",
   "en": "And they began to quarrel.",
   "p": 1
  },
  {
   "ar": "راحوا عند القاضي.",
   "en": "They went to the judge.",
   "p": 2
  },
  {
   "ar": "والقاضي كان جحا.",
   "en": "And the judge was Juha.",
   "p": 2
  },
  {
   "ar": "جحا سمع القصة.",
   "en": "Juha heard the story.",
   "p": 2
  },
  {
   "ar": "وقال: صحيح.",
   "en": "And said: true.",
   "p": 2
  },
  {
   "ar": "الريحة إلها ثمن.",
   "en": "The smell has a price.",
   "p": 2
  },
  {
   "ar": "صاحب الدكان فرح.",
   "en": "The shopkeeper was pleased.",
   "p": 2
  },
  {
   "ar": "والفقير خاف.",
   "en": "And the poor man was afraid.",
   "p": 2
  },
  {
   "ar": "جحا أخد كيس مصاري.",
   "en": "Juha took a bag of coins.",
   "p": 3
  },
  {
   "ar": "وهزه.",
   "en": "And shook it.",
   "p": 3
  },
  {
   "ar": "قدام صاحب الدكان.",
   "en": "In front of the shopkeeper.",
   "p": 3
  },
  {
   "ar": "طق، طق، طق.",
   "en": "Clink, clink, clink.",
   "p": 3
  },
  {
   "ar": "وقال: سمعت صوت المصاري؟",
   "en": "And said: did you hear the sound of the money?",
   "p": 3
  },
  {
   "ar": "قال: سمعت.",
   "en": "He said: I heard.",
   "p": 3
  },
  {
   "ar": "قال جحا: خلص.",
   "en": "Juha said: done.",
   "p": 3
  },
  {
   "ar": "صوت المصاري، بدفع ريحة الأكل.",
   "en": "The sound of money pays for the smell of food.",
   "p": 3
  },
  {
   "ar": "روحوا.",
   "en": "Go.",
   "p": 3
  }
 ]
}