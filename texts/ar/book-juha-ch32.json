 "sentences": [
  {
   "ar": "جحا راح عالسوق.",
   "en": "Juha went to the market.",
   "p": 0
  },
  {
   "ar": "واشترى بصل.",
   "en": "And bought onions.",
   "p": 0
  },
  {
   "ar": "كيس كبير.",
   "en": "A big sack.",
   "p": 0
  },
  {
   "ar": "وحمله على ظهره.",
   "en": "And carried it on his back.",
   "p": 0
  },
  {
   "ar": "والطريق للبيت طويلة.",
   "en": "And the road home was long.",
   "p": 0
  },
  {
   "ar": "والكيس تقيل.",
   "en": "And the sack was heavy.",
   "p": 0
  },
  {
   "ar": "مشى جحا شوي.",
   "en": "Juha walked a little.",
   "p": 1
  },
  {
   "ar": "وتعب.",
   "en": "And grew tired.",
   "p": 1
  },
  {
   "ar": "ووقف.",
   "en": "And stopped.",
   "p": 1
  },
  {
   "ar": "وحط الكيس.",
   "en": "And put the sack down.",
   "p": 1
  },
  {
   "ar": "وفتحه.",
   "en": "And opened it.",
   "p": 1
  },
  {
   "ar": "وعد البصلات.",
   "en": "And counted the onions.",
   "p": 1
  },
  {
   "ar": "واحد، اتنين، تلاتة...",
   "en": "One, two, three...",
   "p": 1
  },
  {
   "ar": "وحمله، ومشى.",
   "en": "And picked it up, and walked.",
   "p": 1
  },
  {
   "ar": "وبعد شوي، وقف كمان.",
   "en": "And a little later, he stopped again.",
   "p": 2
  },
  {
   "ar": "وعد البصلات.",
   "en": "And counted the onions.",
   "p": 2
  },
  {
   "ar": "وحمله، ومشى.",
   "en": "And picked it up, and walked.",
   "p": 2
  },
  {
   "ar": "ووقف، وعد.",
   "en": "And stopped, and counted.",
   "p": 2
  },
  {
   "ar": "كل شوي.",
   "en": "Every little while.",
   "p": 2
  },
  {
   "ar": "وواحد كان ماشي وراه.",
   "en": "And someone was walking behind him.",
   "p": 2
  },
  {
   "ar": "وبيتفرج.",
   "en": "And watching.",
   "p": 2
  },
  {
   "ar": "قال الرجل: يا جحا.",
   "en": "The man said: Juha.",
   "p": 3
  },
  {
   "ar": "ليش بتعد البصل؟",
   "en": "Why do you count the onions?",
   "p": 3
  },
  {
   "ar": "كل شوي؟",
   "en": "Every little while?",
   "p": 3
  },
  {
   "ar": "حدا بيسرق منه؟",
   "en": "Is someone stealing from it?",
   "p": 3
  },
  {
   "ar": "قال جحا: لا.",
   "en": "Juha said: no.",
   "p": 3
  },
  {
   "ar": "بس كل ما بعد، بنسى إني تعبان.",
   "en": "But every time I count, I forget I am tired.",
   "p": 3
  },
  {
   "ar": "وبقدر أكمل.",
   "en": "And I can go on.",
   "p": 3
  }
 ]
