 "sentences": [
  {
   "ar": "فار الضيعة عايش بحقل.",
   "en": "The country mouse lived in a field.",
   "p": 0
  },
  {
   "ar": "بيته زغير، تحت شجرة.",
   "en": "His house was small, under a tree.",
   "p": 0
  },
  {
   "ar": "بياكل قمح، وشعير، وجذور.",
   "en": "He ate wheat, barley, roots.",
   "p": 0
  },
  {
   "ar": "وبيوم، زاره ابن عمه.",
   "en": "And one day, his cousin visited him.",
   "p": 0
  },
  {
   "ar": "فار المدينة.",
   "en": "The town mouse.",
   "p": 0
  },
  {
   "ar": "لابس منيح، وريحته حلوة.",
   "en": "Well dressed, and smelling sweet.",
   "p": 0
  },
  {
   "ar": "وفار الضيعة فرح كتير.",
   "en": "And the country mouse was very glad.",
   "p": 0
  },
  {
   "ar": "حط له كل اللي عنده.",
   "en": "He put out everything he had.",
   "p": 1
  },
  {
   "ar": "قمح، وشعير، وجذور، وحبة جوز.",
   "en": "Wheat, barley, roots, a walnut.",
   "p": 1
  },
  {
   "ar": "فار المدينة أكل شوي.",
   "en": "The town mouse ate a little.",
   "p": 1
  },
  {
   "ar": "وقال: هاد أكل؟",
   "en": "And said: this is food?",
   "p": 1
  },
  {
   "ar": "يا ابن عمي، إنت عايش زي النملة.",
   "en": "Cousin, you live like an ant.",
   "p": 1
  },
  {
   "ar": "تعال معي عالمدينة.",
   "en": "Come with me to the town.",
   "p": 1
  },
  {
   "ar": "وشوف الأكل الحقيقي.",
   "en": "And see real food.",
   "p": 1
  },
  {
   "ar": "راحوا سوا عالمدينة.",
   "en": "They went together to the town.",
   "p": 2
  },
  {
   "ar": "بالليل.",
   "en": "At night.",
   "p": 2
  },
  {
   "ar": "ودخلوا بيت كبير.",
   "en": "And entered a big house.",
   "p": 2
  },
  {
   "ar": "وعالطاولة، كل شي.",
   "en": "And on the table, everything.",
   "p": 2
  },
  {
   "ar": "جبنة، وخبز أبيض، وعسل، وفواكه، وكعك.",
   "en": "Cheese, white bread, honey, fruit, cake.",
   "p": 2
  },
  {
   "ar": "فار الضيعة ما صدق عينه.",
   "en": "The country mouse could not believe his eyes.",
   "p": 2
  },
  {
   "ar": "وبلش ياكل.",
   "en": "And began to eat.",
   "p": 2
  },
  {
   "ar": "وفجأة، انفتح الباب.",
   "en": "And suddenly, the door opened.",
   "p": 3
  },
  {
   "ar": "ودخل ناس.",
   "en": "And people came in.",
   "p": 3
  },
  {
   "ar": "والفارين ركضوا، وتخبوا بشق.",
   "en": "And the two mice ran, and hid in a crack.",
   "p": 3
  },
  {
   "ar": "والناس راحوا.",
   "en": "And the people left.",
   "p": 3
  },
  {
   "ar": "ورجعوا ياكلوا.",
   "en": "And they went back to eating.",
   "p": 3
  },
  {
   "ar": "وفجأة، قطة.",
   "en": "And suddenly, a cat.",
   "p": 3
  },
  {
   "ar": "قطة كبيرة، وعينها بتلمع.",
   "en": "A big cat, with shining eyes.",
   "p": 3
  },
  {
   "ar": "والفارين ركضوا للشق كمان مرة.",
   "en": "And the two mice ran to the crack again.",
   "p": 3
  },
  {
   "ar": "وقلبهم بيدق.",
   "en": "Their hearts pounding.",
   "p": 3
  },
  {
   "ar": "قال فار الضيعة: خلص.",
   "en": "The country mouse said: enough.",
   "p": 4
  },
  {
   "ar": "أنا راجع.",
   "en": "I am going home.",
   "p": 4
  },
  {
   "ar": "قال فار المدينة: ليش؟",
   "en": "The town mouse said: why?",
   "p": 4
  },
  {
   "ar": "شفت الأكل؟",
   "en": "Did you see the food?",
   "p": 4
  },
  {
   "ar": "قال فار الضيعة: شفت.",
   "en": "The country mouse said: I saw.",
   "p": 4
  },
  {
   "ar": "وشفت القطة.",
   "en": "And I saw the cat.",
   "p": 4
  },
  {
   "ar": "أكلي قليل، بس بآكله بهدوء.",
   "en": "My food is little, but I eat it in peace.",
   "p": 4
  },
  {
   "ar": "ورجع عالحقل.",
   "en": "And went back to the field.",
   "p": 4
  },
  {
   "ar": "لقمة بأمان، أحسن من عزيمة بخوف.",
   "en": "A crust in peace is better than a feast in fear.",
   "p": 4
  }
 ]
}