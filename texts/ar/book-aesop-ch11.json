  {
   "ar": "فار من المدينة زار قريبه.",
   "en": "A mouse from the city visited his relative.",
   "p": 0
  },
  {
   "ar": "قريبه ساكن بالضيعة.",
   "en": "His relative lived in the village.",
   "p": 0
  },
  {
   "ar": "أكلوا حب وخبز يابس.",
   "en": "They ate grain and dry bread.",
   "p": 1
  },
  {
   "ar": "قال فار المدينة: تعال معي.",
   "en": "The city mouse said: come with me.",
   "p": 1
  },
  {
   "ar": "بالمدينة، الأكل كان كتير وحلو.",
   "en": "In the city, the food was plenty and good.",
   "p": 2
  },
  {
   "ar": "بس القطة إجت مرتين.",
   "en": "But the cat came twice.",
   "p": 2
  },
  {
   "ar": "فار الضيعة رجع عالضيعة.",
   "en": "The village mouse went back to the village.",
   "p": 3
  },
  {
   "ar": "قال: خبز يابس وأنا مرتاح.",
   "en": "He said: dry bread, and I am at peace.",
   "p": 3
