 "sentences": [
  {
   "ar": "جحا بده يسافر.",
   "en": "Juha wanted to travel.",
   "p": 0
  },
  {
   "ar": "للمدينة.",
   "en": "To the city.",
   "p": 0
  },
  {
   "ar": "يومين.",
   "en": "For two days.",
   "p": 0
  },
  {
   "ar": "وأمه كانت خايفة.",
   "en": "And his mother was worried.",
   "p": 0
  },
  {
   "ar": "قالت: البيت فاضي.",
   "en": "She said: the house will be empty.",
   "p": 0
  },
  {
   "ar": "وفي حرامية.",
   "en": "And there are thieves.",
   "p": 0
  },
  {
   "ar": "قال جحا: لا تخافي.",
   "en": "Juha said: do not worry.",
   "p": 0
  },
  {
   "ar": "قالت أمه: يا جحا.",
   "en": "His mother said: Juha.",
   "p": 1
  },
  {
   "ar": "دير بالك عالباب.",
   "en": "Mind the door.",
   "p": 1
  },
  {
   "ar": "الباب أهم شي.",
   "en": "The door is the most important thing.",
   "p": 1
  },
  {
   "ar": "لا تتركه.",
   "en": "Do not leave it.",
   "p": 1
  },
  {
   "ar": "قال جحا: طيب يا ماما.",
   "en": "Juha said: fine, mother.",
   "p": 1
  },
  {
   "ar": "ما بتركه.",
   "en": "I will not leave it.",
   "p": 1
  },
  {
   "ar": "وراحت أمه عند أختها.",
   "en": "And his mother went to her sister's.",
   "p": 1
  },
  {
   "ar": "جحا وقف قدام الباب.",
   "en": "Juha stood in front of the door.",
   "p": 2
  },
  {
   "ar": "وفكر.",
   "en": "And thought.",
   "p": 2
  },
  {
   "ar": "كيف بدير بالي عليه، وأنا مسافر؟",
   "en": "How do I mind it, when I am travelling?",
   "p": 2
  },
  {
   "ar": "وإجت له فكرة.",
   "en": "And an idea came to him.",
   "p": 2
  },
  {
   "ar": "قلع الباب.",
   "en": "He took the door off.",
   "p": 2
  },
  {
   "ar": "وحمله على ظهره.",
   "en": "And carried it on his back.",
   "p": 2
  },
  {
   "ar": "ومشى.",
   "en": "And walked.",
   "p": 2
  },
  {
   "ar": "مشى بالباب كل الطريق.",
   "en": "He walked with the door all the way.",
   "p": 3
  },
  {
   "ar": "للمدينة.",
   "en": "To the city.",
   "p": 3
  },
  {
   "ar": "والناس بيتطلعوا.",
   "en": "And people stared.",
   "p": 3
  },
  {
   "ar": "سألوه: يا جحا!",
   "en": "They asked him: Juha!",
   "p": 3
  },
  {
   "ar": "ليش شايل باب؟",
   "en": "Why are you carrying a door?",
   "p": 3
  },
  {
   "ar": "قال جحا: أمي قالت لي.",
   "en": "Juha said: my mother told me.",
   "p": 3
  },
  {
   "ar": "دير بالك عالباب.",
   "en": "Mind the door.",
   "p": 3
  },
  {
   "ar": "وأنا بدير بالي.",
   "en": "And I am minding it.",
   "p": 3
  },
  {
   "ar": "شوفوا، هو معي.",
   "en": "See, it is with me.",
   "p": 3
  }
 ]
}