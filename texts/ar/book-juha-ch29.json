 "sentences": [
  {
   "ar": "الحاكم كان عنده حمار.",
   "en": "The ruler had a donkey.",
   "p": 0
  },
  {
   "ar": "وكان بيحبه.",
   "en": "And he loved it.",
   "p": 0
  },
  {
   "ar": "وبيوم، نادى جحا.",
   "en": "And one day, he called Juha.",
   "p": 0
  },
  {
   "ar": "وقال: يا جحا.",
   "en": "And said: Juha.",
   "p": 0
  },
  {
   "ar": "إنت رجل عالم.",
   "en": "You are a learned man.",
   "p": 0
  },
  {
   "ar": "علّم حماري يقرا.",
   "en": "Teach my donkey to read.",
   "p": 0
  },
  {
   "ar": "جحا تطلع بالحمار.",
   "en": "Juha looked at the donkey.",
   "p": 1
  },
  {
   "ar": "وتطلع بالحاكم.",
   "en": "And looked at the ruler.",
   "p": 1
  },
  {
   "ar": "وقال: طيب.",
   "en": "And said: fine.",
   "p": 1
  },
  {
   "ar": "بس بحاجة وقت.",
   "en": "But I need time.",
   "p": 1
  },
  {
   "ar": "قال الحاكم: قديش؟",
   "en": "The ruler said: how long?",
   "p": 1
  },
  {
   "ar": "قال جحا: عشر سنين.",
   "en": "Juha said: ten years.",
   "p": 1
  },
  {
   "ar": "قال الحاكم: طيب.",
   "en": "The ruler said: fine.",
   "p": 1
  },
  {
   "ar": "عشر سنين.",
   "en": "Ten years.",
   "p": 1
  },
  {
   "ar": "وإذا ما قرا، بقطع راسك.",
   "en": "And if it does not read, I cut off your head.",
   "p": 1
  },
  {
   "ar": "جحا طلع.",
   "en": "Juha went out.",
   "p": 2
  },
  {
   "ar": "والناس ركضوا عليه.",
   "en": "And the people ran to him.",
   "p": 2
  },
  {
   "ar": "قالوا: يا جحا!",
   "en": "They said: Juha!",
   "p": 2
  },
  {
   "ar": "إنت مجنون!",
   "en": "You are mad!",
   "p": 2
  },
  {
   "ar": "الحمار ما بيقرا!",
   "en": "A donkey cannot read!",
   "p": 2
  },
  {
   "ar": "بعد عشر سنين، بيقطع راسك!",
   "en": "In ten years, he cuts off your head!",
   "p": 2
  },
  {
   "ar": "جحا ضحك.",
   "en": "Juha laughed.",
   "p": 3
  },
  {
   "ar": "وقال: عشر سنين طويلة.",
   "en": "And said: ten years is a long time.",
   "p": 3
  },
  {
   "ar": "وبعشر سنين، بيصير كتير شي.",
   "en": "And in ten years, a lot happens.",
   "p": 3
  },
  {
   "ar": "يا بيموت الحاكم.",
   "en": "Either the ruler dies.",
   "p": 3
  },
  {
   "ar": "يا بيموت الحمار.",
   "en": "Or the donkey dies.",
   "p": 3
  },
  {
   "ar": "يا بموت أنا.",
   "en": "Or I die.",
   "p": 3
  },
  {
   "ar": "ومين بيقطع راس مين؟",
   "en": "And who cuts off whose head?",
   "p": 3
  }
 ]
}