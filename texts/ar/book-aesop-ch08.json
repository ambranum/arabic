 "sentences": [
  {
   "ar": "غزال إجا يشرب من بركة.",
   "en": "A stag came to drink from a pool.",
   "p": 0
  },
  {
   "ar": "والمي كانت صافية.",
   "en": "And the water was clear.",
   "p": 0
  },
  {
   "ar": "شاف حاله بالمي.",
   "en": "He saw himself in the water.",
   "p": 0
  },
  {
   "ar": "زي المراية.",
   "en": "Like a mirror.",
   "p": 0
  },
  {
   "ar": "وشاف قرونه.",
   "en": "And saw his antlers.",
   "p": 0
  },
  {
   "ar": "قرون كبيرة، وحلوة.",
   "en": "Big, beautiful antlers.",
   "p": 0
  },
  {
   "ar": "قال: شو أحلى قروني!",
   "en": "He said: how lovely my antlers are!",
   "p": 0
  },
  {
   "ar": "وبعدين شاف إجريه.",
   "en": "And then he saw his legs.",
   "p": 1
  },
  {
   "ar": "إجرين رفيعين، وطويلين.",
   "en": "Thin, long legs.",
   "p": 1
  },
  {
   "ar": "قال: بس إجريّ!",
   "en": "He said: but my legs!",
   "p": 1
  },
  {
   "ar": "شو أبشعهم!",
   "en": "How ugly they are!",
   "p": 1
  },
  {
   "ar": "رفيعين زي العصي.",
   "en": "Thin as sticks.",
   "p": 1
  },
  {
   "ar": "يا ريت إجريّ زي قروني.",
   "en": "If only my legs were like my antlers.",
   "p": 1
  },
  {
   "ar": "وبنفس اللحظة، سمع صوت.",
   "en": "And in that same moment, he heard a sound.",
   "p": 2
  },
  {
   "ar": "كلاب.",
   "en": "Dogs.",
   "p": 2
  },
  {
   "ar": "كلاب صيد، جاية عليه.",
   "en": "Hunting dogs, coming at him.",
   "p": 2
  },
  {
   "ar": "الغزال ركض.",
   "en": "The stag ran.",
   "p": 2
  },
  {
   "ar": "ركض بإجريه الرفيعين.",
   "en": "He ran on his thin legs.",
   "p": 2
  },
  {
   "ar": "وركض أسرع من الكلاب.",
   "en": "And ran faster than the dogs.",
   "p": 2
  },
  {
   "ar": "والكلاب صارت بعيد.",
   "en": "And the dogs fell far behind.",
   "p": 2
  },
  {
   "ar": "ودخل الغابة.",
   "en": "And he entered the forest.",
   "p": 3
  },
  {
   "ar": "والشجر كتيف.",
   "en": "And the trees were thick.",
   "p": 3
  },
  {
   "ar": "وقرونه علقت بالأغصان.",
   "en": "And his antlers caught in the branches.",
   "p": 3
  },
  {
   "ar": "شد، وشد.",
   "en": "He pulled, and pulled.",
   "p": 3
  },
  {
   "ar": "ما طلعت.",
   "en": "They did not come free.",
   "p": 3
  },
  {
   "ar": "والكلاب وصلت.",
   "en": "And the dogs arrived.",
   "p": 3
  },
  {
   "ar": "وقال الغزال: إجريّ خلصتني.",
   "en": "And the stag said: my legs saved me.",
   "p": 3
  },
  {
   "ar": "وقروني قتلتني.",
   "en": "And my antlers killed me.",
   "p": 3
  },
  {
   "ar": "الحلو مش دايماً المفيد.",
   "en": "The beautiful is not always the useful.",
   "p": 3
  }
 ]
}