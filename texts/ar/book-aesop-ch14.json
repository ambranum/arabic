 "sentences": [
  {
   "ar": "كان الشتا قاسي.",
   "en": "The winter was harsh.",
   "p": 0
  },
  {
   "ar": "والتلج بكل مكان.",
   "en": "And snow everywhere.",
   "p": 0
  },
  {
   "ar": "وفلاح ماشي عالطريق.",
   "en": "And a farmer walking on the road.",
   "p": 0
  },
  {
   "ar": "وشاف حية عالأرض.",
   "en": "And he saw a snake on the ground.",
   "p": 0
  },
  {
   "ar": "حية مجمدة من البرد.",
   "en": "A snake frozen with cold.",
   "p": 0
  },
  {
   "ar": "ما بتتحرك.",
   "en": "Not moving.",
   "p": 0
  },
  {
   "ar": "تقريباً ميتة.",
   "en": "Nearly dead.",
   "p": 0
  },
  {
   "ar": "الفلاح وقف.",
   "en": "The farmer stopped.",
   "p": 1
  },
  {
   "ar": "وقال: مسكينة.",
   "en": "And said: poor thing.",
   "p": 1
  },
  {
   "ar": "رح تموت من البرد.",
   "en": "It will die of cold.",
   "p": 1
  },
  {
   "ar": "ورفعها.",
   "en": "And picked it up.",
   "p": 1
  },
  {
   "ar": "وحطها جوا قميصه.",
   "en": "And put it inside his shirt.",
   "p": 1
  },
  {
   "ar": "على صدره.",
   "en": "On his chest.",
   "p": 1
  },
  {
   "ar": "عشان تدفى.",
   "en": "So it would warm up.",
   "p": 1
  },
  {
   "ar": "ومشى.",
   "en": "And walked on.",
   "p": 2
  },
  {
   "ar": "والحية دفيت.",
   "en": "And the snake warmed.",
   "p": 2
  },
  {
   "ar": "وبلشت تتحرك.",
   "en": "And began to move.",
   "p": 2
  },
  {
   "ar": "وفاقت.",
   "en": "And woke.",
   "p": 2
  },
  {
   "ar": "وشافت إنها على صدر رجل.",
   "en": "And saw it was on a man's chest.",
   "p": 2
  },
  {
   "ar": "وعملت اللي بتعمله الحيات.",
   "en": "And did what snakes do.",
   "p": 2
  },
  {
   "ar": "عضته.",
   "en": "It bit him.",
   "p": 2
  },
  {
   "ar": "الفلاح وقع.",
   "en": "The farmer fell.",
   "p": 3
  },
  {
   "ar": "والسم بجسمه.",
   "en": "The poison in his body.",
   "p": 3
  },
  {
   "ar": "وقال، وهو بيموت:",
   "en": "And said, dying:",
   "p": 3
  },
  {
   "ar": "أنا دفيتك.",
   "en": "I warmed you.",
   "p": 3
  },
  {
   "ar": "وإنتِ عضيتيني.",
   "en": "And you bit me.",
   "p": 3
  },
  {
   "ar": "قالت الحية: أنا حية.",
   "en": "The snake said: I am a snake.",
   "p": 3
  },
  {
   "ar": "وإنت كنت بتعرف.",
   "en": "And you knew it.",
   "p": 3
  },
  {
   "ar": "الشرير ما بيتغير بالمعروف.",
   "en": "The wicked do not change for kindness.",
   "p": 3
  }
 ]
}