 "sentences": [
  {
   "ar": "جحا وصاحبه قعدوا برا.",
   "en": "Juha and his friend sat outside.",
   "p": 0
  },
  {
   "ar": "بالليل.",
   "en": "At night.",
   "p": 0
  },
  {
   "ar": "على السطح.",
   "en": "On the roof.",
   "p": 0
  },
  {
   "ar": "والقمر بدر.",
   "en": "And the moon was full.",
   "p": 0
  },
  {
   "ar": "كبير، وأبيض.",
   "en": "Big, and white.",
   "p": 0
  },
  {
   "ar": "وصاروا يتطلعوا فيه.",
   "en": "And they gazed at it.",
   "p": 0
  },
  {
   "ar": "طويل.",
   "en": "For a long time.",
   "p": 0
  },
  {
   "ar": "قال صاحبه: يا جحا.",
   "en": "His friend said: Juha.",
   "p": 1
  },
  {
   "ar": "القمر حلو.",
   "en": "The moon is beautiful.",
   "p": 1
  },
  {
   "ar": "قال جحا: حلو.",
   "en": "Juha said: beautiful.",
   "p": 1
  },
  {
   "ar": "قال صاحبه: وكل شهر بيصير بدر.",
   "en": "His friend said: and every month it becomes full.",
   "p": 1
  },
  {
   "ar": "وبعدين بيصغر.",
   "en": "And then it shrinks.",
   "p": 1
  },
  {
   "ar": "وبيختفي.",
   "en": "And disappears.",
   "p": 1
  },
  {
   "ar": "وبيرجع جديد.",
   "en": "And comes back new.",
   "p": 1
  },
  {
   "ar": "قال صاحبه: عندي سؤال.",
   "en": "His friend said: I have a question.",
   "p": 2
  },
  {
   "ar": "القمر القديم.",
   "en": "The old moon.",
   "p": 2
  },
  {
   "ar": "لما يختفي.",
   "en": "When it disappears.",
   "p": 2
  },
  {
   "ar": "وين بيروح؟",
   "en": "Where does it go?",
   "p": 2
  },
  {
   "ar": "شو بيصير فيه؟",
   "en": "What becomes of it?",
   "p": 2
  },
  {
   "ar": "جحا فكر.",
   "en": "Juha thought.",
   "p": 2
  },
  {
   "ar": "وتطلع بالسما.",
   "en": "And looked at the sky.",
   "p": 2
  },
  {
   "ar": "وشاف النجوم.",
   "en": "And saw the stars.",
   "p": 3
  },
  {
   "ar": "نجوم كتيرة.",
   "en": "Many stars.",
   "p": 3
  },
  {
   "ar": "زغيرة، وبتلمع.",
   "en": "Small, and shining.",
   "p": 3
  },
  {
   "ar": "وقال: فهمت.",
   "en": "And said: I understand.",
   "p": 3
  },
  {
   "ar": "القمر القديم بياخدوه.",
   "en": "They take the old moon.",
   "p": 3
  },
  {
   "ar": "وبيكسروه.",
   "en": "And break it up.",
   "p": 3
  },
  {
   "ar": "قطع زغيرة.",
   "en": "Into little pieces.",
   "p": 3
  },
  {
   "ar": "وبيعملوا منه نجوم.",
   "en": "And make stars from it.",
   "p": 3
  }
 ]
