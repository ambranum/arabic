 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "رجل عجوز عنده أربع أولاد.",
   "en": "An old man had four sons.",
   "p": 0
  },
  {
   "ar": "والأولاد دايماً بيتخانقوا.",
   "en": "And the sons were always quarrelling.",
   "p": 0
  },
  {
   "ar": "على الأرض، وعالمصاري، وعلى كل شي.",
   "en": "Over the land, over money, over everything.",
   "p": 0
  },
  {
   "ar": "والأب زعلان.",
   "en": "And the father was sad.",
   "p": 0
  },
  {
   "ar": "قال: لما أموت، بيتفرقوا.",
   "en": "He said: when I die, they will scatter.",
   "p": 0
  },
  {
   "ar": "وبيضيعوا.",
   "en": "And be lost.",
   "p": 0
  },
  {
   "ar": "وبيوم، ناداهم.",
   "en": "And one day, he called them.",
   "p": 1
  },
  {
   "ar": "وجاب حزمة عصي.",
   "en": "And brought a bundle of sticks.",
   "p": 1
  },
  {
   "ar": "حزمة مربوطة بحبل.",
   "en": "A bundle tied with a rope.",
   "p": 1
  },
  {
   "ar": "وقال للأول: اكسرها.",
   "en": "And said to the first: break it.",
   "p": 1
  },
  {
   "ar": "الأول حاول.",
   "en": "The first tried.",
   "p": 1
  },
  {
   "ar": "بكل قوته.",
   "en": "With all his strength.",
   "p": 1
  },
  {
   "ar": "ما انكسرت.",
   "en": "It did not break.",
   "p": 1
  },
  {
   "ar": "وأعطاها للتاني.",
   "en": "And gave it to the second.",
   "p": 2
  },
  {
   "ar": "ما انكسرت.",
   "en": "It did not break.",
   "p": 2
  },
  {
   "ar": "وللتالت، وللرابع.",
   "en": "And to the third, and the fourth.",
   "p": 2
  },
  {
   "ar": "ما انكسرت.",
   "en": "It did not break.",
   "p": 2
  },
  {
   "ar": "قالوا: مستحيل.",
   "en": "They said: impossible.",
   "p": 2
  },
  {
   "ar": "الحزمة قوية كتير.",
   "en": "The bundle is too strong.",
   "p": 2
  },
  {
   "ar": "الأب فك الحبل.",
   "en": "The father untied the rope.",
   "p": 3
  },
  {
   "ar": "وأعطى كل واحد عصا.",
   "en": "And gave each one a stick.",
   "p": 3
  },
  {
   "ar": "وقال: اكسروها.",
   "en": "And said: break them.",
   "p": 3
  },
  {
   "ar": "وكل واحد كسر عصاه.",
   "en": "And each one broke his stick.",
   "p": 3
  },
  {
   "ar": "بسهولة.",
   "en": "Easily.",
   "p": 3
  },
  {
   "ar": "قال الأب: شفتوا؟",
   "en": "The father said: you see?",
   "p": 3
  },
  {
   "ar": "مع بعض، ما حدا بيكسركم.",
   "en": "Together, no one breaks you.",
   "p": 3
  },
  {
   "ar": "لحالكم، بتنكسروا وحدة وحدة.",
   "en": "Alone, you break one by one.",
   "p": 3
  },
  {
   "ar": "بالاتحاد قوة.",
   "en": "In unity there is strength.",
   "p": 3
  }
 ]
}