 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "نملة كانت عطشانة.",
   "en": "An ant was thirsty.",
   "p": 0
  },
  {
   "ar": "راحت عالنهر تشرب.",
   "en": "She went to the river to drink.",
   "p": 0
  },
  {
   "ar": "نزلت على حجر.",
   "en": "She climbed down onto a stone.",
   "p": 0
  },
  {
   "ar": "والحجر كان مبلول.",
   "en": "And the stone was wet.",
   "p": 0
  },
  {
   "ar": "وزحلقت.",
   "en": "And she slipped.",
   "p": 0
  },
  {
   "ar": "ووقعت بالمي.",
   "en": "And fell into the water.",
   "p": 0
  },
  {
   "ar": "والمي أخدتها.",
   "en": "And the water carried her off.",
   "p": 0
  },
  {
   "ar": "النملة صرخت.",
   "en": "The ant cried out.",
   "p": 1
  },
  {
   "ar": "بس صوتها زغير.",
   "en": "But her voice is small.",
   "p": 1
  },
  {
   "ar": "ما حدا سمعها.",
   "en": "No one heard her.",
   "p": 1
  },
  {
   "ar": "إلا حمامة.",
   "en": "Except a dove.",
   "p": 1
  },
  {
   "ar": "الحمامة كانت على شجرة.",
   "en": "The dove was in a tree.",
   "p": 1
  },
  {
   "ar": "وشافت النملة بالمي.",
   "en": "And saw the ant in the water.",
   "p": 1
  },
  {
   "ar": "قطعت ورقة من الشجرة.",
   "en": "She picked a leaf from the tree.",
   "p": 1
  },
  {
   "ar": "ورمتها بالمي.",
   "en": "And dropped it in the water.",
   "p": 1
  },
  {
   "ar": "الورقة نزلت جنب النملة.",
   "en": "The leaf landed beside the ant.",
   "p": 2
  },
  {
   "ar": "والنملة تسلقت عليها.",
   "en": "And the ant climbed onto it.",
   "p": 2
  },
  {
   "ar": "والورقة وصلت للشط.",
   "en": "And the leaf reached the bank.",
   "p": 2
  },
  {
   "ar": "والنملة نزلت.",
   "en": "And the ant got off.",
   "p": 2
  },
  {
   "ar": "وقالت: شكراً يا حمامة.",
   "en": "And said: thank you, dove.",
   "p": 2
  },
  {
   "ar": "والحمامة قالت: ولا يهمك.",
   "en": "And the dove said: it is nothing.",
   "p": 2
  },
  {
   "ar": "بعد أيام، إجا صياد.",
   "en": "Days later, a hunter came.",
   "p": 3
  },
  {
   "ar": "شاف الحمامة عالشجرة.",
   "en": "He saw the dove in the tree.",
   "p": 3
  },
  {
   "ar": "ورفع بندقيته.",
   "en": "And raised his gun.",
   "p": 3
  },
  {
   "ar": "الحمامة ما شافته.",
   "en": "The dove did not see him.",
   "p": 3
  },
  {
   "ar": "بس النملة شافته.",
   "en": "But the ant saw him.",
   "p": 3
  },
  {
   "ar": "وركضت على إجره.",
   "en": "And ran up his leg.",
   "p": 3
  },
  {
   "ar": "وعضته.",
   "en": "And bit him.",
   "p": 3
  },
  {
   "ar": "الصياد صرخ.",
   "en": "The hunter cried out.",
   "p": 3
  },
  {
   "ar": "والحمامة سمعت، وطارت.",
   "en": "And the dove heard, and flew away.",
   "p": 3
  },
  {
   "ar": "المعروف بيرجع.",
   "en": "A kindness comes back.",
   "p": 3
  }
 ]
}