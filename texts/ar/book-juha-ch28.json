 "sentences": [
  {
   "ar": "جحا ماشي بالطريق.",
   "en": "Juha was walking along the road.",
   "p": 0
  },
  {
   "ar": "وشاف بيضة.",
   "en": "And saw an egg.",
   "p": 0
  },
  {
   "ar": "بيضة عالأرض.",
   "en": "An egg on the ground.",
   "p": 0
  },
  {
   "ar": "ورفعها.",
   "en": "And picked it up.",
   "p": 0
  },
  {
   "ar": "وحطها بإيده.",
   "en": "And held it in his hand.",
   "p": 0
  },
  {
   "ar": "وصار يفكر.",
   "en": "And began to think.",
   "p": 0
  },
  {
   "ar": "قال: من هاي البيضة، بتطلع دجاجة.",
   "en": "He said: from this egg, a hen comes.",
   "p": 1
  },
  {
   "ar": "والدجاجة بتبيض.",
   "en": "And the hen lays eggs.",
   "p": 1
  },
  {
   "ar": "بيض كتير.",
   "en": "A lot of eggs.",
   "p": 1
  },
  {
   "ar": "ومن البيض، دجاج.",
   "en": "And from the eggs, hens.",
   "p": 1
  },
  {
   "ar": "دجاج كتير.",
   "en": "A lot of hens.",
   "p": 1
  },
  {
   "ar": "وببيع الدجاج.",
   "en": "And I sell the hens.",
   "p": 1
  },
  {
   "ar": "وبالمصاري، بشتري خروف.",
   "en": "And with the money, I buy a sheep.",
   "p": 2
  },
  {
   "ar": "والخروف بيصير خرفان.",
   "en": "And the sheep becomes sheep.",
   "p": 2
  },
  {
   "ar": "وببيع الخرفان.",
   "en": "And I sell the sheep.",
   "p": 2
  },
  {
   "ar": "وبشتري بقرة.",
   "en": "And buy a cow.",
   "p": 2
  },
  {
   "ar": "وبعدين أرض.",
   "en": "And then land.",
   "p": 2
  },
  {
   "ar": "وبعدين بيت.",
   "en": "And then a house.",
   "p": 2
  },
  {
   "ar": "وبصير غني!",
   "en": "And I become rich!",
   "p": 2
  },
  {
   "ar": "ورفع إيده بالهوا.",
   "en": "And he raised his hand in the air.",
   "p": 2
  },
  {
   "ar": "والبيضة وقعت.",
   "en": "And the egg fell.",
   "p": 3
  },
  {
   "ar": "عالأرض.",
   "en": "On the ground.",
   "p": 3
  },
  {
   "ar": "وانكسرت.",
   "en": "And broke.",
   "p": 3
  },
  {
   "ar": "وجحا تطلع فيها.",
   "en": "And Juha looked at it.",
   "p": 3
  },
  {
   "ar": "وقال: يا خسارة.",
   "en": "And said: what a pity.",
   "p": 3
  },
  {
   "ar": "راحت الدجاجة.",
   "en": "The hen is gone.",
   "p": 3
  },
  {
   "ar": "والخرفان، والبقرة، والبيت.",
   "en": "And the sheep, the cow, the house.",
   "p": 3
  },
  {
   "ar": "راحت كل مصاريي.",
   "en": "All my money is gone.",
   "p": 3
  }
 ]
}