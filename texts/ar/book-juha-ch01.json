 "sentences": [
  {
   "ar": "جحا كان عنده حمار.",
   "en": "Juha had a donkey.",
   "p": 0
  },
  {
   "ar": "حمار زغير، ورمادي.",
   "en": "A small, grey donkey.",
   "p": 0
  },
  {
   "ar": "وكان بيحبه كتير.",
   "en": "And he loved it a lot.",
   "p": 0
  },
  {
   "ar": "كل يوم بيطعميه.",
   "en": "Every day he fed it.",
   "p": 0
  },
  {
   "ar": "وبيغسله.",
   "en": "And washed it.",
   "p": 0
  },
  {
   "ar": "وبيحكي معه.",
   "en": "And talked to it.",
   "p": 0
  },
  {
   "ar": "بيوم، إجا جاره.",
   "en": "One day, his neighbour came.",
   "p": 1
  },
  {
   "ar": "ودق الباب.",
   "en": "And knocked.",
   "p": 1
  },
  {
   "ar": "وقال: يا جحا، بدي الحمار اليوم.",
   "en": "And said: Juha, I want the donkey today.",
   "p": 1
  },
  {
   "ar": "بدي أروح عالسوق.",
   "en": "I want to go to the market.",
   "p": 1
  },
  {
   "ar": "جحا ما بده يعطيه.",
   "en": "Juha did not want to give it to him.",
   "p": 1
  },
  {
   "ar": "الجار بيضرب الحمير.",
   "en": "The neighbour beats donkeys.",
   "p": 1
  },
  {
   "ar": "قال جحا: يا خسارة.",
   "en": "Juha said: what a pity.",
   "p": 2
  },
  {
   "ar": "الحمار مش هون.",
   "en": "The donkey is not here.",
   "p": 2
  },
  {
   "ar": "راح عالسوق مع ابني.",
   "en": "It went to the market with my son.",
   "p": 2
  },
  {
   "ar": "من الصبح.",
   "en": "This morning.",
   "p": 2
  },
  {
   "ar": "قال الجار: يا خسارة.",
   "en": "The neighbour said: what a pity.",
   "p": 2
  },
  {
   "ar": "ولف عشان يروح.",
   "en": "And turned to leave.",
   "p": 2
  },
  {
   "ar": "وبهاي اللحظة، صار صوت.",
   "en": "And in that moment, there was a sound.",
   "p": 3
  },
  {
   "ar": "من ورا البيت.",
   "en": "From behind the house.",
   "p": 3
  },
  {
   "ar": "هيـهاااو!",
   "en": "Hee-haaw!",
   "p": 3
  },
  {
   "ar": "الحمار نهق.",
   "en": "The donkey brayed.",
   "p": 3
  },
  {
   "ar": "الجار وقف.",
   "en": "The neighbour stopped.",
   "p": 3
  },
  {
   "ar": "وقال: يا جحا!",
   "en": "And said: Juha!",
   "p": 3
  },
  {
   "ar": "أنا بسمع الحمار!",
   "en": "I hear the donkey!",
   "p": 3
  },
  {
   "ar": "هو بالبيت!",
   "en": "It is at home!",
   "p": 3
  },
  {
   "ar": "جحا تطلع فيه.",
   "en": "Juha looked at him.",
   "p": 4
  },
  {
   "ar": "وحط إيده على قلبه.",
   "en": "And put his hand on his heart.",
   "p": 4
  },
  {
   "ar": "وقال: يا زلمة.",
   "en": "And said: man.",
   "p": 4
  },
  {
   "ar": "عيب عليك.",
   "en": "Shame on you.",
   "p": 4
  },
  {
   "ar": "أنا جارك من عشرين سنة.",
   "en": "I have been your neighbour for twenty years.",
   "p": 4
  },
  {
   "ar": "بتصدق الحمار، ولا بتصدقني؟",
   "en": "Do you believe the donkey, or do you believe me?",
   "p": 4
  }
 ]
}