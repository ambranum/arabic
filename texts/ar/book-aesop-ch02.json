 "sentences": [
  {
   "ar": "كان في ثعلب جعان.",
   "en": "There was a hungry fox.",
   "p": 0
  },
  {
   "ar": "مشى بالحقل كل الصبح.",
   "en": "He walked in the field all morning.",
   "p": 0
  },
  {
   "ar": "ما لقى أكل.",
   "en": "He found no food.",
   "p": 0
  },
  {
   "ar": "وبعدين شاف كرمة.",
   "en": "And then he saw a vine.",
   "p": 0
  },
  {
   "ar": "وعالكرمة، عنب.",
   "en": "And on the vine, grapes.",
   "p": 0
  },
  {
   "ar": "عنب كبير، ولونه أحمر.",
   "en": "Big grapes, red in colour.",
   "p": 0
  },
  {
   "ar": "بس العنب عالي.",
   "en": "But the grapes were high up.",
   "p": 0
  },
  {
   "ar": "قال الثعلب: سهلة.",
   "en": "The fox said: easy.",
   "p": 1
  },
  {
   "ar": "نط مرة.",
   "en": "He jumped once.",
   "p": 1
  },
  {
   "ar": "ما وصل.",
   "en": "He did not reach.",
   "p": 1
  },
  {
   "ar": "نط مرتين.",
   "en": "He jumped twice.",
   "p": 1
  },
  {
   "ar": "ما وصل.",
   "en": "He did not reach.",
   "p": 1
  },
  {
   "ar": "رجع لورا، وركض، ونط.",
   "en": "He went back, ran, and jumped.",
   "p": 1
  },
  {
   "ar": "ما وصل.",
   "en": "He did not reach.",
   "p": 1
  },
  {
   "ar": "قعد الثعلب عالأرض.",
   "en": "The fox sat on the ground.",
   "p": 2
  },
  {
   "ar": "كان تعبان.",
   "en": "He was tired.",
   "p": 2
  },
  {
   "ar": "وتطلع عالعنب.",
   "en": "And looked at the grapes.",
   "p": 2
  },
  {
   "ar": "والعنب بيلمع بالشمس.",
   "en": "And the grapes shone in the sun.",
   "p": 2
  },
  {
   "ar": "قال: مرة كمان.",
   "en": "He said: once more.",
   "p": 2
  },
  {
   "ar": "ونط، وما وصل.",
   "en": "And he jumped, and did not reach.",
   "p": 2
  },
  {
   "ar": "وشاف عصفور بيتفرج عليه.",
   "en": "And he saw a bird watching him.",
   "p": 2
  },
  {
   "ar": "قام الثعلب.",
   "en": "The fox got up.",
   "p": 3
  },
  {
   "ar": "ونفض حاله.",
   "en": "And shook himself.",
   "p": 3
  },
  {
   "ar": "ومشى.",
   "en": "And walked off.",
   "p": 3
  },
  {
   "ar": "وقال بصوت عالي: العنب حامض.",
   "en": "And said out loud: the grapes are sour.",
   "p": 3
  },
  {
   "ar": "ما بدي ياه.",
   "en": "I do not want them.",
   "p": 3
  },
  {
   "ar": "والعصفور ضحك.",
   "en": "And the bird laughed.",
   "p": 3
  },
  {
   "ar": "اللي ما بيقدر عليه، بيعيبه.",
   "en": "What a person cannot get, he finds fault with.",
   "p": 3
  }
 ]
}