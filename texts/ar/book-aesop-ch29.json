 "source": "adapted by Claude — NOT native-validated",
 "sentences": [
  {
   "ar": "الريح والشمس تخانقوا.",
   "en": "The wind and the sun quarrelled.",
   "p": 0
  },
  {
   "ar": "قالت الريح: أنا أقوى.",
   "en": "The wind said: I am stronger.",
   "p": 0
  },
  {
   "ar": "قالت الشمس: لا، أنا أقوى.",
   "en": "The sun said: no, I am stronger.",
   "p": 0
  },
  {
   "ar": "وتحتهم، عالطريق، رجل ماشي.",
   "en": "And below them, on the road, a man walking.",
   "p": 0
  },
  {
   "ar": "لابس معطف.",
   "en": "Wearing a coat.",
   "p": 0
  },
  {
   "ar": "قالت الشمس: خلينا نجرب.",
   "en": "The sun said: let us try.",
   "p": 0
  },
  {
   "ar": "اللي بيشلح المعطف عن الرجل، هو الأقوى.",
   "en": "Whoever gets the coat off the man is the stronger.",
   "p": 0
  },
  {
   "ar": "قالت الريح: سهلة.",
   "en": "The wind said: easy.",
   "p": 1
  },
  {
   "ar": "ونفخت.",
   "en": "And blew.",
   "p": 1
  },
  {
   "ar": "نفخت بقوة.",
   "en": "Blew hard.",
   "p": 1
  },
  {
   "ar": "والرجل مسك معطفه.",
   "en": "And the man held his coat.",
   "p": 1
  },
  {
   "ar": "ونفخت أقوى.",
   "en": "And blew harder.",
   "p": 1
  },
  {
   "ar": "والرجل زرر معطفه.",
   "en": "And the man buttoned his coat.",
   "p": 1
  },
  {
   "ar": "ونفخت بكل قوتها.",
   "en": "And blew with all her strength.",
   "p": 1
  },
  {
   "ar": "والرجل لف المعطف حوله.",
   "en": "And the man wrapped the coat around him.",
   "p": 1
  },
  {
   "ar": "ومسكه بإيديه الاتنين.",
   "en": "And held it with both hands.",
   "p": 1
  },
  {
   "ar": "الريح تعبت.",
   "en": "The wind grew tired.",
   "p": 2
  },
  {
   "ar": "وقالت: دورك.",
   "en": "And said: your turn.",
   "p": 2
  },
  {
   "ar": "والشمس طلعت من ورا الغيم.",
   "en": "And the sun came out from behind the clouds.",
   "p": 2
  },
  {
   "ar": "ودفت.",
   "en": "And warmed.",
   "p": 2
  },
  {
   "ar": "شوي شوي.",
   "en": "Little by little.",
   "p": 2
  },
  {
   "ar": "والرجل فك الأزرار.",
   "en": "And the man undid the buttons.",
   "p": 2
  },
  {
   "ar": "والشمس دفت أكتر.",
   "en": "And the sun warmed more.",
   "p": 3
  },
  {
   "ar": "والرجل عرق.",
   "en": "And the man sweated.",
   "p": 3
  },
  {
   "ar": "ومسح جبينه.",
   "en": "And wiped his brow.",
   "p": 3
  },
  {
   "ar": "وشلح المعطف.",
   "en": "And took off the coat.",
   "p": 3
  },
  {
   "ar": "وحطه على كتفه.",
   "en": "And put it over his shoulder.",
   "p": 3
  },
  {
   "ar": "وكمل طريقه.",
   "en": "And went on his way.",
   "p": 3
  },
  {
   "ar": "وقالت الشمس: شفتي؟",
   "en": "And the sun said: you see?",
   "p": 3
  },
  {
   "ar": "اللطف بيعمل أكتر من القوة.",
   "en": "Gentleness does more than force.",
   "p": 3
  }
 ]
}