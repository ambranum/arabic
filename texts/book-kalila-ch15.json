 "sentences": [
  {
   "ar": "غراب شاف اللي صار وحب يصير صاحبهم.",
   "en": "A crow saw what happened and wanted to be their friend.",
   "p": 0
  },
  {
   "ar": "بالأول الفار خاف منه.",
   "en": "At first the mouse was afraid of him.",
   "p": 0
  },
  {
   "ar": "قال: إنت بتاكل الفيران.",
   "en": "He said: you eat mice.",
   "p": 0
  },
  {
   "ar": "الغراب قال: بغير طبعي عشانك.",
   "en": "The crow said: I will change my nature for you.",
   "p": 1
  },
  {
   "ar": "صاروا أصحاب، وبعدين لحقتهم سلحفاة.",
   "en": "They became friends, and later a tortoise joined them.",
   "p": 1
  },
  {
   "ar": "وبعدها إجت غزالة وصارت رابعتهم.",
   "en": "And after that a gazelle came and became their fourth.",
   "p": 2
  },
  {
   "ar": "عاشوا سوا جنب المي.",
   "en": "They lived together beside the water.",
   "p": 2
  }
