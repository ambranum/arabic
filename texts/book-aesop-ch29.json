  {
   "ar": "الريح والشمس اختلفوا.",
   "en": "The wind and the sun disagreed.",
   "p": 0
  },
  {
   "ar": "مين أقوى فيهم؟",
   "en": "Which of them is stronger?",
   "p": 0
  },
  {
   "ar": "شافوا مسافر لابس كبوت.",
   "en": "They saw a traveller wearing a coat.",
   "p": 1
  },
  {
   "ar": "قالوا: اللي بيشلحه هو الأقوى.",
   "en": "They said: whoever takes it off him is stronger.",
   "p": 1
  },
  {
   "ar": "الريح نفخت بقوة.",
   "en": "The wind blew hard.",
   "p": 2
  },
  {
   "ar": "المسافر شد الكبوت عليه.",
   "en": "The traveller pulled the coat tighter.",
   "p": 2
  },
  {
   "ar": "الشمس دفت بهدوء.",
   "en": "The sun warmed gently.",
   "p": 3
  },
  {
   "ar": "المسافر شلح كبوته لحاله.",
   "en": "The traveller took his coat off himself.",
   "p": 3
  },
  {
   "ar": "اللطف أقوى من القوة.",
   "en": "Gentleness is stronger than force.",
   "p": 3
  }
